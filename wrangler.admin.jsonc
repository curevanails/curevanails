{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Standalone Worker: same codebase + same D1/R2 as the main site, but a
	// different Worker name. The name becomes the subdomain, so this deploys to
	// https://admin.curevanails-tech.workers.dev
	"name": "admin",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// Cloudflare Email Service. `env.EMAIL.send()` is how every email leaves
	// this Worker (src/utils/email/mailer.ts) — no credentials, no sandbox. The
	// From domain (curevanails.com, src/utils/email/sender.ts) must be onboarded
	// for Email Sending on this account: `wrangler email sending enable
	// curevanails.com`. Remove the binding and the Worker falls back to AWS SES
	// via the AWS_* secrets.
	"send_email": [{ "name": "EMAIL" }],
	// ADMIN_STANDALONE makes the app serve the admin console at the root (`/`) of
	// this Worker — recruit + waitlist + the email dashboard at `/mail`. See
	// src/middleware.ts.
	//
	// The admin area is gated by a form login that issues a signed session
	// cookie (see src/utils/admin-auth.ts + src/pages/admin/login.astro). If
	// ADMIN_PASSWORD is unset the admin area returns 404 and is disabled. Set the
	// credentials as secrets (NOT vars) after the first deploy:
	//   wrangler secret put ADMIN_PASSWORD --config wrangler.admin.jsonc
	//   wrangler secret put ADMIN_USERNAME --config wrangler.admin.jsonc   (optional, defaults to "admin")
	//
	// Email lives here too (the standalone notify service was retired). Sending
	// goes through the `EMAIL` binding above; the campaign cron + the SNS webhook
	// run on this Worker. Optional secrets:
	//   wrangler secret put PUBLIC_SITE_URL       --config wrangler.admin.jsonc   (https://admin.curevanails.com)
	//   wrangler secret put SESSION_SECRET        --config wrangler.admin.jsonc   (recommended)
	// The AWS SES fallback (used only when the EMAIL binding is absent) reads:
	//   wrangler secret put AWS_REGION            --config wrangler.admin.jsonc
	//   wrangler secret put AWS_ACCESS_KEY_ID     --config wrangler.admin.jsonc
	//   wrangler secret put AWS_SECRET_ACCESS_KEY --config wrangler.admin.jsonc
	// and AWS SNS must then post delivery/bounce/complaint events to
	// https://admin.curevanails.com/api/webhooks/ses (was notify.curevanails.com).
	// Cron Trigger: fire due scheduled campaigns every 5 minutes → src/worker.ts
	// scheduled() → runDueCampaigns().
	"triggers": {
		"crons": ["*/5 * * * *"],
	},
	"vars": {
		"ADMIN_STANDALONE": "true",
		// ARN of the SNS topic the SES Configuration Set publishes to. When empty
		// the /api/webhooks/ses handler fails closed (HTTP 503) and processes no
		// SES events — set it to the real topic ARN before relying on bounce/
		// complaint intake.
		"SES_TOPIC_ARN": "arn:aws:sns:us-east-1:462355914425:cureva-ses-events",
		// SES Configuration Set name. Optional and empty by default — SES rejects
		// the entire send when the named set doesn't exist, so this stays blank
		// until the set is actually created in AWS. Setting it is what makes SES
		// publish delivery/bounce/complaint events to SNS for /api/webhooks/ses.
		"SES_CONFIGURATION_SET": "",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "curevanails",
			"database_id": "fcc8f06b-3ddf-4cae-953f-b9fce243eed8",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "curevanails-media",
		},
	],
}
