---
/**
 * The layout every content page uses — Journal, articles, archives, search
 * and static pages.
 *
 * REBUILT ON VERSION H. This was the EmDash blog theme: Inter, a #0066cc
 * accent, a document-level light/dark switcher and ~750 lines of its own
 * CSS. The site now has one design, so the chrome below is version H's —
 * the same nav, full-screen menu, preloader and footer the marketing pages
 * carry — and the editorial rules live in ../styles/version-h-content.css.
 *
 * EVERY EmDash INTEGRATION POINT IS KEPT, because they are not decoration:
 *   · EmDashHead        SEO + plugin head contributions
 *   · EmDashBodyStart / EmDashBodyEnd   plugin body contributions
 *   · createPublicPageContext           what those three read
 *   · WidgetArea        seed-defined widgets
 *   · LiveSearch        the search island
 *   · getMenu("primary") / getMenu("social") / the pages collection
 * The props API is unchanged too, so no page that imports this had to move.
 *
 * WHAT WAS DROPPED, deliberately: the light/dark theme switcher. Version H
 * is dark-first and carries its light theme per SECTION, on `.on-light` —
 * there is no document-level counterpart for a toggle to flip, so keeping
 * the control would have meant keeping a button that does nothing. Use the
 * `ground` prop to put a page on paper instead.
 */
import { getMenu, getEmDashCollection, getSiteSettings } from "emdash";
import {
	WidgetArea,
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import "../styles/version-h.css";
import "../styles/version-h-content.css";
import "../styles/version-h-mobile.css";
import runtimeUrl from "../../design/version-h/js/runtime.js?url";
import CursorGround from "../components/vh/CursorGround.astro";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	/**
	 * Which ground the page opens on. "paper" is for reading surfaces —
	 * articles and static pages; it also switches the nav to `nav--paper`,
	 * without which the cream wordmark is invisible. See GUIDE.md §1.
	 */
	ground?: "night" | "paper";
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
	ground = "night",
} = Astro.props;
const { siteTitle, siteTagline, siteLogo } = resolveBlogSiteIdentity(await getSiteSettings());
// If title already includes site title (from getSeoMeta), use as-is
const fullTitle = title.includes(siteTitle) ? title : `${title} — ${siteTitle}`;

// Fetch primary menu defined in seed
const menu = await getMenu("primary");

// Optional "social" menu. If a site defines a `social` menu in its seed,
// it'll render in the footer's "Connect" column. Otherwise that column
// just shows RSS, avoiding duplication with the "Navigate" column above.
const socialMenu = await getMenu("social");

// Fetch pages for footer
const { entries: pages } = await getEmDashCollection("pages");

// Build public page context for plugin contributions
// SEO data is passed here and rendered securely by EmDashHead
/* SEO defaults. EmDashHead emits the OG/Twitter block from this context,
   but only for what it is given — and no page was passing a canonical or a
   social image, so every content page shipped without either. A page with
   no canonical is a page whose ranking is split across every URL that can
   reach it (trailing slash, query string, the workers.dev host), and one
   with no og:image previews as a bare link. */
const origin = Astro.site ?? new URL("https://curevanails.com");
const resolvedCanonical = canonical ?? new URL(Astro.url.pathname, origin).href;
const resolvedImage = image ?? new URL("/og.jpg", origin).href;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical: resolvedCanonical,
	image: resolvedImage,
	content,
	seo: { ogImage: resolvedImage, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

// Check if user is logged in (for showing admin link)
const isLoggedIn = !!Astro.locals.user;

const paper = ground === "paper";

/* The site's one navigation list — the bar shows the first three, the
   full-screen panel shows all of them. */
const NAV = [
	{ href: "/coming-soon", label: "The studio" },
	{ href: "/recruit", label: "Careers" },
	{ href: "/recruit/apply", label: "Apply" },
	{ href: "/posts", label: "Journal" },
	{ href: "/search", label: "Search" },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content={paper ? "#F7F4EC" : "#0B1410"} />
		<meta name="color-scheme" content="dark" />
		<title>{fullTitle}</title>

		<!-- The only external request this system makes. Guard it: a second
		     one is a regression, not a feature. -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..700,0..100,0..1;1,9..144,300..700,0..100,0..1&family=Manrope:wght@300..800&display=swap" />

		<noscript><style>
		  /* The reveals are opacity:0 until the runtime's observer adds `.in`. With
		     scripting off nothing ever does, and every page would render as an empty
		     ground — which is why this block is not optional. It restores the
		     system's own rule: what loads is what there is.
		     Costs nothing when scripts run: <noscript> is inert then. */
		  [data-r]{opacity:1!important;transform:none!important;clip-path:none!important}
		  #pre{display:none!important}
		</style></noscript>

		<link rel="canonical" href={resolvedCanonical} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={resolvedImage} />
		<meta property="og:image" content={resolvedImage} />
		<meta property="og:url" content={resolvedCanonical} />
		<meta property="og:locale" content="en_US" />

		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<div id="pre" role="status" aria-label="Loading">
			<div class="contour" aria-hidden="true"></div>
			<div class="pre-in">
				<span class="pre-mark" aria-hidden="true"></span>
				<div class="pre-w"><span>cure và</span></div>
				<span class="pre-rule" aria-hidden="true"></span>
				<div class="pre-sub">Nail therapy · Sugar House</div>
			</div>
		</div>

		<div id="grain" aria-hidden="true"></div>
		<div id="prog" aria-hidden="true"></div>
		<div id="cur" aria-hidden="true"><b>view</b></div>

		<nav class={paper ? "nav nav--paper" : "nav"} id="nav" aria-label="Primary">
			<div class="bar">
				<a class="mark" href="/" aria-label={`${siteTitle} — home`}>
					<span class="mark-ring" aria-hidden="true"></span>
					<b>cure và</b><i>Nail Therapy</i>
				</a>
				<ul class="links">
					{NAV.slice(0, 3).map((item) => (
						<li><a href={item.href}>{item.label}</a></li>
					))}
				</ul>
				<a class="btn cta" href="/recruit/apply" data-mag>Apply now</a>
				<button class="burger" id="burger" type="button" aria-expanded="false"
					aria-controls="menuPanel"><span class="lbl">Menu</span>
					<span class="bars" aria-hidden="true"><i></i><i></i></span></button>
			</div>
		</nav>

		<div id="menuPanel" aria-hidden="true">
			<div></div>
			<div class="mp-in">
				<nav aria-label="Sections">
					<ul class="mp-list">
						{NAV.map((item, i) => (
							<li><a href={item.href} style={`--d:${60 + i * 50}ms`}>{item.label}</a></li>
						))}
						{/* the seed's own menu, so a page added in the CMS reaches
						    the navigation without a code change */}
						{menu?.items
							.filter((item) => !NAV.some((n) => n.href === item.url))
							.map((item, i) => (
								<li><a href={item.url} target={item.target}
									style={`--d:${60 + (NAV.length + i) * 50}ms`}>{item.label}</a></li>
							))}
					</ul>
				</nav>
				<div class="mp-side">
					<div class="mp-search" role="search" aria-label="Search the site">
						<LiveSearch
							placeholder="Search…"
							class="site-search"
							inputClass="search-input"
							resultsClass="site-search-results"
							resultClass="site-search-result"
							collections={["posts", "pages"]}
						/>
					</div>
					<div class="mp-meta">
						<div><b>Opening</b>December 2026</div>
						<div><b>Where</b>Legacy Village, Sugar House UT</div>
						<div><b>Call</b><a href="tel:+18014253581">+1 801 425 3581</a></div>
						{isLoggedIn && <div><b>Signed in</b><a href="/_emdash/admin">Admin</a></div>}
					</div>
				</div>
			</div>
		</div>

		<main id="top" class={paper ? "on-light" : undefined}>
			<slot />
		</main>

		<footer class="foot">
			<div class="wrap">
				<div class="foot-grid">
					<div>
						<a class="mark" href="/" aria-label={`${siteTitle} — home`}>
							<span class="mark-ring" aria-hidden="true"></span><b>cure và</b></a>
						<p class="lede" style="margin-top:1rem;font-size:.92rem">{siteTagline}</p>
					</div>
					<div>
						<h4>Studio</h4>
						<address>Legacy Village<br />Sugar House, UT<br />
							<a href="tel:+18014253581">+1 801 425 3581</a><br />
							Mon–Sat, 9:00 AM – 7:00 PM</address>
					</div>
					<div>
						<h4>Navigate</h4>
						<ul>
							<li><a href="/posts">All posts</a></li>
							<li><a href="/search">Search</a></li>
							{pages.slice(0, 3).map((page) => (
								<li><a href={`/pages/${page.data.slug || page.id}`}>{page.data.title}</a></li>
							))}
						</ul>
					</div>
					<div>
						<h4>Connect</h4>
						<ul>
							{socialMenu?.items.map((item) => (
								<li><a href={item.url} target={item.target}
									rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
								>{item.label}</a></li>
							))}
							<li><a href="/rss.xml">RSS feed</a></li>
							<li><a href="/recruit">Careers</a></li>
						</ul>
						<WidgetArea name="footer" />
					</div>
				</div>

				<div class="bigmark" aria-hidden="true">
					<b>c</b><b>u</b><b>r</b><b>e</b><b>&nbsp;</b><b>v</b><b>à</b>
				</div>

				<div class="foot-legal">
					<div class="l"><span>© 2026 Cure Và. All rights reserved.</span></div>
					<div class="l"><a href="/coming-soon">Opening</a><a href="/recruit">Careers</a>
						<a href="https://emdashcms.com">Powered by EmDash</a></div>
				</div>
			</div>
		</footer>

		<script src={runtimeUrl} is:inline></script>
		<script is:inline>
			/* EmDash's LiveSearch renders its own <input> and takes no label
			   prop, so the field ships with a placeholder and no accessible
			   name — a placeholder is not a label. The island needs JavaScript
			   to do anything at all, so naming it here costs nothing that was
			   otherwise available. */
			(function () {
				var input = document.querySelector('.mp-search input');
				if (input && !input.getAttribute('aria-label')) {
					input.setAttribute('aria-label', 'Search posts and pages');
				}
			})();
		</script>
<CursorGround />
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>

<style is:global>
	/* The search island inside the menu panel. EmDash's LiveSearch draws its
	   own results list; these are the four custom properties it exposes,
	   pointed at the system's tokens so it re-themes with everything else. */
	.mp-search{margin-bottom:1.6rem}
	.mp-search .site-search{position:relative;display:block}
	.mp-search .search-input{width:100%}
	.site-search-results{
		--emdash-search-bg:hsl(var(--popover));
		--emdash-search-text:hsl(var(--popover-foreground));
		--emdash-search-muted:hsl(var(--muted-foreground));
		--emdash-search-border:var(--border-hairline);
		--emdash-search-hover:hsl(var(--muted));
		--emdash-search-highlight:hsl(var(--accent));
		border-radius:var(--radius-md);overflow:hidden;
		box-shadow:inset 0 0 0 1px var(--border-hairline),var(--sh-d)}
	.site-search-result{color:hsl(var(--foreground))}
</style>
