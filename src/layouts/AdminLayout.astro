---
/**
 * Shared chrome for the recruit side of the admin console — the Dashboard
 * (`/admin`) and the Recruit pipeline (`/admin/recruit`).
 *
 * Same shell as the email dashboard's MailLayout (sidebar + sticky header), on
 * this side's lighter, light-only palette. Pages supply their content; `head`
 * takes page-specific styles/links and `actions` the header's primary button.
 */
import type { AdminActive } from "../utils/admin-nav";
import AdminSidebar from "../components/AdminSidebar.astro";

interface Props {
	/** Page name — the <title> and the header heading. */
	title: string;
	/** One line under the heading. */
	subtitle?: string;
	/** Which sidebar item to highlight. */
	active: AdminActive;
	/** Sign-out link, base-aware (see src/middleware.ts). */
	logoutHref: string;
}

const { title, subtitle, active, logoutHref } = Astro.props;
---

<!DOCTYPE html>
<html class="light" lang="en">
	<head>
		<meta charset="utf-8" />
		<meta content="width=device-width, initial-scale=1.0" name="viewport" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title} · CureVà Admin</title>
		<script is:inline src="https://cdn.tailwindcss.com?plugins=forms"></script>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap" rel="stylesheet" />
		<link
			href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
			rel="stylesheet"
		/>
		<style is:inline>
			.material-symbols-outlined {
				font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20;
				vertical-align: middle;
			}
			body { background: #f9fafb; }
			/* Sidebar mobile drawer */
			@media (max-width: 1023px) {
				#sidebar { transform: translateX(-100%); }
				#sidebar.open { transform: translateX(0); }
			}
		</style>
		<script is:inline id="tailwind-config">
			tailwind.config = {
				darkMode: "class",
				theme: {
					extend: {
						colors: {
							brand: {
								25: "#f2f7ff", 50: "#ecf3ff", 100: "#dde9ff", 200: "#c2d6ff",
								300: "#9cb9ff", 400: "#7592ff", 500: "#465fff", 600: "#3641f5",
								700: "#2a31d8", 800: "#252dae", 900: "#262e89", 950: "#161950",
							},
						},
						fontFamily: { sans: ["Outfit", "sans-serif"] },
						boxShadow: {
							"theme-xs": "0 1px 2px 0 rgba(16,24,40,0.05)",
							"theme-sm": "0 1px 3px 0 rgba(16,24,40,0.1), 0 1px 2px -1px rgba(16,24,40,0.1)",
						},
					},
				},
			};
		</script>
		<slot name="head" />
	</head>
	<body class="font-sans text-gray-800">
		<AdminSidebar active={active} />

		<div class="lg:ml-[290px]">
			<header class="sticky top-0 z-30 border-b border-gray-200 bg-white/90 backdrop-blur">
				<div class="flex items-center justify-between gap-4 px-4 py-3.5 sm:px-6">
					<div class="flex items-center gap-3">
						<button id="sidebar-toggle" type="button" aria-label="Toggle menu" class="grid h-10 w-10 place-items-center rounded-lg border border-gray-200 text-gray-600 transition hover:bg-gray-50 lg:hidden">
							<span class="material-symbols-outlined">menu</span>
						</button>
						<div>
							<h1 class="text-lg font-semibold leading-none text-gray-800">{title}</h1>
							{subtitle && <p class="mt-1 text-xs text-gray-500">{subtitle}</p>}
						</div>
					</div>
					<div class="flex items-center gap-2">
						<slot name="actions" />
						<a
							href={logoutHref}
							class="inline-flex items-center gap-1.5 rounded-lg border border-gray-200 px-3.5 py-2 text-sm font-medium text-gray-600 shadow-theme-xs transition hover:bg-gray-50 hover:text-gray-900"
						>
							<span class="material-symbols-outlined text-base">logout</span>
							<span class="hidden sm:inline">Sign out</span>
						</a>
					</div>
				</div>
			</header>

			<main class="mx-auto max-w-[1400px] space-y-5 px-4 py-6 sm:px-6">
				<slot />
			</main>
		</div>
		<slot name="scripts" />
	</body>
</html>
