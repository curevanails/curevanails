---
/**
 * Shared chrome for every email dashboard page (`src/pages/notify/*`).
 *
 * Each sidebar item — Compose, Campaigns, Templates, Analytics, Activity,
 * Suppressed, Recruit alerts, Settings — is its own page, and they all render
 * inside this layout: the TailAdmin head (theme, Tailwind config, fonts), the
 * shared AdminSidebar, a sticky header carrying the page title, and the main
 * column. Pages supply only their content.
 *
 * `actions` is a named slot for the page's primary button (e.g. "New template"),
 * rendered in the header next to the theme toggle.
 */
import { mailDb, loadSubscriberCount } from "../utils/email-data";
import { emailNav, type MailActive } from "../utils/email-nav";

import AdminSidebar from "../components/AdminSidebar.astro";

interface Props {
	/** Page name — the <title>, the header heading and the breadcrumb tail. */
	title: string;
	/** One line under the header explaining what the page is for. */
	description?: string;
	/** Which sidebar item to highlight. */
	active: MailActive;
	/** Set when the page's queries failed; renders a banner above the content. */
	loadError?: string | null;
}

const { title, description, active, loadError = null } = Astro.props;

// Nav links adapt to where the dashboard is mounted. See src/utils/email-nav.ts.
const nav = emailNav();
const subscribers = await loadSubscriberCount(mailDb());
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta content="width=device-width, initial-scale=1.0" name="viewport" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title} · CureVà Email</title>
		<script is:inline>
			// Apply theme before render to avoid a flash. TailAdmin pattern.
			(function () {
				try {
					const saved = localStorage.getItem("theme");
					const sysDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
					if (saved === "dark" || (!saved && sysDark)) document.documentElement.classList.add("dark");
				} catch (_) {}
			})();
		</script>
		<script is:inline src="https://cdn.tailwindcss.com?plugins=forms"></script>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
		<script is:inline id="tailwind-config">
			tailwind.config = {
				darkMode: "class",
				theme: {
					extend: {
						colors: {
							brand: {
								25: "#F2F7FF", 50: "#ECF3FF", 100: "#DDE9FF", 200: "#C2D6FF",
								300: "#9CB9FF", 400: "#7592FF", 500: "#465FFF", 600: "#3641F5",
								700: "#2A31D8", 800: "#252DAE", 900: "#262E89", 950: "#161950",
							},
							curva: { DEFAULT: "#3a656e", dark: "#2f545c", light: "#7fa8b1" },
							gray: {
								25: "#FCFCFD", 50: "#F9FAFB", 100: "#F2F4F7", 200: "#E4E7EC",
								300: "#D0D5DD", 400: "#98A2B3", 500: "#667085", 600: "#475467",
								700: "#344054", 800: "#1D2939", 900: "#101828", 950: "#0C111D",
							},
							"blue-light": {
								25: "#F5FAFF", 50: "#EFF8FF", 100: "#D1E9FF", 200: "#B2DDFF",
								300: "#84CAFF", 400: "#53B1FD", 500: "#2E90FA", 600: "#1570EF",
								700: "#175CD3", 800: "#1849A9", 900: "#194185",
							},
							success: {
								25: "#F6FEF9", 50: "#ECFDF3", 100: "#D1FADF", 200: "#A6F4C5",
								300: "#6CE9A6", 400: "#32D583", 500: "#12B76A", 600: "#039855",
								700: "#027A48", 800: "#05603A", 900: "#054F31",
							},
							warning: {
								25: "#FFFCF5", 50: "#FFFAEB", 100: "#FEF0C7", 200: "#FEDF89",
								300: "#FEC84B", 400: "#FDB022", 500: "#F79009", 600: "#DC6803",
								700: "#B54708", 800: "#93370D", 900: "#7A2E0E",
							},
							error: {
								25: "#FFFBFA", 50: "#FEF3F2", 100: "#FEE4E2", 200: "#FECDCA",
								300: "#FDA29B", 400: "#F97066", 500: "#F04438", 600: "#D92D20",
								700: "#B42318", 800: "#912018", 900: "#7A271A",
							},
						},
						fontFamily: { sans: ["Outfit", "sans-serif"] },
						boxShadow: {
							"theme-xs": "0px 1px 2px 0px rgba(16, 24, 40, 0.05)",
							"theme-sm": "0px 1px 3px 0px rgba(16, 24, 40, 0.10), 0px 1px 2px 0px rgba(16, 24, 40, 0.06)",
							"theme-md": "0px 4px 8px -2px rgba(16, 24, 40, 0.10), 0px 2px 4px -2px rgba(16, 24, 40, 0.06)",
							"theme-lg": "0px 12px 16px -4px rgba(16, 24, 40, 0.08), 0px 4px 6px -2px rgba(16, 24, 40, 0.03)",
						},
					},
				},
			};
		</script>
		<style is:inline>
			.material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20; vertical-align: middle; }
			body { background: #F9FAFB; }
			html.dark body { background: #101828; }
			.nice-scroll::-webkit-scrollbar { width: 8px; height: 8px; }
			.nice-scroll::-webkit-scrollbar-thumb { background: #D0D5DD; border-radius: 8px; }
			.nice-scroll::-webkit-scrollbar-thumb:hover { background: #98A2B3; }
			html.dark .nice-scroll::-webkit-scrollbar-thumb { background: #344054; }
			html.dark .nice-scroll::-webkit-scrollbar-thumb:hover { background: #475467; }
			@keyframes pop-in { from { opacity: 0; transform: translateY(8px) scale(.99); } to { opacity: 1; transform: none; } }
			.pop-in { animation: pop-in .15s ease-out both; }
			@keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
			.fade-in { animation: fade-in .12s ease-out both; }
			/* Make form-input/select pick up dark mode automatically. */
			.dark .form-input, .dark .form-select, .dark .form-textarea {
				background-color: rgb(16 24 40);
				border-color: rgb(52 64 84);
				color: rgb(255 255 255 / 0.9);
			}
			.dark .form-input::placeholder, .dark .form-textarea::placeholder { color: rgb(255 255 255 / 0.3); }
		</style>
	</head>
	<body class="font-sans text-gray-700 antialiased dark:text-gray-300">
		<AdminSidebar active={active} />

		<div class="lg:pl-[290px] min-h-screen flex flex-col">
			<header class="sticky top-0 z-30 bg-white border-b border-gray-200 dark:bg-gray-900 dark:border-gray-800">
				<div class="px-4 sm:px-6 lg:px-8 h-[70px] flex items-center justify-between gap-4">
					<div class="flex items-center gap-3 min-w-0">
						<button id="sidebar-toggle" type="button" aria-label="Toggle menu"
							class="lg:hidden grid h-10 w-10 shrink-0 place-items-center rounded-lg border border-gray-200 text-gray-500 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-white/[0.03] transition">
							<span class="material-symbols-outlined">menu</span>
						</button>
						<div class="min-w-0">
							<h1 class="text-base font-semibold text-gray-800 dark:text-white/90 truncate">{title}</h1>
							<p class="hidden sm:block text-xs text-gray-400 dark:text-gray-500">Utah · Mountain Time</p>
						</div>
					</div>
					<div class="flex items-center gap-2">
						{subscribers !== null && (
							<span class="hidden md:inline-flex items-center gap-1.5 rounded-full bg-gray-50 border border-gray-200 px-3 py-1.5 text-xs font-medium text-gray-600 dark:bg-white/[0.03] dark:border-gray-800 dark:text-gray-300">
								<span class="material-symbols-outlined text-sm text-gray-400">group</span>{subscribers} subscribers
							</span>
						)}
						<button type="button" onclick="toggleTheme()" title="Toggle theme"
							class="grid h-10 w-10 place-items-center rounded-full text-gray-500 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-white/[0.05] transition">
							<span class="material-symbols-outlined text-xl dark:hidden">dark_mode</span>
							<span class="material-symbols-outlined text-xl hidden dark:inline">light_mode</span>
						</button>
						<slot name="actions" />
						<div class="w-px h-6 bg-gray-200 dark:bg-gray-700 mx-1"></div>
						<a href={nav.logout} title="Sign out" class="grid h-10 w-10 place-items-center rounded-full bg-gray-100 text-gray-500 hover:bg-gray-200 hover:text-gray-700 dark:bg-white/[0.03] dark:text-gray-400 dark:hover:bg-white/[0.06] transition">
							<span class="material-symbols-outlined text-lg">logout</span>
						</a>
					</div>
				</div>
			</header>

			<main class="flex-1 px-4 sm:px-6 lg:px-8 py-6 lg:py-8 w-full max-w-[96rem] mx-auto space-y-6">
				<div class="flex items-end justify-between flex-wrap gap-3">
					{description ? (
						<p class="text-sm text-gray-500 dark:text-gray-400">{description}</p>
					) : (
						<span></span>
					)}
					<nav aria-label="Breadcrumb" class="text-xs text-gray-400 dark:text-gray-500 flex items-center gap-1.5">
						<a href={nav.home} class="hover:text-brand-500 transition">Email</a>
						<span>/</span>
						<span class="text-gray-800 dark:text-white/90 font-medium">{title}</span>
					</nav>
				</div>

				{loadError && (
					<div class="rounded-2xl bg-white border border-error-200 px-5 py-4 text-sm text-error-700 shadow-theme-xs dark:bg-white/[0.03] dark:border-error-500/30 dark:text-error-400">
						<strong>Couldn't load this page:</strong> {loadError}
					</div>
				)}

				<slot />

				<p class="text-center text-xs text-gray-400 dark:text-gray-500 pb-4">CureVà Beauty Lounge · Email · All times Mountain Time (Utah)</p>
			</main>
		</div>

		<script is:inline>
			// Theme toggle — shared by every dashboard page.
			function toggleTheme() {
				const root = document.documentElement;
				const isDark = root.classList.toggle("dark");
				try { localStorage.setItem("theme", isDark ? "dark" : "light"); } catch (_) {}
			}
			window.toggleTheme = toggleTheme;
		</script>
		<slot name="scripts" />
	</body>
</html>
