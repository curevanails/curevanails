---
/**
 * /getready — the waiting-list landing, and the root page of the standalone
 * `getready` Worker (see src/middleware.ts).
 *
 * CONTENT PRESERVED, DESIGN REPLACED. Every heading, benefit, list item and
 * line of copy below is what this page shipped with — the July 2026
 * "Landing page Coming Soon CURE VÀ" doc: the hero, the first-100 offer,
 * the CURE VÀ Difference, and the careers teaser that hands off to
 * /recruit. It is built from the version-H system now instead of the warm
 * "Gallacher Collective" one.
 *
 * Two changes worth naming:
 *   1 · The photography was Google `aida-public` URLs — temporary links
 *       that expire. It is the brand's own assets now.
 *   2 · The waiting-list form is <WaitlistForm />, shared with /waitlist.
 *       Its markup, hooks and POST to /api/waitlist are unchanged, so the
 *       D1 row and /admin/waitlist still work exactly as before.
 */
export const prerender = false;

import VersionH from "../layouts/VersionH.astro";
import WaitlistForm from "../components/vh/WaitlistForm.astro";

const PERKS = [
	"Priority booking before appointments open to the public",
	"Founding Member benefits",
	"Preferred pricing on memberships and services",
	"Access to our pre-opening booking event",
];

const DIFFERENCE = [
	{
		n: "01",
		t: "Zero-Gravity Comfort",
		d: "Leave the traditional salon chair behind. Relax in an ergonomic zero-gravity chair designed to support your body while you enjoy your service.",
	},
	{
		n: "02",
		t: "Waterless by Design",
		d: "No shared soaking basins. Our waterless approach is cleaner, more hygienic, and better for long-term nail health.",
	},
	{
		n: "03",
		t: "Beauty That Fits Your Schedule",
		d: "Enjoy multiple services during the same appointment — from nail care and facials to lash lifts and more — so you can make the most of your time.",
	},
];

const GROW = [
	{
		t: "Training",
		d: "You'll receive training in the unique techniques and service experience that make CURE VÀ different from a traditional salon.",
	},
	{
		t: "A Cleaner Environment",
		d: "No acrylics, no dip powders, and no strong chemical odors. Our focus is on clean products and long-term wellness.",
	},
	{
		t: "Designed With Comfort in Mind",
		d: "From our specialized zero-gravity setup to our thoughtful service model, every detail is designed to create a more comfortable experience for both clients and professionals.",
	},
];
---

<VersionH
	title="Get ready"
	description="Cure Và — a calm, non-toxic beauty lounge opening December 2026 at Legacy Village, Sugar House. Join the waiting list."
	nav="dark"
	current="/coming-soon"
>

<!-- ══ hero ══════════════════════════════════════════════════════════ -->
<section class="sec sec--first" id="top" aria-labelledby="heroH">
  <div class="wrap gr-hero">
    <div>
      <span class="eyebrow" data-r="fade">Opening December 2026 · Legacy Village</span>
      <h1 class="h-xl gr-h1" id="heroH" data-r style="--d:60ms">Enhance what&rsquo;s already
        <em>beautiful.</em></h1>
      <p class="lede" data-r="fade" style="--d:120ms;margin-top:1.6rem">We&rsquo;re creating the
        kind of space we always wished existed — a calm, non-toxic space focused on healthy nails,
        radiant skin, and naturally enhanced beauty.</p>
      <p class="lede" data-r="fade" style="--d:170ms;margin-top:1rem">From waterless nail care to
        customized facials and lash lifts, every service is designed to help you look polished,
        refreshed, and completely yourself.</p>
      <p class="gr-cta" data-r="fade" style="--d:230ms">
        <a class="btn btn--lg" href="#waitlist" data-mag>Reserve My Spot</a>
        <a class="btn btn--outline btn--lg" href="#difference" data-mag>The CURE VÀ difference</a>
      </p>
      <p class="gr-chips" data-r="fade" style="--d:280ms">
        <span class="badge badge--outline"><span class="dot" aria-hidden="true"></span>Calm &amp; non-toxic</span>
        <span class="badge badge--outline">Waterless by design</span>
      </p>
    </div>
    <div class="fr fr--tall" data-r="zoom" style="--d:120ms">
      <img src="/img/d-hero-room.webp" width="1600" height="1067" decoding="async"
        fetchpriority="high" alt="The studio interior in morning light">
    </div>
  </div>
</section>

<!-- ══ the waiting list ══════════════════════════════════════════════ -->
<section class="sec on-light" id="waitlist" aria-labelledby="wlH">
  <span class="ix" aria-hidden="true">01</span>
  <div class="wrap gr-wl">
    <div>
      <span class="eyebrow" data-r="fade">Join the Waiting List</span>
      <h2 class="h-lg" id="wlH" data-r style="--d:60ms">Be among the first to experience
        <em>CURE VÀ.</em></h2>
      <p class="mono gr-perk-h" data-r="fade" style="--d:120ms">The first 100 subscribers will
        receive:</p>
      <ul class="gr-perks" data-r="fade" style="--d:160ms">
        {PERKS.map((p) => <li>{p}</li>)}
      </ul>
    </div>

    <article class="card gr-wl-card" data-r style="--d:120ms">
      <div class="card-header">
        <h3 class="h-sm">Reserve your spot</h3>
        <p class="card-description">Leave your email and we&rsquo;ll be in touch before we open.</p>
      </div>
      <div class="card-content">
        <WaitlistForm source="getready-waitlist" label="Reserve My Spot" />
      </div>
    </article>
  </div>
</section>

<!-- ══ the difference ════════════════════════════════════════════════ -->
<section class="sec" id="difference" aria-labelledby="diffH">
  <span class="ix" aria-hidden="true">02</span>
  <div class="wrap">
    <div class="head head--split">
      <div>
        <span class="eyebrow" data-r="fade">Why it feels different</span>
        <h2 class="h-lg" id="diffH" data-r style="--d:60ms">The CURE VÀ <em>Difference</em></h2>
      </div>
    </div>
    <div class="gr-grid">
      {DIFFERENCE.map((d, i) => (
        <article class="card gr-card" data-r style={`--d:${60 + i * 70}ms`}>
          <div class="card-header">
            <span class="mono num">{d.n}</span>
            <h3 class="h-sm">{d.t}</h3>
          </div>
          <div class="card-content"><p class="card-description">{d.d}</p></div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ══ careers ═══════════════════════════════════════════════════════ -->
<section class="sec on-light" id="careers" aria-labelledby="carH">
  <span class="ix" aria-hidden="true">03</span>
  <div class="wrap gr-careers">
    <div class="fr fr--tall" data-r="zoom"><img src="/img/h-applying.webp"
      width="1600" height="2397" decoding="async" loading="lazy"
      alt="A technician applying polish"></div>
    <div>
      <span class="eyebrow" data-r="fade">Careers at CURE VÀ</span>
      <h2 class="h-lg" id="carH" data-r style="--d:60ms">Grow with us from <em>day one.</em></h2>
      <p class="lede" data-r="fade" style="--d:120ms;margin-top:1.4rem">We&rsquo;re creating the
        kind of beauty studio we always wished existed — not just for our clients, but for the
        professionals who care for them.</p>
      <p class="lede" data-r="fade" style="--d:160ms;margin-top:1rem">Opening in Sugar House this
        December, we&rsquo;re looking to connect with:</p>
      <p class="gr-chips" data-r="fade" style="--d:200ms">
        <span class="badge badge--outline">Nail Technicians</span>
        <span class="badge badge--outline">Estheticians</span>
      </p>

      <div class="gr-grow" data-r="fade" style="--d:240ms">
        <p class="mono gr-perk-h">Why Grow With Us?</p>
        <dl class="gr-grow-list">
          {GROW.map((g) => (<><dt>{g.t}</dt><dd>{g.d}</dd></>))}
        </dl>
      </div>

      <p class="gr-cta" data-r="fade" style="--d:280ms">
        <a class="btn btn--lg" href="/recruit/apply" data-mag>Join Our Talent List</a>
        <a class="btn btn--outline btn--lg" href="/recruit" data-mag>See open roles</a>
      </p>
      <p class="gr-fine">Leave your information and we&rsquo;ll personally reach out when
        interview scheduling begins this fall.</p>
    </div>
  </div>
</section>

</VersionH>

<style is:global>
/* ═══ get ready ═════════════════════════════════════════════════════════
   Composed from tokens; names no colour. ═══════════════════════════════ */
.gr-hero{display:grid;gap:2.4rem;align-items:center}
@media (min-width:960px){.gr-hero{grid-template-columns:1.05fr .95fr;gap:3.4rem}}
.gr-h1{margin-top:1rem;max-width:14ch}
.gr-cta{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:2.2rem}
.gr-chips{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.4rem}

.gr-wl{display:grid;gap:2.4rem;align-items:start}
@media (min-width:960px){.gr-wl{grid-template-columns:1fr 1fr;gap:3.75rem}}
.gr-perk-h{margin-top:1.8rem}
.gr-perks{list-style:none;margin:1rem 0 0;padding:0;display:grid;gap:.65rem}
.gr-perks li{position:relative;padding-left:1.5rem;font-size:.95rem;line-height:1.6;
  color:hsl(var(--muted-foreground))}
.gr-perks li::before{content:"";position:absolute;left:0;top:.68em;width:9px;height:1px;
  background:hsl(var(--accent))}
.gr-wl-card{padding:clamp(1.5rem,3vw,2.4rem);
  box-shadow:inset 0 0 0 1px var(--border-hairline-2),var(--sh)}
.gr-wl-card .card-header,.gr-wl-card .card-content{padding:0}
.gr-wl-card .card-content{padding-top:1.4rem}

.gr-grid{display:grid;gap:1rem}
@media (min-width:820px){.gr-grid{grid-template-columns:repeat(3,1fr)}}
.gr-card{align-content:start;padding:clamp(1.3rem,2.4vw,1.9rem);
  box-shadow:inset 0 0 0 1px var(--border-hairline-2),var(--sh-d)}
.gr-card .card-header,.gr-card .card-content{padding:0}
.gr-card .card-header{gap:.7rem}
.gr-card .card-content{padding-top:.8rem}
.gr-card .mono{color:hsl(var(--accent))}

.gr-careers{display:grid;gap:2.4rem;align-items:center}
@media (min-width:960px){.gr-careers{grid-template-columns:.85fr 1.15fr;gap:3.4rem}}
.gr-grow{margin-top:2.2rem}
.gr-grow-list{margin:1rem 0 0;display:grid;gap:1rem}
.gr-grow-list dt{font-size:.94rem;font-weight:700;color:hsl(var(--foreground))}
.gr-grow-list dd{margin:.3rem 0 0;font-size:.9rem;line-height:1.6;
  color:hsl(var(--muted-foreground));max-width:60ch}
.gr-fine{margin-top:1rem;font-size:.78rem;color:hsl(var(--muted-foreground));max-width:52ch}
</style>
