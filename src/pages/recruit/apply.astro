---
/**
 * /recruit/apply — the Hiring Form.
 *
 * CONTENT AND PIPELINE PRESERVED, DESIGN REPLACED.
 *
 * The <form> markup below is the previous page's, VERBATIM: the same 13
 * field names, the same option values, the same `js-*` hooks, the same
 * multipart POST to /api/recruit. The submit/validation script is verbatim
 * too. That is deliberate and it is not tidiness — those names are the
 * contract with src/pages/api/recruit.ts, the D1 `job_applications`
 * columns, the R2 `recruit/` keys and the /admin dashboard that reads
 * them. Restyling must not touch them. See docs/RECRUIT.md.
 *
 * What changed is the shell and the skin: the standalone plaster/walnut
 * document became the version-H layout, and the form's own CSS is composed
 * from tokens (`.label`, `.input`, `.checkbox`, `.alert`, `.card`, `.btn`)
 * so it re-themes with the rest of the site.
 *
 * The duplicated open-roles accordion is now <RoleAccordion />, shared with
 * /recruit.
 */
export const prerender = false;

import VersionH from "../../layouts/VersionH.astro";
import RoleAccordion from "../../components/vh/RoleAccordion.astro";
---

<VersionH
	title="Career Application"
	description="Apply to join the Cure Và founding team in Sugar House — nail technicians, estheticians, lash & brow specialists and cosmetologists."
	nav="paper"
	current="/recruit/apply"
>

<!-- ══ open roles, for quick appliers ════════════════════════════════ -->
<section class="sec sec--first sec--tight on-light" id="roles" aria-labelledby="rolesH">
  <div class="wrap ap-wrap">
    <div class="head">
      <span class="eyebrow" data-r="fade">Open roles</span>
      <h2 class="h-lg" id="rolesH" data-r style="--d:60ms">Who we&rsquo;re hiring
        <em>this December</em></h2>
      <p class="lede" data-r="fade" style="--d:120ms">Six founding-team openings in Sugar House —
        the same application below covers every role.</p>
    </div>
    <RoleAccordion applyHref="#form" />
  </div>
</section>

<!-- ══ the application ═══════════════════════════════════════════════ -->
<section class="sec" aria-labelledby="formH">
  <div class="wrap ap-wrap">

<div class="app-shell" id="form">

    <!-- ===== HEADER BAND ===== -->
    <div class="app-head">
      <a class="back" href="/recruit">← Back to open roles</a>
      <h1 class="h-lg" id="formH">Career <em>Application</em></h1>
      <p>Nail · Esthetics · Lash &amp; Brow · Cosmetology — tell us a little about yourself.</p>
    </div>

    <!-- ===== FORM ===== -->
    <form class="app-body js-apply-full" action="/api/recruit" method="POST" enctype="multipart/form-data" novalidate>

      <!-- Contact Information -->
      <div class="ap-grp">
        <div class="ap-grp-h">
          <span class="si"><svg viewBox="0 0 24 24" fill="none" stroke="#5E6247" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M5 20a7 7 0 0 1 14 0"/></svg></span>
          <h2>Contact Information</h2>
        </div>
        <div class="row2">
          <div class="fld"><label for="first_name">First Name <span class="req">*</span></label><input class="inp" id="first_name" name="first_name" autocomplete="given-name" placeholder="Jane" /></div>
          <div class="fld"><label for="last_name">Last Name <span class="req">*</span></label><input class="inp" id="last_name" name="last_name" autocomplete="family-name" placeholder="Doe" /></div>
        </div>
        <div class="row2" style="margin-top:20px;">
          <div class="fld"><label for="email">Email Address <span class="hint">(optional)</span></label><input class="inp" id="email" name="email" type="email" autocomplete="email" placeholder="jane@example.com" /></div>
          <div class="fld"><label for="phone">Phone Number <span class="req">*</span></label><input class="inp" id="phone" name="phone" type="tel" autocomplete="tel" placeholder="(801) 000-0000" /></div>
        </div>
      </div>

      <!-- Professional Information -->
      <div class="ap-grp">
        <div class="ap-grp-h">
          <span class="si"><svg viewBox="0 0 24 24" fill="none" stroke="#5E6247" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.5 8 8 11 4.5-3 8-6 8-11V5l-8-3Z"/><polyline points="9 12 11 14 15 10"/></svg></span>
          <h2>Professional Information</h2>
        </div>

        <div class="fld">
          <span class="q-label">Which position(s) are you interested in? <span class="req">*</span><span class="hint">(select all that apply)</span></span>
          <div class="opts js-group" data-name="positions" style="margin-top:2px;">
            <label class="opt"><input type="checkbox" name="positions" value="nail_technician" /><span class="mk"></span>Nail Technician</label>
            <label class="opt"><input type="checkbox" name="positions" value="esthetician" /><span class="mk"></span>Esthetician</label>
            <label class="opt"><input type="checkbox" name="positions" value="cosmetologist" /><span class="mk"></span>Cosmetologist</label>
            <label class="opt"><input type="checkbox" name="positions" value="lash_artist" /><span class="mk"></span>Lash Artist</label>
            <label class="opt"><input type="checkbox" name="positions" value="open_to_multiple" /><span class="mk"></span>I'm open to multiple roles</label>
          </div>
        </div>

        <div class="fld" style="margin-top:22px;">
          <span class="q-label">What is your current status? <span class="req">*</span></span>
          <div class="inline-opts stack js-group" data-name="current_status" style="margin-top:4px;">
            <label class="iopt"><input type="radio" name="current_status" value="licensed_utah" /><span class="mk"></span>Licensed in Utah</label>
            <label class="iopt"><input type="radio" name="current_status" value="beauty_school" /><span class="mk"></span>Currently attending beauty school</label>
            <label class="iopt"><input type="radio" name="current_status" value="transferring_license" /><span class="mk"></span>Transferring my license to Utah</label>
          </div>
        </div>

        <div class="fld" style="margin-top:22px;max-width:calc(50% - 10px);">
          <label for="graduation_date">Expected Graduation Date <span class="hint">(if applicable)</span></label>
          <div class="date-wrap">
            <input class="inp js-month" id="graduation_date" name="graduation_date" placeholder="Month / Year" />
            <svg class="cal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="18" rx="3"/><path d="M3 9h18M8 2v4M16 2v4"/></svg>
          </div>
        </div>

        <div class="fld" style="margin-top:22px;">
          <span class="q-label">Which best describes you? <span class="req">*</span></span>
          <div class="inline-opts stack js-group" data-name="background" style="margin-top:4px;">
            <label class="iopt"><input type="radio" name="background" value="school_or_recent_grad" /><span class="mk"></span>I'm currently in beauty school or recently graduated.</label>
            <label class="iopt"><input type="radio" name="background" value="salon_experience" /><span class="mk"></span>I've worked in a salon or spa before.</label>
          </div>
        </div>

        <div class="fld" style="margin-top:22px;">
          <span class="q-label">What type of position are you looking for? <span class="req">*</span></span>
          <div class="inline-opts js-group" data-name="employment_type" style="margin-top:4px;">
            <label class="iopt"><input type="radio" name="employment_type" value="full_time" /><span class="mk"></span>Full-time</label>
            <label class="iopt"><input type="radio" name="employment_type" value="part_time" /><span class="mk"></span>Part-time</label>
            <label class="iopt"><input type="radio" name="employment_type" value="either" /><span class="mk"></span>Either Full-time or Part-time</label>
          </div>
        </div>
      </div>

      <!-- Portfolio -->
      <div class="ap-grp">
        <div class="ap-grp-h">
          <span class="si"><svg viewBox="0 0 24 24" fill="none" stroke="#5E6247" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v5h5"/><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-5Z"/><path d="M12 18v-6M9.5 14.5 12 12l2.5 2.5"/></svg></span>
          <h2>Portfolio</h2>
        </div>

        <div class="fld">
          <div class="drop js-drop" tabindex="0">
            <div class="dz-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M17 17a4 4 0 0 0 .5-8A6 6 0 0 0 6 9a4.5 4.5 0 0 0-.5 9"/><path d="M12 12v7M9 15l3-3 3 3"/></svg></div>
            <div class="dz-t">Upload your Resume <span class="hint">(optional)</span></div>
            <div class="dz-s">Drag and drop or click to browse (PDF, Word)</div>
            <div class="dz-file js-dropfile"></div>
            <input type="file" class="js-resume" name="resume" accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" hidden />
          </div>
        </div>

        <div class="or-row"><span>OR</span></div>

        <div class="fld">
          <label for="portfolio_link">Instagram Portfolio / Facebook / LinkedIn</label>
          <input class="inp" id="portfolio_link" name="portfolio_link" placeholder="@yourhandle or a profile link" />
        </div>
      </div>

      <!-- Short Question -->
      <div class="ap-grp">
        <div class="ap-grp-h">
          <span class="si"><svg viewBox="0 0 24 24" fill="none" stroke="#5E6247" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-8 8H4l1.6-3.2A8 8 0 1 1 21 12Z"/><path d="M9.5 9.5A2.5 2.5 0 0 1 14 11c0 1.5-2 1.8-2 3"/><circle cx="12" cy="17" r=".5"/></svg></span>
          <h2>Short Question</h2>
        </div>

        <div class="fld">
          <label for="why_cureva">Why would you like to work at CURE VÀ?</label>
          <textarea class="inp" id="why_cureva" name="why_cureva" rows="3" maxlength="1000" placeholder="2–3 sentences is perfect…"></textarea>
        </div>
      </div>

      <hr class="app-divider" />

      <div style="margin-top:28px;">
        <label class="consent">
          <input type="checkbox" name="contact_consent" value="yes" />
          <span class="mk"></span>
          <span>I agree to be contacted about future career opportunities at CURE VÀ.</span>
        </label>
      </div>

      <div class="submit-row">
        <button class="btn btn--lg js-submit" data-mag type="submit" style="min-width:280px;">Submit Application</button>
        <p class="form-alert js-alert" role="status"></p>
        <div class="app-foot-note">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
          Your data is securely processed and reviewed only by our hiring team.
        </div>
      </div>
    </form>

    <!-- ===== SUCCESS ===== -->
    <div class="done-card js-done">
      <div class="seal"><svg viewBox="0 0 24 24" fill="none" stroke="#5E6247" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
      <h2>Thank you, <em class="js-done-name">friend</em>.</h2>
      <p>Your application is in. We read every one ourselves and we'll be in touch within a week. In the meantime — breathe easy.</p>
      <div style="margin-top:30px;display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
        <a class="btn" href="/recruit">Back to careers</a>
        <a class="btn btn--outline" href="/">Visit the lounge</a>
      </div>
    </div>

  </div>
  </div>
</section>

</VersionH>

<style is:global>
/* ═══ the Hiring Form ═══════════════════════════════════════════════════
   Every rule composed from tokens — no hex, no rgb(), no brand alias — so
   the form re-themes with the rest of the site and the invariant in
   design/version-h/DESIGN-SYSTEM.md §2.3 holds here too.

   The class names are the previous page's on purpose: they are the hooks
   the validation script and the endpoint contract are written against.
   ═══════════════════════════════════════════════════════════════════════ */
.ap-wrap{max-width:64rem}

/* the shell — a Card, with the elevation this usage wants */
.app-shell{border-radius:var(--radius-lg);background:hsl(var(--card));
  color:hsl(var(--card-foreground));overflow:hidden;
  box-shadow:inset 0 0 0 1px var(--border-hairline-2),var(--sh-d)}
.app-head{padding:clamp(1.8rem,4vw,2.6rem) clamp(1.4rem,3.4vw,2.9rem);
  border-bottom:1px solid var(--border-hairline)}
.app-head .back{display:inline-flex;align-items:center;gap:.5rem;font-size:.78rem;
  font-weight:700;letter-spacing:.02em;text-decoration:none;
  color:hsl(var(--muted-foreground));transition:color .35s var(--ease)}
.app-head .back:hover{color:hsl(var(--foreground))}
.app-head h1{margin-top:1rem}
.app-head h1 em{color:hsl(var(--accent))}
.app-head>p{margin-top:.75rem;font-size:.95rem;color:hsl(var(--muted-foreground))}
.app-body{padding:clamp(1.4rem,3.4vw,2.9rem)}

/* a field group */
.ap-grp+.ap-grp{margin-top:clamp(2rem,4vw,2.9rem);padding-top:clamp(2rem,4vw,2.9rem);
  border-top:1px solid var(--border-hairline-2)}
.ap-grp-h{display:flex;align-items:center;gap:.75rem;margin-bottom:1.4rem}
.ap-grp-h h2{font-size:.68rem;font-weight:800;font-family:Manrope,sans-serif;
  letter-spacing:.22em;text-transform:uppercase;color:hsl(var(--accent));line-height:1}
.si{display:grid;place-items:center;width:30px;height:30px;flex:none;border-radius:50%;
  box-shadow:inset 0 0 0 1px var(--border-hairline)}
.si svg{width:15px;height:15px;stroke:hsl(var(--accent))}

.fld{display:grid;gap:.5rem}
.row2{display:grid;gap:1.25rem}
@media (min-width:640px){.row2{grid-template-columns:1fr 1fr}}

/* Label · Input — the system's field: an underline under a small
   uppercase label. Not a bordered box. */
.fld>label,.q-label{display:block;font-size:.66rem;font-weight:800;letter-spacing:.16em;
  text-transform:uppercase;color:hsl(var(--muted-foreground))}
.req{color:hsl(var(--destructive));font-weight:800}
.hint{margin-left:.4em;font-weight:600;letter-spacing:.06em;text-transform:none;
  color:hsl(var(--muted-foreground) / .75)}
.inp{width:100%;font:inherit;font-size:1rem;color:hsl(var(--foreground));
  background:transparent;border:0;border-bottom:1px solid var(--border-hairline);
  padding:.75em 0;border-radius:0;transition:border-color .4s var(--ease)}
.inp::placeholder{color:hsl(var(--muted-foreground) / .55)}
.inp:focus{outline:0;border-color:hsl(var(--ring))}
textarea.inp{resize:vertical;min-height:5.5em}
/* the script writes .err; the system's rule is that the state also reaches
   the control, so aria-invalid rides along on the same declaration */
.inp.err,.inp[aria-invalid=true]{border-color:hsl(var(--destructive))}
.date-wrap{position:relative}
.date-wrap .cal{position:absolute;right:0;top:50%;width:17px;height:17px;
  transform:translateY(-50%);pointer-events:none;color:hsl(var(--muted-foreground))}

/* option pills — a checkbox or radio wearing the Badge's shape */
.opts,.inline-opts{display:flex;flex-wrap:wrap;gap:.55rem}
.inline-opts.stack{flex-direction:column;align-items:flex-start}
.opt,.iopt{position:relative;display:inline-flex;align-items:center;gap:.6rem;cursor:pointer;
  padding:.62em 1.05em;border-radius:999px;font-size:.82rem;font-weight:600;
  color:hsl(var(--muted-foreground));box-shadow:inset 0 0 0 1px var(--border-hairline);
  transition:color .35s var(--ease),box-shadow .35s var(--ease),background .35s var(--ease)}
.opt input,.iopt input{position:absolute;opacity:0;width:0;height:0}
.opt .mk,.iopt .mk{width:15px;height:15px;flex:none;border-radius:50%;position:relative;
  box-shadow:inset 0 0 0 1.4px var(--border-hairline);transition:box-shadow .3s var(--ease)}
.opt .mk{border-radius:5px}
.opt .mk::after,.iopt .mk::after{content:"";position:absolute;inset:50%;border-radius:inherit;
  background:hsl(var(--accent));transition:inset .28s var(--ease-spring)}
.opt input:checked~.mk::after,.iopt input:checked~.mk::after{inset:3.5px}
.opt:hover,.iopt:hover{color:hsl(var(--foreground))}
.opt:has(input:checked),.iopt:has(input:checked){color:hsl(var(--foreground));
  background:hsl(var(--muted));box-shadow:inset 0 0 0 1.4px hsl(var(--accent))}
.opt:focus-within,.iopt:focus-within{outline:2px solid hsl(var(--ring));outline-offset:3px}
.js-group.err .opt,.js-group.err .iopt{box-shadow:inset 0 0 0 1.4px hsl(var(--destructive))}

/* résumé dropzone */
.drop{display:grid;justify-items:center;gap:.4rem;text-align:center;cursor:pointer;
  padding:clamp(1.6rem,3.4vw,2.4rem);border-radius:var(--radius-md);
  background:hsl(var(--muted));box-shadow:inset 0 0 0 1px var(--border-hairline);
  transition:box-shadow .35s var(--ease)}
.drop:hover,.drop:focus-visible,.drop.drag{box-shadow:inset 0 0 0 1.6px hsl(var(--accent))}
.drop.err{box-shadow:inset 0 0 0 1.6px hsl(var(--destructive))}
.dz-ico svg{width:26px;height:26px;color:hsl(var(--accent))}
.dz-t{font-size:.92rem;font-weight:700;color:hsl(var(--foreground))}
.dz-s{font-size:.8rem;color:hsl(var(--muted-foreground))}
.dz-file{font-size:.8rem;font-weight:700;color:hsl(var(--accent))}
.drop.filled .dz-s{display:none}
.or-row{display:flex;align-items:center;gap:1rem;margin:1.4rem 0;
  font-size:.66rem;font-weight:800;letter-spacing:.22em;
  color:hsl(var(--muted-foreground))}
.or-row::before,.or-row::after{content:"";flex:1;height:1px;background:var(--border-hairline)}

.app-divider{border:0;height:1px;background:var(--border-hairline);
  margin:clamp(2rem,4vw,2.9rem) 0 0}
.consent{position:relative;display:flex;gap:.7rem;align-items:flex-start;cursor:pointer;
  font-size:.86rem;color:hsl(var(--muted-foreground))}
.consent input{position:absolute;opacity:0;width:0;height:0}
.consent .mk{width:16px;height:16px;flex:none;margin-top:.15em;border-radius:5px;
  position:relative;box-shadow:inset 0 0 0 1.4px var(--border-hairline)}
.consent .mk::after{content:"";position:absolute;inset:50%;border-radius:3px;
  background:hsl(var(--accent));transition:inset .28s var(--ease-spring)}
.consent input:checked~.mk::after{inset:3.5px}
.consent:focus-within .mk{box-shadow:inset 0 0 0 1.6px hsl(var(--ring))}

.submit-row{display:grid;gap:1rem;justify-items:start;margin-top:clamp(1.8rem,3.4vw,2.4rem)}
.form-alert{font-size:.82rem;color:hsl(var(--foreground));min-height:1em}
.form-alert.bad{color:hsl(var(--destructive))}
.app-foot-note{display:flex;align-items:center;gap:.55rem;font-size:.76rem;
  color:hsl(var(--muted-foreground))}
.app-foot-note svg{width:15px;height:15px;flex:none}

/* the success state — the script swaps to this and focuses it */
.done-card{display:none;padding:clamp(2.4rem,6vw,4rem) clamp(1.4rem,3.4vw,2.9rem);
  text-align:center}
.done-card.show{display:block}
.done-card .seal{display:grid;place-items:center;width:56px;height:56px;margin:0 auto 1.4rem;
  border-radius:50%;box-shadow:inset 0 0 0 1.6px hsl(var(--accent))}
.done-card .seal svg{width:24px;height:24px;stroke:hsl(var(--accent))}
.done-card h2{font-size:clamp(1.6rem,3.4vw,2.4rem)}
.done-card h2 em{color:hsl(var(--accent))}
.done-card>p{margin-top:.9rem;font-size:.95rem;color:hsl(var(--muted-foreground));
  max-width:46ch;margin-inline:auto}
</style>

<script is:inline>
  (function () {
    'use strict';
    var form = document.querySelector('.js-apply-full');
    if (!form) return;

    var alertEl = form.querySelector('.js-alert');
    var submitBtn = form.querySelector('.js-submit');
    var drop = document.querySelector('.js-drop');
    var resume = document.querySelector('.js-resume');
    var dropFile = document.querySelector('.js-dropfile');

    /* ---- graduation field: text → month on focus so the placeholder shows.
       Browsers without <input type="month"> keep the text input; the endpoint
       also accepts an "MM/YYYY" string. ---- */
    document.querySelectorAll('.js-month').forEach(function (inp) {
      inp.addEventListener('focus', function () {
        var probe = document.createElement('input');
        probe.setAttribute('type', 'month');
        if (probe.type !== 'month') return; // unsupported → stay a text field
        inp.type = 'month';
        if (inp.showPicker) { try { inp.showPicker(); } catch (e) {} }
      });
      inp.addEventListener('blur', function () { if (!inp.value) inp.type = 'text'; });
    });

    /* ---- resume dropzone (optional) ---- */
    function showResume(file) {
      if (!file) return;
      drop.classList.add('filled');
      drop.classList.remove('err');
      dropFile.textContent = '✓ ' + file.name;
    }
    if (drop) {
      drop.addEventListener('click', function () { resume.click(); });
      drop.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); resume.click(); }
      });
      resume.addEventListener('change', function () { if (resume.files[0]) showResume(resume.files[0]); });
      ['dragenter', 'dragover'].forEach(function (ev) {
        drop.addEventListener(ev, function (e) { e.preventDefault(); drop.classList.add('drag'); });
      });
      ['dragleave', 'drop'].forEach(function (ev) {
        drop.addEventListener(ev, function (e) { e.preventDefault(); drop.classList.remove('drag'); });
      });
      drop.addEventListener('drop', function (e) {
        var f = e.dataTransfer.files[0];
        if (f) { try { resume.files = e.dataTransfer.files; } catch (err) {} showResume(f); }
      });
    }

    /* ---- clear error styling as the user fixes things ---- */
    form.querySelectorAll('.inp').forEach(function (i) {
      i.addEventListener('input', function () { i.classList.remove('err'); });
      i.addEventListener('change', function () { i.classList.remove('err'); });
    });
    form.querySelectorAll('.js-group').forEach(function (g) {
      g.addEventListener('change', function () { g.classList.remove('err'); });
    });

    function groupEl(name) { return form.querySelector('.js-group[data-name="' + name + '"]'); }
    function groupCount(name) {
      var g = groupEl(name);
      return g ? g.querySelectorAll('input:checked').length : 0;
    }

    var emailRe = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
    var monthRe = /^\d{4}-(0[1-9]|1[0-2])$/;
    var monthTextRe = /^(0?[1-9]|1[0-2])\s*\/\s*\d{4}$/;
    var letters = function (v) { return (v.match(/\p{L}/gu) || []).length; };

    var rules = {
      first_name: function (v) { return !v ? 1 : /\d/.test(v) ? 1 : letters(v) < 1 ? 1 : 0; },
      last_name: function (v) { return !v ? 1 : /\d/.test(v) ? 1 : letters(v) < 1 ? 1 : 0; },
      email: function (v) { return v && !emailRe.test(v) ? 1 : 0; }, // optional
      phone: function (v) { return !v ? 1 : /[A-Za-z]/.test(v) ? 1 : v.replace(/\D/g, '').length < 10 ? 1 : 0; },
      graduation_date: function (v) { return v && !monthRe.test(v) && !monthTextRe.test(v) ? 1 : 0; } // optional
    };

    function validate() {
      var firstBad = null;
      var problems = 0;

      Object.keys(rules).forEach(function (name) {
        var el = form.querySelector('[name="' + name + '"]');
        if (!el) return;
        if (rules[name]((el.value || '').trim())) {
          el.classList.add('err'); problems++; if (!firstBad) firstBad = el;
        } else {
          el.classList.remove('err');
        }
      });

      ['positions', 'current_status', 'background', 'employment_type'].forEach(function (name) {
        var g = groupEl(name);
        if (g && groupCount(name) === 0) {
          g.classList.add('err'); problems++; if (!firstBad) firstBad = g;
        }
      });

      // Resume is optional — only flag a file that's the wrong type or too big.
      var resumeRe = /\.(pdf|docx?)$/i;
      var MAX = 10 * 1024 * 1024;
      if (resume.files && resume.files[0]) {
        var f = resume.files[0];
        if (!resumeRe.test(f.name) || f.size > MAX) {
          drop.classList.add('err'); problems++; if (!firstBad) firstBad = drop;
        }
      }

      return { problems: problems, firstBad: firstBad };
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      var res = validate();
      if (res.problems) {
        alertEl.textContent = 'Please complete the highlighted fields (' + res.problems + ' remaining).';
        alertEl.className = 'form-alert js-alert bad';
        if (res.firstBad && res.firstBad.getBoundingClientRect) {
          window.scrollTo({ top: window.pageYOffset + res.firstBad.getBoundingClientRect().top - 140, behavior: 'smooth' });
        }
        return;
      }

      alertEl.textContent = '';
      alertEl.className = 'form-alert js-alert';
      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting…';

      try {
        var response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' }
        });
        var data = await response.json().catch(function () { return {}; });

        if (response.ok && data.ok) {
          var nameVal = (form.querySelector('[name="first_name"]').value || '').trim() || 'friend';
          var doneName = document.querySelector('.js-done-name');
          if (doneName) doneName.textContent = nameVal;
          document.querySelector('.app-head').style.display = 'none';
          form.style.display = 'none';
          document.querySelector('.js-done').classList.add('show');
          window.scrollTo({ top: 0, behavior: 'smooth' });
          return;
        }

        // Server-side field errors → re-highlight
        if (data && data.errors) {
          Object.keys(data.errors).forEach(function (key) {
            var field = form.querySelector('[name="' + key + '"]');
            var g = groupEl(key);
            if (g) g.classList.add('err');
            else if (field && field.type !== 'file') field.classList.add('err');
            else if (key === 'resume') drop.classList.add('err');
          });
        }
        alertEl.textContent = data.error || 'Please review the highlighted fields and try again.';
        alertEl.className = 'form-alert js-alert bad';
      } catch (err) {
        alertEl.textContent = 'Network error. Please check your connection and try again.';
        alertEl.className = 'form-alert js-alert bad';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit Application';
      }
    });
  })();
</script>
