<script is:inline>
  // Waitlist form — client-side validation + POST to /api/waitlist (the same
  // D1-backed endpoint the getready splash uses). The endpoint requires both
  // email and phone; success is {ok:true, alreadyJoined}, failure is
  // {ok:false, errors|error}.
  (function () {
    'use strict';
    function isEmail(v) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test((v || '').trim()); }
    function digits(v) { return (v || '').replace(/\D/g, ''); }

    document.querySelectorAll('.js-waitlist').forEach(function (form) {
      var email = form.querySelector('input[type="email"]');
      var phone = form.querySelector('input[type="tel"]');
      var msg = form.querySelector('.js-msg') || form.parentElement.querySelector('.js-msg');
      var btn = form.querySelector('button[type="submit"], .btn');
      var origLabel = btn ? btn.textContent : '';

      function setMsg(text, kind) {
        if (!msg) return;
        msg.textContent = text;
        msg.className = 'form-msg js-msg' + (kind ? ' ' + kind : '');
      }
      function restore() {
        if (btn) { btn.textContent = origLabel; btn.disabled = false; }
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var emailVal = email ? email.value.trim() : '';
        var phoneVal = phone ? phone.value.trim() : '';

        if (!isEmail(emailVal)) {
          if (email) { email.classList.add('err'); email.focus(); }
          setMsg('Please enter a valid email address.', 'bad');
          return;
        }
        if (digits(phoneVal).length < 10) {
          if (phone) { phone.classList.add('err'); phone.focus(); }
          setMsg('Please enter a valid phone number (at least 10 digits).', 'bad');
          return;
        }
        if (email) email.classList.remove('err');
        if (phone) phone.classList.remove('err');

        if (btn) { btn.disabled = true; btn.textContent = 'Adding…'; }
        setMsg('', '');

        fetch('/api/waitlist', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email: emailVal, phone: phoneVal, source: 'waitlist-landing' })
        }).then(function (res) {
          return res.json().catch(function () { return {}; }).then(function (data) {
            return { status: res.status, data: data || {} };
          });
        }).then(function (r) {
          var data = r.data;
          if (r.status >= 200 && r.status < 300 && data.ok) {
            setMsg(data.alreadyJoined
              ? "You're already on the list — see you at opening."
              : "You're on the list — welcome to CureVà. We'll be in touch soon.", 'ok');
            form.reset();
            if (btn) {
              btn.textContent = 'Added ✓';
              setTimeout(function () { restore(); }, 2600);
            }
            return;
          }
          var errText = data.error;
          if (!errText && data.errors) errText = data.errors.email || data.errors.phone;
          if (data.errors) {
            if (data.errors.email && email) email.classList.add('err');
            if (data.errors.phone && phone) phone.classList.add('err');
          }
          setMsg(errText || 'Something went wrong. Please try again.', 'bad');
          restore();
        }).catch(function () {
          setMsg('Network error — please try again.', 'bad');
          restore();
        });
      });

      [email, phone].forEach(function (el) {
        if (el) el.addEventListener('input', function () { el.classList.remove('err'); });
      });
    });
  })();
</script>
