---
/**
 * /waitlist — the waiting-list holding page.
 *
 * CONTENT PRESERVED, DESIGN REPLACED. Rebuilt on the version-H system; the
 * copy is this page's own, and the form is <WaitlistForm />, whose markup,
 * `js-*` hooks and POST to /api/waitlist are unchanged — so the D1 row and
 * /admin/waitlist behave exactly as before.
 *
 * The photography was Google `aida-public` placeholder URLs, which expire.
 * It is the brand's own assets now.
 *
 * NOTE: this page and /getready are near-duplicates — same offer, same
 * first-100 list, same three "difference" cards, same careers band — and
 * /coming-soon is a third holding page. That predates this work and was
 * carried across rather than resolved; consolidating them is a content
 * decision, not a styling one.
 */
export const prerender = false;

import VersionH from "../layouts/VersionH.astro";
import WaitlistForm from "../components/vh/WaitlistForm.astro";

const PERKS = [
	"Priority booking before appointments open to the public",
	"Founding Member benefits",
	"Preferred pricing on memberships and services",
	"Access to our pre-opening booking event",
];

const DIFFERENCE = [
	{
		n: "01",
		t: "Zero-Gravity Comfort",
		d: "Leave the traditional salon chair behind. Relax in an ergonomic zero-gravity chair designed to support your body while you enjoy your service.",
	},
	{
		n: "02",
		t: "Waterless by Design",
		d: "No shared soaking basins. Our waterless approach is cleaner, more hygienic, and better for long-term nail health.",
	},
	{
		n: "03",
		t: "Beauty That Fits Your Schedule",
		d: "Enjoy multiple services during the same appointment — from nail care and facials to lash lifts and more — so you can make the most of your time.",
	},
];
---

<VersionH
	title="Waiting list"
	description="Enhance what's already beautiful. Cure Và opens December 2026 at Legacy Village, Sugar House — join the waiting list."
	nav="dark"
	current="/coming-soon"
	canonicalPath="/coming-soon"
>

<!-- ══ hero ══════════════════════════════════════════════════════════ -->
<section class="sec sec--first" id="hero" aria-labelledby="wlHeroH">
  <div class="wrap gr-hero">
    <div>
      <span class="eyebrow" data-r="fade">Opening December 2026 · Legacy Village</span>
      <h1 class="h-xl gr-h1" id="wlHeroH" data-r style="--d:60ms">Enhance what&rsquo;s
        <em>Already Beautiful.</em></h1>
      <p class="lede" data-r="fade" style="--d:120ms;margin-top:1.6rem">A private,
        gender-inclusive nail &amp; beauty lounge built around stillness — and the signature
        Zero-Gravity experience.</p>
      <p class="lede" data-r="fade" style="--d:160ms;margin-top:1rem">Opening December 2026 at
        Legacy Village.</p>
      <p class="gr-cta" data-r="fade" style="--d:220ms">
        <a class="btn btn--lg" href="#waitlist" data-mag>Join the waiting list</a>
        <a class="btn btn--outline btn--lg" href="#difference" data-mag>The Cure Và difference</a>
      </p>
    </div>
    <div class="fr fr--tall" data-r="zoom" style="--d:120ms">
      <img src="/img/d-hero-drop.webp" width="1200" height="1800" decoding="async"
        fetchpriority="high" alt="A drop of serum caught in the light">
    </div>
  </div>
</section>

<!-- ══ the waiting list ══════════════════════════════════════════════ -->
<section class="sec on-light" id="waitlist" aria-labelledby="wlH">
  <span class="ix" aria-hidden="true">01</span>
  <div class="wrap gr-wl">
    <div>
      <span class="eyebrow" data-r="fade">Join the Waiting List</span>
      <h2 class="h-lg" id="wlH" data-r style="--d:60ms">Be first <em>through the door</em></h2>
      <p class="lede" data-r="fade" style="--d:120ms;margin-top:1.2rem">Be among the first to
        experience Cure Và. The first 100 subscribers will receive:</p>
      <ul class="gr-perks" data-r="fade" style="--d:160ms">
        {PERKS.map((p) => <li>{p}</li>)}
      </ul>
      <p class="wl-count" data-r="fade" style="--d:200ms">
        Only the first <b class="num">100</b> subscribers get founding perks
      </p>
    </div>

    <article class="card gr-wl-card" data-r style="--d:120ms">
      <div class="card-header">
        <h3 class="h-sm">Reserve your spot</h3>
        <p class="card-description">Founding-member access, before anyone else.</p>
      </div>
      <div class="card-content">
        <WaitlistForm source="waitlist-page" label="Reserve My Spot" />
      </div>
    </article>
  </div>
</section>

<!-- ══ the difference ════════════════════════════════════════════════ -->
<section class="sec" id="difference" aria-labelledby="wlDiffH">
  <span class="ix" aria-hidden="true">02</span>
  <div class="wrap">
    <div class="head">
      <span class="eyebrow" data-r="fade">Why Cure Và</span>
      <h2 class="h-lg" id="wlDiffH" data-r style="--d:60ms">The Cure Và <em>Difference</em></h2>
    </div>
    <div class="gr-grid">
      {DIFFERENCE.map((d, i) => (
        <article class="card gr-card" data-r style={`--d:${60 + i * 70}ms`}>
          <div class="card-header">
            <span class="mono num">{d.n}</span>
            <h3 class="h-sm">{d.t}</h3>
          </div>
          <div class="card-content"><p class="card-description">{d.d}</p></div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ══ careers ═══════════════════════════════════════════════════════ -->
<section class="sec sec--tight on-light" id="careers" aria-labelledby="wlCarH">
  <span class="ix" aria-hidden="true">03</span>
  <div class="wrap gr-careers">
    <div class="fr fr--wide" data-r="zoom"><img src="/img/d-work.webp"
      width="1400" height="2488" decoding="async" loading="lazy"
      alt="A technician at work"></div>
    <div>
      <span class="eyebrow" data-r="fade">Careers at Cure Và</span>
      <h2 class="h-lg" id="wlCarH" data-r style="--d:60ms">Why Grow <em>With Us?</em></h2>
      <p class="lede" data-r="fade" style="--d:120ms;margin-top:1.4rem">We&rsquo;re building the
        founding team of a calmer kind of beauty lounge. Fair pay, a humane pace, and a real say
        in how we do things.</p>
      <p class="gr-cta" data-r="fade" style="--d:180ms">
        <a class="btn btn--lg" href="/recruit/apply" data-mag>Join Our Talent List</a>
        <a class="btn btn--outline btn--lg" href="/recruit" data-mag>See open roles</a>
      </p>
    </div>
  </div>
</section>

</VersionH>

<style is:global>
.wl-count{margin-top:1.6rem;font-size:.82rem;color:hsl(var(--muted-foreground))}
.wl-count b{font-size:1.15rem;font-weight:800;color:hsl(var(--accent))}
</style>
