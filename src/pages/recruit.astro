---
/**
 * /recruit — the careers page.
 *
 * CONTENT PRESERVED, DESIGN REPLACED. Every heading, eyebrow, paragraph,
 * role, bullet and chip below is the copy this page shipped with; what
 * changed is that it is now built from the version-H system — `.sec`
 * shells alternating night and paper, `.head`, `.badge`, `.card`, `.btn`,
 * `[data-r]` reveals — instead of the plaster/walnut design.
 *
 * Three things did change, and none of them silently:
 *
 *   1 · The mosaic and gallery were grey placeholder boxes captioned
 *       "photo · cash wrap & walnut millwork". They are real photography
 *       now, from the brand's own 28 assets. The four material captions
 *       (Walls / Cabinetry / Floors / Green) are content and were kept.
 *   2 · The role accordion was a div + click handler that measured
 *       scrollHeight. It is <details>/<summary> now: same one-open-at-a-time
 *       behaviour, but it works with JavaScript off and announces itself to
 *       a screen reader, which the system's a11y contract requires.
 *   3 · The page's own footer is gone — the layout owns it.
 *
 * Opens on a paper section, so: nav="paper" AND `.sec--first`. Without both
 * the cream wordmark is invisible on paper. See design/version-h/GUIDE.md §1.
 */
export const prerender = false;

import VersionH from "../layouts/VersionH.astro";
import RoleAccordion from "../components/vh/RoleAccordion.astro";
import { OPENING_ISO, OPENING_SEASON } from "../data/opening";

/* Google Jobs reads JobPosting and shows these in a dedicated results
   panel — for a studio hiring four roles in one city that is the highest-
   value structured data on the whole site.

   `validThrough` and `datePosted` are required for the rich result to
   appear at all, and a posting past its validThrough is dropped. These are
   derived from src/data/opening.ts rather than hard-coded, so they do not
   silently expire when the opening moves. */
const POSTED = "2026-08-01";
const VALID_THROUGH = OPENING_ISO;

const JOB_POSTINGS = [
	{ title: "Nail Technician", openings: 2, description: "Natural-nail work in a waterless studio. We're looking for someone who takes pride in their work, enjoys creating meaningful connections with clients, and wants to grow with a team that's redefining the salon experience. Licensed, or eligible for Utah licensure." },
	{ title: "Esthetician", openings: 2, description: "Facials and skin therapy delivered reclined, alongside nail care. We're looking for someone who genuinely enjoys helping others feel confident and values a calm, welcoming environment. Licensed, or eligible for Utah licensure." },
	{ title: "Lash & Brow Specialist", openings: 1, description: "Lash and brow work for a studio that favours natural enhancement. Patient, reliable and detail-oriented, committed to delivering a thoughtful experience. Licensed, or eligible for Utah licensure." },
	{ title: "Cosmetologist", openings: 1, description: "A generalist role in a wellness-focused studio. We're looking for someone who enjoys working with people, embraces learning new techniques, and wants to help shape the culture as we open. Licensed, or eligible for Utah licensure." },
].map((r) => ({
	"@context": "https://schema.org",
	"@type": "JobPosting",
	title: r.title,
	description: r.description,
	datePosted: POSTED,
	validThrough: VALID_THROUGH,
	employmentType: ["FULL_TIME", "PART_TIME"],
	totalJobOpenings: r.openings,
	directApply: true,
	hiringOrganization: {
		"@type": "Organization",
		name: "Cure Và",
		sameAs: "https://curevanails.com",
		logo: "https://curevanails.com/og.jpg",
	},
	jobLocation: {
		"@type": "Place",
		address: {
			"@type": "PostalAddress",
			streetAddress: "Legacy Village",
			addressLocality: "Sugar House",
			addressRegion: "UT",
			addressCountry: "US",
		},
	},
	applicantLocationRequirements: { "@type": "Country", name: "US" },
	url: "https://curevanails.com/recruit/apply",
}));

---

<VersionH
	title="Careers"
	description="Cure Và is building its founding team in Sugar House — nail technicians, estheticians, lash & brow specialists and cosmetologists. Opening Spring 2027."
	nav="paper"
	current="/recruit"
>
	<Fragment slot="head">
		{JOB_POSTINGS.map((job) => (
			<script type="application/ld+json" is:inline set:html={JSON.stringify(job)} />
		))}
	</Fragment>

<!-- ══ hero ══════════════════════════════════════════════════════════ -->
<section class="sec sec--first on-light" id="team" aria-labelledby="teamH">
  <div class="wrap">
    <span class="eyebrow" data-r="fade">Careers at Cure Và · Opening in Sugar House · {OPENING_SEASON}</span>
    <h1 class="h-lg rc-h1" id="teamH" data-r style="--d:60ms">Come build something <em>unique.</em></h1>

    <div class="rc-top">
      <div>
        <p class="lede" data-r="fade" style="--d:120ms">We&rsquo;re creating a different kind of
          nail &amp; skin care spa — a thoughtful place for guests and professionals alike.</p>
        <p class="rc-chips" data-r="fade" style="--d:180ms">
          <span class="badge badge--outline">Nail Technicians</span>
          <span class="badge badge--outline">Estheticians</span>
          <span class="badge badge--outline">Lash &amp; Brow Specialists</span>
          <span class="badge badge--outline">Cosmetologists</span>
        </p>
      </div>
      <div class="rc-cta" data-r="fade" style="--d:240ms">
        <a class="btn btn--lg" href="/recruit/apply" data-mag>Apply now</a>
        <a class="btn btn--outline btn--lg" href="#apply" data-mag>Join our talent list</a>
      </div>
    </div>

    <div class="fr fr--film rc-band" data-r="zoom" style="--d:120ms">
      <img src="/img/d-lounge.webp" width="1600" height="900" decoding="async"
        fetchpriority="high" alt="The studio lounge in daylight">
    </div>
  </div>
</section>

<!-- ══ why we exist ══════════════════════════════════════════════════ -->
<section class="sec" id="why-we-exist" aria-labelledby="whyExistH">
  <span class="ix" aria-hidden="true">01</span>
  <div class="wrap rc-split">
    <div>
      <span class="eyebrow" data-r="fade">Why we exist</span>
      <h2 class="h-lg rc-why-h" id="whyExistH" data-r style="--d:60ms">Built for the people who
        <em>do the work.</em></h2>
    </div>
    <div>
      <p class="rc-statement" data-r style="--d:100ms">During my pregnancy with my first baby, I
        started looking at my work as a nail technician differently. I became more aware of the
        products, dust, sanitation, and overall environment that come with the work.</p>
      <p class="rc-statement" data-r style="--d:140ms">That led to a
        simple idea: <em>create a different kind of nail care spa</em> — one that considers both
        guests and the professionals who care for them.</p>
      <p class="rc-statement" data-r style="--d:180ms">Thoughtful products.
        Natural nail care. High standards of cleanliness and sanitation. Less dust and odor. A more
        comfortable way to work.</p>
    </div>
  </div>
</section>

<!-- ══ why grow with us ══════════════════════════════════════════════ -->
<section class="sec sec--tight on-light" id="why" aria-labelledby="whyH">
  <span class="ix" aria-hidden="true">04</span>
  <div class="wrap">
    <div class="head">
      <span class="eyebrow" data-r="fade">Why grow with us?</span>
      <h2 class="h-lg" id="whyH" data-r style="--d:60ms">A studio built for
        <em>the people in it</em></h2>
    </div>
    <div class="rc-grid">
      <article class="card rc-card" data-r style="--d:60ms">
        <div class="card-header"><h3 class="card-title">Training</h3></div>
        <div class="card-content"><p class="card-description">You&rsquo;ll receive training in the
          unique techniques and service experience that make Cure Và different from a traditional
          salon.</p></div>
      </article>
      <article class="card rc-card" data-r style="--d:130ms">
        <div class="card-header"><h3 class="card-title">A cleaner environment</h3></div>
        <div class="card-content"><p class="card-description">No acrylics, no dip powders, and no
          strong chemical odors. Our focus is on clean products and long-term wellness.</p></div>
      </article>
      <article class="card rc-card" data-r style="--d:200ms">
        <div class="card-header"><h3 class="card-title">Designed with comfort in mind</h3></div>
        <div class="card-content"><p class="card-description">From our specialized zero-gravity
          setup to our thoughtful service model, every detail is designed to create a more
          comfortable experience for both clients and professionals.</p></div>
      </article>
    </div>
  </div>
</section>

<!-- ══ pull quote ════════════════════════════════════════════════════ -->
<section class="sec sec--tight" aria-label="From a founding nail artist">
  <div class="wrap rc-quote">
    <blockquote class="h-md rc-pull" data-r>&ldquo;I&rsquo;ve worked in salons for twelve years.
      This is the first one designed as carefully for the people <em>working</em> in it as the
      people visiting.&rdquo;</blockquote>
    <p class="mono rc-who" data-r="fade" style="--d:120ms">A founding nail artist · On joining early</p>
  </div>
</section>

<!-- ══ open roles ════════════════════════════════════════════════════ -->
<section class="sec on-light" id="roles" aria-labelledby="rolesH">
  <span class="ix" aria-hidden="true">05</span>
  <div class="wrap">
    <div class="head">
      <span class="eyebrow" data-r="fade">Who we&rsquo;re hiring</span>
      <h2 class="h-lg" id="rolesH" data-r style="--d:60ms">Four roles, opening
        <em>{OPENING_SEASON}</em></h2>
      <p class="lede" data-r="fade" style="--d:120ms">Six founding-team openings in Sugar House.
        We&rsquo;d love to connect early.</p>
    </div>

    <RoleAccordion />

    <p class="rc-note" data-r="fade">Not quite your title but this feels like your kind of place?
      Tell us anyway — we&rsquo;d love to meet you.</p>
  </div>
</section>

</VersionH>

<style is:global>
/* ═══ careers — this page's own patterns ════════════════════════════════
   Compositions of the system's primitives. Names no colour: every value
   is a token, so both grounds come free. See design/version-h/GUIDE.md §2.
   ═══════════════════════════════════════════════════════════════════════ */
.rc-h1{margin-top:.9rem;max-width:16ch}
.rc-top{display:grid;gap:2rem;margin-top:2rem}
@media (min-width:960px){
  .rc-top{grid-template-columns:1.05fr .95fr;gap:3rem;align-items:end}
  .rc-cta{justify-content:flex-end}
}
.rc-chips{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.4rem}
.rc-cta{display:flex;flex-wrap:wrap;gap:.8rem}
.rc-band{margin-top:clamp(2.4rem,5vw,3.4rem);box-shadow:var(--sh)}

/* the statement paragraph — Fraunces at reading size, the one place on
   this page where body copy takes the editorial face */
.rc-split{display:grid;gap:1.4rem}
/* The left column is the section's title now, not a lone kicker. Without a
   heading here the eyebrow was the only title-ish thing in the section —
   10.88px sitting above a 36px paragraph, which reads as a caption on top
   of the thing it is meant to introduce. */
.rc-why-h{margin-top:.9rem;max-width:15ch}
@media (min-width:960px){.rc-split{grid-template-columns:.9fr 1.1fr;gap:3.75rem;align-items:start}}
.rc-statement{font-family:Fraunces,"Iowan Old Style",Georgia,serif;font-weight:300;
  font-variation-settings:"opsz" 144,"SOFT" 12,"WONK" 0;
  font-size:clamp(1.5rem,2.7vw,2.25rem);line-height:1.34;letter-spacing:-.02em;
  color:hsl(var(--foreground));text-wrap:pretty}
.rc-statement em{color:hsl(var(--accent))}
/* The three paragraphs are one statement, so the gap is set in `em` — it grows
   with the type instead of pinching as the clamp opens up on a wide screen. */
.rc-statement + .rc-statement{margin-top:.72em}

.rc-grid{display:grid;gap:1rem}
@media (min-width:820px){.rc-grid{grid-template-columns:repeat(3,1fr)}}
/* .card gives ground, corner and ink — elevation belongs to the usage */
.rc-card{align-content:start;box-shadow:inset 0 0 0 1px var(--border-hairline-2),var(--sh)}

.rc-quote{max-width:60rem;margin-inline:auto;text-align:center}
.rc-pull{margin:0;font-family:Fraunces,"Iowan Old Style",Georgia,serif;font-weight:300;
  font-variation-settings:"opsz" 144,"SOFT" 12,"WONK" 0;line-height:1.22;
  letter-spacing:-.028em;text-wrap:balance;color:hsl(var(--foreground))}
.rc-pull em{color:hsl(var(--accent))}
.rc-who{margin-top:1.6rem}

.rc-note{margin-top:2.2rem;font-size:.92rem;color:hsl(var(--muted-foreground))}

</style>

