---
/**
 * /recruit — the careers page.
 *
 * CONTENT PRESERVED, DESIGN REPLACED. Every heading, eyebrow, paragraph,
 * role, bullet and chip below is the copy this page shipped with; what
 * changed is that it is now built from the version-H system — `.sec`
 * shells alternating night and paper, `.head`, `.badge`, `.card`, `.btn`,
 * `[data-r]` reveals — instead of the plaster/walnut design.
 *
 * Three things did change, and none of them silently:
 *
 *   1 · The mosaic and gallery were grey placeholder boxes captioned
 *       "photo · cash wrap & walnut millwork". They are real photography
 *       now, from the brand's own 28 assets. The four material captions
 *       (Walls / Cabinetry / Floors / Green) are content and were kept.
 *   2 · The role accordion was a div + click handler that measured
 *       scrollHeight. It is <details>/<summary> now: same one-open-at-a-time
 *       behaviour, but it works with JavaScript off and announces itself to
 *       a screen reader, which the system's a11y contract requires.
 *   3 · The page's own footer is gone — the layout owns it.
 *
 * Opens on a paper section, so: nav="paper" AND `.sec--first`. Without both
 * the cream wordmark is invisible on paper. See design/version-h/GUIDE.md §1.
 */
export const prerender = false;

import VersionH from "../layouts/VersionH.astro";
import RoleAccordion from "../components/vh/RoleAccordion.astro";

/* Google Jobs reads JobPosting and shows these in a dedicated results
   panel — for a studio hiring four roles in one city that is the highest-
   value structured data on the whole site.

   `validThrough` and `datePosted` are required for the rich result to
   appear at all, and a posting past its validThrough is dropped. These are
   derived from the December opening rather than hard-coded, so they do not
   silently expire. */
const OPENING = new Date("2026-12-01T00:00:00Z");
const POSTED = "2026-08-01";
const VALID_THROUGH = OPENING.toISOString().slice(0, 10);

const JOB_POSTINGS = [
	{ title: "Nail Technician", openings: 2, description: "Natural-nail work in a waterless studio. We're looking for someone who takes pride in their work, enjoys creating meaningful connections with clients, and wants to grow with a team that's redefining the salon experience. Licensed, or eligible for Utah licensure." },
	{ title: "Esthetician", openings: 2, description: "Facials and skin therapy delivered reclined, alongside nail care. We're looking for someone who genuinely enjoys helping others feel confident and values a calm, welcoming environment. Licensed, or eligible for Utah licensure." },
	{ title: "Lash & Brow Specialist", openings: 1, description: "Lash and brow work for a studio that favours natural enhancement. Patient, reliable and detail-oriented, committed to delivering a thoughtful experience. Licensed, or eligible for Utah licensure." },
	{ title: "Cosmetologist", openings: 1, description: "A generalist role in a wellness-focused studio. We're looking for someone who enjoys working with people, embraces learning new techniques, and wants to help shape the culture as we open. Licensed, or eligible for Utah licensure." },
].map((r) => ({
	"@context": "https://schema.org",
	"@type": "JobPosting",
	title: r.title,
	description: r.description,
	datePosted: POSTED,
	validThrough: VALID_THROUGH,
	employmentType: ["FULL_TIME", "PART_TIME"],
	totalJobOpenings: r.openings,
	directApply: true,
	hiringOrganization: {
		"@type": "Organization",
		name: "Cure Và",
		sameAs: "https://curevanails.com",
		logo: "https://curevanails.com/og.jpg",
	},
	jobLocation: {
		"@type": "Place",
		address: {
			"@type": "PostalAddress",
			streetAddress: "Legacy Village",
			addressLocality: "Sugar House",
			addressRegion: "UT",
			addressCountry: "US",
		},
	},
	applicantLocationRequirements: { "@type": "Country", name: "US" },
	url: "https://curevanails.com/recruit/apply",
}));

const MATERIALS = [
	{ n: "01 — Walls", t: "Rounded plaster, 7′ high, with travertine baseboards." },
	{ n: "02 — Cabinetry", t: "Walnut millwork with contrast stitching and rope pulls." },
	{ n: "03 — Floors", t: "Oak wood-tile, laid in a soft basketweave grid." },
	{ n: "04 — Green", t: "Living palms, ferns and monstera throughout." },
];
---

<VersionH
	title="Careers"
	description="Cure Và is building its founding team in Sugar House — nail technicians, estheticians, lash & brow specialists and cosmetologists. Opening December 2026."
	nav="paper"
	current="/recruit"
>
	<Fragment slot="head">
		{JOB_POSTINGS.map((job) => (
			<script type="application/ld+json" is:inline set:html={JSON.stringify(job)} />
		))}
	</Fragment>

<!-- ══ hero ══════════════════════════════════════════════════════════ -->
<section class="sec sec--first on-light" id="team" aria-labelledby="teamH">
  <div class="wrap">
    <span class="eyebrow" data-r="fade">Careers at Cure Và · Opening in Sugar House · December</span>
    <h1 class="h-lg rc-h1" id="teamH" data-r style="--d:60ms">Come make something <em>calm.</em></h1>

    <div class="rc-top">
      <div>
        <p class="lede" data-r="fade" style="--d:120ms">We&rsquo;re creating the kind of beauty
          studio we always wished existed — not just for our clients, but for the professionals
          who care for them.</p>
        <p class="rc-chips" data-r="fade" style="--d:180ms">
          <span class="badge badge--outline">Nail Technicians</span>
          <span class="badge badge--outline">Estheticians</span>
          <span class="badge badge--outline">Lash &amp; Brow Specialists</span>
          <span class="badge badge--outline">Cosmetologists</span>
        </p>
      </div>
      <div class="rc-cta" data-r="fade" style="--d:240ms">
        <a class="btn btn--lg" href="/recruit/apply" data-mag>Apply now</a>
        <a class="btn btn--outline btn--lg" href="#apply" data-mag>Join our talent list</a>
      </div>
    </div>

    <div class="fr fr--film rc-band" data-r="zoom" style="--d:120ms">
      <img src="/img/d-lounge.webp" width="1600" height="900" decoding="async"
        fetchpriority="high" alt="The studio lounge in daylight">
    </div>
  </div>
</section>

<!-- ══ why we exist ══════════════════════════════════════════════════ -->
<section class="sec" id="why-we-exist" aria-labelledby="whyExistH">
  <span class="ix" aria-hidden="true">01</span>
  <div class="wrap rc-split">
    <span class="eyebrow" id="whyExistH" data-r="fade">Why we exist</span>
    <div>
      <p class="rc-statement" data-r style="--d:60ms">Most salons are loud, bright, and built for
        someone else. We&rsquo;re building the opposite — a warm, hushed room of plaster and walnut
        where every guest, of every gender, is genuinely cared for. That kind of calm doesn&rsquo;t
        happen by accident. <em>It&rsquo;s made by people who care about the craft.</em></p>
      <p class="lede" data-r="fade" style="--d:140ms;margin-top:1.6rem">Opening in Sugar House this
        December — we&rsquo;re looking to connect with nail technicians, estheticians, lash &amp;
        brow specialists, and cosmetologists who feel the same.</p>
    </div>
  </div>
</section>

<!-- ══ our craft ═════════════════════════════════════════════════════ -->
<section class="sec sec--tight on-light" id="values" aria-labelledby="valuesH">
  <span class="ix" aria-hidden="true">02</span>
  <div class="wrap">
    <div class="head head--split">
      <div>
        <span class="eyebrow" data-r="fade">Our craft</span>
        <h2 class="h-lg" id="valuesH" data-r style="--d:60ms">Five things we build into
          <em>every&nbsp;day</em></h2>
      </div>
      <p class="lede" data-r="fade" style="--d:120ms">The same principles that shaped our space
        shape how we work together.</p>
    </div>
    <div class="rc-values" data-r="fade">
      <span class="badge badge--outline"><span class="dot" aria-hidden="true"></span>Intentional</span>
      <span class="badge badge--outline"><span class="dot" aria-hidden="true"></span>Peaceful</span>
      <span class="badge badge--outline"><span class="dot" aria-hidden="true"></span>Refreshing</span>
      <span class="badge badge--outline"><span class="dot" aria-hidden="true"></span>Heritage</span>
      <span class="badge badge--outline"><span class="dot" aria-hidden="true"></span>Natural</span>
    </div>
  </div>
</section>

<!-- ══ the space ═════════════════════════════════════════════════════ -->
<section class="sec" id="space" aria-labelledby="spaceH">
  <span class="ix" aria-hidden="true">03</span>
  <div class="wrap">
    <div class="head head--split">
      <div>
        <span class="eyebrow" data-r="fade">The space</span>
        <h2 class="h-lg" id="spaceH" data-r style="--d:60ms">A room made from
          <em>honest&nbsp;materials</em></h2>
      </div>
      <p class="lede" data-r="fade" style="--d:120ms">Rounded plaster walls, walnut cabinetry,
        travertine, oak wood-tile floors, linen curtains, and real greenery. You&rsquo;ll spend
        your days somewhere beautiful.</p>
    </div>

    <div class="rc-mosaic">
      <div class="fr fr--tall rc-m1" data-r="zoom"><img src="/img/d-linen.webp"
        width="1200" height="1798" decoding="async" loading="lazy"
        alt="Linen hanging in daylight"></div>
      <div class="fr fr--wide" data-r="zoom" style="--d:80ms"><img src="/img/g-chair.webp"
        width="1200" height="800" decoding="async" loading="lazy"
        alt="A treatment chair at its station"></div>
      <div class="fr fr--sq" data-r="zoom" style="--d:140ms"><img src="/img/d-leaf2.webp"
        width="1200" height="800" decoding="async" loading="lazy"
        alt="Green leaves against a pale wall"></div>
      <div class="fr fr--wide" data-r="zoom" style="--d:200ms"><img src="/img/d-linen2.webp"
        width="1200" height="931" decoding="async" loading="lazy"
        alt="Folded linen and warm light"></div>
      <div class="fr fr--sq" data-r="zoom" style="--d:260ms"><img src="/img/d-ripple.webp"
        width="1400" height="934" decoding="async" loading="lazy"
        alt="Water rippling in a shallow bowl"></div>
    </div>

    <div class="rc-materials">
      {MATERIALS.map((m, i) => (
        <div data-r="fade" style={`--d:${i * 70}ms`}>
          <div class="mono num">{m.n}</div>
          <p class="rc-mat-t">{m.t}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══ why grow with us ══════════════════════════════════════════════ -->
<section class="sec sec--tight on-light" id="why" aria-labelledby="whyH">
  <span class="ix" aria-hidden="true">04</span>
  <div class="wrap">
    <div class="head">
      <span class="eyebrow" data-r="fade">Why grow with us?</span>
      <h2 class="h-lg" id="whyH" data-r style="--d:60ms">A studio built for
        <em>the people in it</em></h2>
    </div>
    <div class="rc-grid">
      <article class="card rc-card" data-r style="--d:60ms">
        <div class="card-header"><h3 class="card-title">Training</h3></div>
        <div class="card-content"><p class="card-description">You&rsquo;ll receive training in the
          unique techniques and service experience that make Cure Và different from a traditional
          salon.</p></div>
      </article>
      <article class="card rc-card" data-r style="--d:130ms">
        <div class="card-header"><h3 class="card-title">A cleaner environment</h3></div>
        <div class="card-content"><p class="card-description">No acrylics, no dip powders, and no
          strong chemical odors. Our focus is on clean products and long-term wellness.</p></div>
      </article>
      <article class="card rc-card" data-r style="--d:200ms">
        <div class="card-header"><h3 class="card-title">Designed with comfort in mind</h3></div>
        <div class="card-content"><p class="card-description">From our specialized zero-gravity
          setup to our thoughtful service model, every detail is designed to create a more
          comfortable experience for both clients and professionals.</p></div>
      </article>
    </div>
  </div>
</section>

<!-- ══ pull quote ════════════════════════════════════════════════════ -->
<section class="sec sec--tight" aria-label="From a founding nail artist">
  <div class="wrap rc-quote">
    <blockquote class="h-md rc-pull" data-r>&ldquo;I&rsquo;ve worked in salons for twelve years.
      This is the first one designed as carefully for the people <em>working</em> in it as the
      people visiting.&rdquo;</blockquote>
    <p class="mono rc-who" data-r="fade" style="--d:120ms">A founding nail artist · On joining early</p>
  </div>
</section>

<!-- ══ open roles ════════════════════════════════════════════════════ -->
<section class="sec on-light" id="roles" aria-labelledby="rolesH">
  <span class="ix" aria-hidden="true">05</span>
  <div class="wrap">
    <div class="head">
      <span class="eyebrow" data-r="fade">Who we&rsquo;re hiring</span>
      <h2 class="h-lg" id="rolesH" data-r style="--d:60ms">Four roles, opening
        <em>this December</em></h2>
      <p class="lede" data-r="fade" style="--d:120ms">Six founding-team openings in Sugar House.
        We&rsquo;d love to connect early.</p>
    </div>

    <RoleAccordion />

    <p class="rc-note" data-r="fade">Not quite your title but this feels like your kind of place?
      Tell us anyway — we&rsquo;d love to meet you.</p>
  </div>
</section>

<!-- ══ life here ═════════════════════════════════════════════════════ -->
<section class="sec" id="life" aria-labelledby="lifeH">
  <span class="ix" aria-hidden="true">06</span>
  <div class="wrap">
    <div class="head head--split">
      <div>
        <span class="eyebrow" data-r="fade">Life here</span>
        <h2 class="h-lg" id="lifeH" data-r style="--d:60ms">Days at <em>Cure Và</em></h2>
      </div>
      <p class="lede" data-r="fade" style="--d:120ms">Slow mornings, good light, real plants, and
        a team that has each other&rsquo;s backs.</p>
    </div>
    <div class="rc-gallery">
      <div class="fr rc-g-big" data-r="zoom"><img src="/img/d-spa-light.webp"
        width="1600" height="2400" decoding="async" loading="lazy"
        alt="Daylight falling across the treatment room"></div>
      <div class="fr fr--tall" data-r="zoom" style="--d:80ms"><img src="/img/d-work.webp"
        width="1400" height="2488" decoding="async" loading="lazy"
        alt="A technician at work"></div>
      <div class="fr fr--sq" data-r="zoom" style="--d:140ms"><img src="/img/d-leaf3.webp"
        width="1200" height="1800" decoding="async" loading="lazy" alt="A single leaf, close"></div>
      <div class="fr fr--wide" data-r="zoom" style="--d:200ms"><img src="/img/d-rest.webp"
        width="1400" height="933" decoding="async" loading="lazy"
        alt="Hands resting after a treatment"></div>
      <div class="fr fr--sq" data-r="zoom" style="--d:260ms"><img src="/img/d-oil.webp"
        width="1100" height="1375" decoding="async" loading="lazy"
        alt="Treatment oil on a stone tray"></div>
    </div>
  </div>
</section>

<!-- ══ talent list ═══════════════════════════════════════════════════ -->
<section class="sec sec--tight on-light" id="apply" aria-labelledby="applyH">
  <span class="ix" aria-hidden="true">07</span>
  <div class="wrap rc-apply">
    <div>
      <span class="eyebrow" data-r="fade">Join our talent list</span>
      <h2 class="h-lg" id="applyH" data-r style="--d:60ms">Let&rsquo;s <em>connect.</em></h2>
      <p class="lede" data-r="fade" style="--d:120ms">One application covers everything — your
        roles of interest, licensure status, and an optional résumé or portfolio. It takes about
        two minutes, and we&rsquo;ll personally reach out when interview scheduling begins this
        fall.</p>
      <p class="rc-chips rc-chips--stack" data-r="fade" style="--d:180ms">
        <span class="badge badge--outline"><span class="dot" aria-hidden="true"></span>Nail · Esthetics · Lash &amp; Brow · Cosmetology</span>
        <span class="badge badge--outline">Opening December · Sugar House</span>
        <span class="badge badge--outline">We reach out personally</span>
      </p>
    </div>

    <article class="card rc-invite" data-r style="--d:120ms">
      <div class="card-header"><h3 class="h-sm">One form. Two minutes.</h3></div>
      <div class="card-content">
        <p class="card-description">Tell us who you are and the work you love — résumé optional.
          We read every application ourselves.</p>
        <p style="margin-top:1.6rem"><a class="btn btn--lg" href="/recruit/apply" data-mag>Join our
          talent list</a></p>
        <p class="rc-fine">Your data is reviewed only by our hiring team.</p>
      </div>
    </article>
  </div>
</section>

</VersionH>

<style is:global>
/* ═══ careers — this page's own patterns ════════════════════════════════
   Compositions of the system's primitives. Names no colour: every value
   is a token, so both grounds come free. See design/version-h/GUIDE.md §2.
   ═══════════════════════════════════════════════════════════════════════ */
.rc-h1{margin-top:.9rem;max-width:16ch}
.rc-top{display:grid;gap:2rem;margin-top:2rem}
@media (min-width:960px){
  .rc-top{grid-template-columns:1.05fr .95fr;gap:3rem;align-items:end}
  .rc-cta{justify-content:flex-end}
}
.rc-chips{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.4rem}
.rc-chips--stack{flex-direction:column;align-items:flex-start;gap:.7rem;margin-top:1.9rem}
.rc-cta{display:flex;flex-wrap:wrap;gap:.8rem}
.rc-band{margin-top:clamp(2.4rem,5vw,3.4rem);box-shadow:var(--sh)}

/* the statement paragraph — Fraunces at reading size, the one place on
   this page where body copy takes the editorial face */
.rc-split{display:grid;gap:1.4rem}
@media (min-width:960px){.rc-split{grid-template-columns:.9fr 1.1fr;gap:3.75rem;align-items:start}}
.rc-statement{font-family:Fraunces,"Iowan Old Style",Georgia,serif;font-weight:300;
  font-variation-settings:"opsz" 144,"SOFT" 12,"WONK" 0;
  font-size:clamp(1.5rem,2.7vw,2.25rem);line-height:1.34;letter-spacing:-.02em;
  color:hsl(var(--foreground));text-wrap:pretty}
.rc-statement em{color:hsl(var(--accent))}

.rc-values{display:flex;flex-wrap:wrap;gap:.6rem}

/* the mosaic: one tall plate, then four that fill beside it.
   minmax(0,…) is not decoration. A bare `1fr` is `minmax(auto,1fr)`, and a
   frame with an aspect-ratio in a tall row reports a large min-content
   WIDTH — which pushes the track past its share and the whole grid past
   the wrap. That is what was happening: a square in a 333px column
   measured 100px wider than the column and got clipped by `.sec`. */
.rc-mosaic{display:grid;gap:.9rem;grid-template-columns:minmax(0,1fr)}
@media (min-width:720px){
  .rc-mosaic{grid-template-columns:minmax(0,1.4fr) minmax(0,1fr) minmax(0,1fr)}
  .rc-m1{grid-row:span 2}
}
.rc-materials{display:grid;gap:1.4rem;margin-top:1.9rem}
@media (min-width:720px){.rc-materials{grid-template-columns:repeat(4,1fr)}}
.rc-mat-t{margin-top:.5rem;font-size:.92rem;color:hsl(var(--muted-foreground))}

.rc-grid{display:grid;gap:1rem}
@media (min-width:820px){.rc-grid{grid-template-columns:repeat(3,1fr)}}
/* .card gives ground, corner and ink — elevation belongs to the usage */
.rc-card{align-content:start;box-shadow:inset 0 0 0 1px var(--border-hairline-2),var(--sh)}

.rc-quote{max-width:60rem;margin-inline:auto;text-align:center}
.rc-pull{margin:0;font-family:Fraunces,"Iowan Old Style",Georgia,serif;font-weight:300;
  font-variation-settings:"opsz" 144,"SOFT" 12,"WONK" 0;line-height:1.22;
  letter-spacing:-.028em;text-wrap:balance;color:hsl(var(--foreground))}
.rc-pull em{color:hsl(var(--accent))}
.rc-who{margin-top:1.6rem}

.rc-note{margin-top:2.2rem;font-size:.92rem;color:hsl(var(--muted-foreground))}

/* THE GALLERY HAD THE SAME BLOWOUT, worse. `.rc-gallery .fr{height:100%}`
   stretched each frame to its row, and `aspect-ratio` then computed the
   WIDTH from that height — so a square in a 292px column came out 500px
   wide and was clipped. Rows are sized explicitly here and the frames fill
   their cell in both axes, so the aspect-ratio classes no longer drive
   anything inside this grid. */
.rc-gallery{display:grid;gap:.9rem;grid-template-columns:minmax(0,1fr);
  grid-auto-rows:clamp(11rem,42vw,15rem)}
@media (min-width:720px){
  .rc-gallery{grid-template-columns:repeat(4,minmax(0,1fr));
    grid-auto-rows:clamp(9rem,16vw,14rem)}
  .rc-g-big{grid-column:span 2;grid-row:span 2}
}
.rc-gallery .fr{width:100%;height:100%;aspect-ratio:auto}

.rc-apply{display:grid;gap:2rem}
@media (min-width:960px){.rc-apply{grid-template-columns:.85fr 1.15fr;gap:3.75rem;align-items:start}}
.rc-invite{padding:clamp(1.6rem,3vw,2.75rem);box-shadow:inset 0 0 0 1px var(--border-hairline-2),var(--sh)}
.rc-invite .card-header,.rc-invite .card-content{padding:0}
.rc-invite .card-content{padding-top:.9rem}
.rc-invite .card-description{font-size:.98rem;max-width:44ch}
.rc-fine{margin-top:1.1rem;font-size:.78rem;color:hsl(var(--muted-foreground))}
</style>

