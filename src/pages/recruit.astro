---
import RecruitHead from "../components/recruit/RecruitHead.astro";

// Standalone marketing "Careers" landing page for CureVà. It does NOT use
// Base.astro — it renders its own document with the warm "Gallacher
// Collective" recruit theme (see RecruitHead.astro).
//
// Single intake path: every CTA (nav, hero, each open role, and the
// "Join Our Talent List" section below) leads to the full Career Application
// at /recruit/apply — the complete July 2026 "Hiring Form" field set →
// /api/recruit → D1 `job_applications`. The old on-page talent-list mini form
// was removed; its backend (/api/talent + /admin/talent) stays live for any
// previously collected signups.
export const prerender = false;

// Real interior photo for the hero band. Interior/material shots for the
// mosaic and gallery aren't taken yet, so those tiles use labeled `.ph`
// placeholders (drop JPGs into public/assets/ and swap `.ph` → `.tex`).
const HERO_IMG =
	"https://lh3.googleusercontent.com/aida-public/AB6AXuBjl1Zj1hdgTj8rTRs94Koj_TvqoMKEb9Om1bk0BgbUVOqg7ylwc0vAU4Q7aTnAt6lV1Mb0MihUKkGpEaddcRUBv6OSQsqZpt8zUpZddEL_-ez7phvS7XdkQm8uT1b98A8O0Lm7s8mHJKe9ljIkwrmMFlb0gtwVlOE26C1rgCYClojK8ZTWeiZzx5klWsSeni3k8b75w5Yd6vahSqdBMZoW4bvqFjfCVf0gKsGcQrGVKqJ3S66_SHNYxjpBrHkOekXd4dd-FnYza2pp";
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>CureVà — Careers · Nail Technicians &amp; Estheticians</title>
<RecruitHead />
</head>
<body>

<!-- ===================== NAV ===================== -->
<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="/"><span class="mark"></span>CureVà</a>
    <nav class="nav-links">
      <a href="#space">The space</a>
      <a href="#values">Our craft</a>
      <a href="#roles">Open roles</a>
      <a href="#life">Life here</a>
    </nav>
    <div class="nav-right">
      <a class="nav-signin" href="#apply">Join talent list</a>
      <a class="btn btn-primary btn-sm" href="/recruit/apply">Apply now</a>
    </div>
  </div>
</header>

<!-- ===================== HERO ===================== -->
<section class="section" style="padding-top:64px;padding-bottom:0;">
  <div class="wrap">
    <span class="eyebrow">Careers at CureVà · Opening in Sugar House · December</span>
    <h1 style="margin:26px 0 0;max-width:16ch;">Come make something <span class="serif-i">calm.</span></h1>
    <div style="display:grid;grid-template-columns:1.05fr .95fr;gap:48px;align-items:end;margin-top:30px;">
      <div>
        <p class="lede">We're creating the kind of beauty studio we always wished existed — not just for our clients, but for the professionals who care for them.</p>
        <div style="margin-top:22px;display:flex;flex-wrap:wrap;gap:10px;">
          <span class="chip"><span class="dot" style="background:var(--oak);"></span>Nail Technicians</span>
          <span class="chip"><span class="dot" style="background:var(--sage);"></span>Estheticians</span>
          <span class="chip"><span class="dot" style="background:var(--clay);"></span>Lash &amp; Brow Specialists</span>
          <span class="chip"><span class="dot" style="background:var(--walnut);"></span>Cosmetologists</span>
        </div>
      </div>
      <div style="display:flex;gap:14px;flex-wrap:wrap;justify-content:flex-end;">
        <a class="btn btn-primary btn-lg" href="/recruit/apply">Apply now</a>
        <a class="btn btn-outline btn-lg" href="#apply">Join our talent list</a>
      </div>
    </div>
  </div>
  <!-- full-bleed hero image band -->
  <div class="wrap" style="margin-top:52px;">
    <div class="tex" style={`height:440px;border-radius:24px;background-image:url('${HERO_IMG}');box-shadow:var(--sh-md);`}></div>
  </div>
</section>

<!-- ===================== INTRO / MANIFESTO ===================== -->
<section class="section">
  <div class="wrap" style="display:grid;grid-template-columns:.9fr 1.1fr;gap:60px;align-items:start;">
    <div>
      <span class="eyebrow">Why we exist</span>
    </div>
    <div>
      <p style="font-family:var(--serif);font-size:clamp(26px,2.7vw,36px);line-height:1.34;font-weight:400;color:var(--ink);">
        Most salons are loud, bright, and built for someone else. We're building the opposite — a warm, hushed room of plaster and walnut where every guest, of every gender, is genuinely cared for. That kind of calm doesn't happen by accident. <span class="serif-i" style="color:var(--sage-deep);">It's made by people who care about the craft.</span>
      </p>
      <p class="lede" style="margin-top:26px;">Opening in Sugar House this December — we're looking to connect with nail technicians, estheticians, lash &amp; brow specialists, and cosmetologists who feel the same.</p>
    </div>
  </div>
</section>

<!-- ===================== VALUES (the 5 keywords) ===================== -->
<section class="section tight" id="values" style="background:var(--plaster);border-block:1px solid var(--line);">
  <div class="wrap">
    <div class="kicker-row" style="margin-bottom:36px;">
      <div>
        <span class="eyebrow">Our craft</span>
        <h2 style="margin-top:18px;max-width:20ch;">Five things we build into every&nbsp;day</h2>
      </div>
      <p class="muted" style="max-width:32ch;">The same principles that shaped our space shape how we work together.</p>
    </div>
    <div class="values">
      <span class="value-pill"><span class="d" style="background:var(--walnut);"></span>Intentional</span>
      <span class="value-pill"><span class="d" style="background:var(--sage);"></span>Peaceful</span>
      <span class="value-pill"><span class="d" style="background:var(--oak);"></span>Refreshing</span>
      <span class="value-pill"><span class="d" style="background:var(--clay);"></span>Heritage</span>
      <span class="value-pill"><span class="d" style="background:var(--sage-deep);"></span>Natural</span>
    </div>
  </div>
</section>

<!-- ===================== THE SPACE ===================== -->
<section class="section" id="space">
  <div class="wrap">
    <div class="kicker-row">
      <div>
        <span class="eyebrow">The space</span>
        <h2 style="margin-top:18px;max-width:18ch;">A room made from honest&nbsp;materials</h2>
      </div>
      <p class="muted" style="max-width:34ch;">Rounded plaster walls, walnut cabinetry, travertine, oak wood-tile floors, linen curtains, and real greenery. You'll spend your days somewhere beautiful.</p>
    </div>

    <!-- material mosaic -->
    <div style="display:grid;grid-template-columns:1.4fr 1fr 1fr;grid-template-rows:230px 230px;gap:18px;">
      <div class="ph oak" style="grid-row:span 2;border-radius:18px;"><span class="tag">photo · cash wrap &amp; walnut millwork</span></div>
      <div class="ph" style="border-radius:18px;"><span class="tag">photo · rounded plaster wall</span></div>
      <div class="ph sage" style="border-radius:18px;"><span class="tag">photo · greenery</span></div>
      <div class="ph oak" style="border-radius:18px;"><span class="tag">photo · oak wood-tile floor</span></div>
      <div class="ph walnut" style="border-radius:18px;"><span class="tag">photo · Zero Gravity chair station</span></div>
    </div>

    <!-- material captions -->
    <div class="grid g4" style="margin-top:26px;gap:18px;">
      <div><div class="num">01 — Walls</div><p style="margin-top:8px;font-size:15px;color:#5f5646;">Rounded plaster, 7′ high, with travertine baseboards.</p></div>
      <div><div class="num">02 — Cabinetry</div><p style="margin-top:8px;font-size:15px;color:#5f5646;">Walnut millwork with contrast stitching and rope pulls.</p></div>
      <div><div class="num">03 — Floors</div><p style="margin-top:8px;font-size:15px;color:#5f5646;">Oak wood-tile, laid in a soft basketweave grid.</p></div>
      <div><div class="num">04 — Green</div><p style="margin-top:8px;font-size:15px;color:#5f5646;">Living palms, ferns and monstera throughout.</p></div>
    </div>
  </div>
</section>

<!-- ===================== WHY GROW WITH US ===================== -->
<section class="section tight" id="why" style="background:var(--plaster);border-block:1px solid var(--line);">
  <div class="wrap">
    <div class="center" style="margin-bottom:52px;">
      <span class="eyebrow">Why Grow With Us?</span>
      <h2 style="margin-top:18px;">A studio built for the people in it</h2>
    </div>
    <div class="grid g3">
      <div class="benefit">
        <div class="bi"><svg viewBox="0 0 24 24" fill="none" stroke="#5B4632" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5Z"></path><path d="M6 12v5c0 1 2.7 3 6 3s6-2 6-3v-5"></path></svg></div>
        <h3>Training</h3>
        <p class="muted" style="font-size:15px;">You'll receive training in the unique techniques and service experience that make CureVà different from a traditional salon.</p>
      </div>
      <div class="benefit">
        <div class="bi"><svg viewBox="0 0 24 24" fill="none" stroke="#5B4632" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 4 13c0-6 7-9 15-9 0 8-3 15-9 15Z"></path><path d="M4 21c2.5-4 5.5-6.5 10-8"></path></svg></div>
        <h3>A Cleaner Environment</h3>
        <p class="muted" style="font-size:15px;">No acrylics, no dip powders, and no strong chemical odors. Our focus is on clean products and long-term wellness.</p>
      </div>
      <div class="benefit">
        <div class="bi"><svg viewBox="0 0 24 24" fill="none" stroke="#5B4632" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14a4 4 0 0 1 4-4h2l3-5"></path><path d="M4 14h8l4 5"></path><path d="M16 19h4"></path><path d="M5 14v5"></path></svg></div>
        <h3>Designed With Comfort in Mind</h3>
        <p class="muted" style="font-size:15px;">From our specialized zero-gravity setup to our thoughtful service model, every detail is designed to create a more comfortable experience for both clients and professionals.</p>
      </div>
    </div>
  </div>
</section>

<!-- ===================== PULL QUOTE ===================== -->
<section class="section">
  <div class="wrap" style="max-width:960px;text-align:center;">
    <p class="pull">"I've worked in salons for twelve years. This is the first one designed as carefully for the people <span class="serif-i" style="color:var(--sage-deep);">working</span> in it as the people visiting."</p>
    <div class="who" style="justify-content:center;">
      <span class="av">avatar</span>
      <div style="text-align:left;"><div class="nm">A founding nail artist</div><div class="rl">On joining early</div></div>
    </div>
  </div>
</section>

<!-- ===================== OPEN ROLES ===================== -->
<section class="section tight" id="roles">
  <div class="wrap" style="max-width:1000px;">
    <div class="center" style="margin-bottom:44px;">
      <span class="eyebrow">Who we're hiring</span>
      <h2 style="margin-top:18px;">Four roles, opening this December</h2>
      <p class="lede center" style="margin:16px auto 0;">Six founding-team openings in Sugar House. We'd love to connect early.</p>
    </div>

    <div class="js-roles">
      <div class="role">
        <button class="role-head" type="button">
          <span class="role-title">Nail Technician</span>
          <span class="role-meta">2 openings · Full-time / Part-time</span>
          <span class="role-toggle"></span>
        </button>
        <div class="role-body"><div class="role-body-inner">
          <div>
            <p>We're looking for someone who takes pride in their work, enjoys creating meaningful connections with clients, and wants to grow with a team that's redefining the salon experience.</p>
          </div>
          <ul>
            <li>Licensed (or eligible for Utah licensure)</li>
            <li>Kind, dependable, and detail-oriented</li>
            <li>Excited to learn and grow with us</li>
            <li><a href="/recruit/apply" style="color:var(--walnut);font-weight:600;">Apply for this role →</a></li>
          </ul>
        </div></div>
      </div>

      <div class="role">
        <button class="role-head" type="button">
          <span class="role-title">Esthetician</span>
          <span class="role-meta">2 openings · Full-time / Part-time</span>
          <span class="role-toggle"></span>
        </button>
        <div class="role-body"><div class="role-body-inner">
          <div>
            <p>We're looking for someone who genuinely enjoys helping others feel confident, values a calm and welcoming environment, and wants to be part of building something special from the beginning.</p>
          </div>
          <ul>
            <li>Licensed (or eligible for Utah licensure)</li>
            <li>Warm, caring, and professional</li>
            <li>Passionate about continuous learning</li>
            <li><a href="/recruit/apply" style="color:var(--walnut);font-weight:600;">Apply for this role →</a></li>
          </ul>
        </div></div>
      </div>

      <div class="role">
        <button class="role-head" type="button">
          <span class="role-title">Lash &amp; Brow Specialist</span>
          <span class="role-meta">1 opening · Full-time / Part-time</span>
          <span class="role-toggle"></span>
        </button>
        <div class="role-body"><div class="role-body-inner">
          <div>
            <p>We're looking for someone who appreciates natural beauty, pays attention to the little details, and enjoys building lasting relationships with every client.</p>
          </div>
          <ul>
            <li>Licensed (or eligible for Utah licensure)</li>
            <li>Patient, reliable, and detail-oriented</li>
            <li>Committed to delivering a thoughtful experience</li>
            <li><a href="/recruit/apply" style="color:var(--walnut);font-weight:600;">Apply for this role →</a></li>
          </ul>
        </div></div>
      </div>

      <div class="role">
        <button class="role-head" type="button">
          <span class="role-title">Cosmetologist</span>
          <span class="role-meta">1 opening · Full-time / Part-time</span>
          <span class="role-toggle"></span>
        </button>
        <div class="role-body"><div class="role-body-inner">
          <div>
            <p>We're looking for someone who enjoys working with people, embraces learning new techniques, and wants to help shape the culture of a growing wellness-focused studio.</p>
          </div>
          <ul>
            <li>Licensed (or eligible for Utah licensure)</li>
            <li>Positive, adaptable, and team-oriented</li>
            <li>Interested in growing with CURE VÀ</li>
            <li><a href="/recruit/apply" style="color:var(--walnut);font-weight:600;">Apply for this role →</a></li>
          </ul>
        </div></div>
      </div>
    </div>

    <p class="center muted" style="margin-top:34px;font-size:15px;">Not quite your title but this feels like your kind of place? Tell us anyway — we'd love to meet you.</p>
  </div>
</section>

<!-- ===================== LIFE HERE (gallery) ===================== -->
<section class="section" id="life">
  <div class="wrap">
    <div class="kicker-row">
      <div>
        <span class="eyebrow">Life here</span>
        <h2 style="margin-top:18px;">Days at CureVà</h2>
      </div>
      <p class="muted" style="max-width:32ch;">Slow mornings, good light, real plants, and a team that has each other's backs.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:200px;gap:16px;">
      <div class="ph sage" style="grid-column:span 2;grid-row:span 2;border-radius:18px;"><span class="tag">photo · greenery &amp; daylight</span></div>
      <div class="ph oak" style="border-radius:18px;"><span class="tag">photo · team at the cash wrap</span></div>
      <div class="ph" style="border-radius:18px;"><span class="tag">photo · leaf detail</span></div>
      <div class="ph" style="border-radius:18px;"><span class="tag">photo · plaster texture</span></div>
      <div class="ph sage" style="border-radius:18px;"><span class="tag">photo · morning setup</span></div>
      <div class="ph" style="border-radius:18px;"><span class="tag">photo · linen curtains, daylight</span></div>
      <div class="ph oak" style="grid-column:span 2;border-radius:18px;"><span class="tag">photo · walnut cash wrap</span></div>
      <div class="ph walnut" style="border-radius:18px;"><span class="tag">photo · tea break</span></div>
    </div>
  </div>
</section>

<!-- ===================== JOIN OUR TALENT LIST ===================== -->
<section class="section" id="apply" style="background:var(--plaster);border-top:1px solid var(--line);">
  <div class="wrap" style="display:grid;grid-template-columns:.85fr 1.15fr;gap:60px;align-items:start;">
    <div>
      <span class="eyebrow">Join Our Talent List</span>
      <h2 style="margin-top:18px;">Let's connect.</h2>
      <p class="lede" style="margin-top:16px;">One application covers everything — your roles of interest, licensure status, and an optional résumé or portfolio. It takes about two minutes, and we'll personally reach out when interview scheduling begins this fall.</p>
      <div style="margin-top:30px;display:flex;flex-direction:column;gap:14px;">
        <span class="chip"><span class="dot" style="background:var(--sage);"></span>Nail · Esthetics · Lash &amp; Brow · Cosmetology</span>
        <span class="chip"><span class="dot" style="background:var(--oak);"></span>Opening December · Sugar House</span>
        <span class="chip"><span class="dot" style="background:var(--clay);"></span>We reach out personally</span>
      </div>
    </div>

    <div class="card" style="padding:44px;display:flex;flex-direction:column;align-items:flex-start;gap:18px;">
      <h3 style="font-size:26px;">One form. Two minutes.</h3>
      <p class="muted" style="font-size:15.5px;max-width:44ch;">Tell us who you are and the work you love — résumé optional. We read every application ourselves.</p>
      <a class="btn btn-primary btn-lg" href="/recruit/apply" style="margin-top:10px;">Join Our Talent List <span class="arr">↗</span></a>
      <p class="muted" style="font-size:13.5px;">Your data is reviewed only by our hiring team.</p>
    </div>
  </div>
</section>

<!-- ===================== FOOTER ===================== -->
<footer class="footer">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-col">
        <a class="brand" href="/"><span class="mark"></span>CureVà</a>
        <p style="margin:18px 0 0;max-width:34ch;font-size:15px;color:#cabb9f;">A private, gender-inclusive nail &amp; beauty studio built around stillness. Opening December 2026 in Sugar House.</p>
      </div>
      <div class="foot-col">
        <h4>Explore</h4>
        <a class="fl" href="/">Homepage</a>
        <a class="fl" href="/waitlist">Waitlist</a>
        <a class="fl" href="/#services">Services</a>
        <a class="fl" href="/posts">Journal</a>
      </div>
      <div class="foot-col">
        <h4>Join us</h4>
        <a class="fl" href="#roles">Open roles</a>
        <a class="fl" href="#why">Why grow with us</a>
        <a class="fl" href="#life">Life here</a>
        <a class="fl" href="#apply">Talent list</a>
      </div>
      <div class="foot-col">
        <h4>Contact</h4>
        <a class="fl" href="mailto:careers@cureva.co">careers@cureva.co</a>
        <a class="fl" href="mailto:hello@cureva.co">hello@cureva.co</a>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© 2026 CureVà · The Gallacher Collective</span>
      <div class="socials">
        <a class="soc" href="#" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="#e6dccb" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="#e6dccb" stroke="none"></circle></svg></a>
        <a class="soc" href="#" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="#e6dccb"><path d="M16 3c.3 2.2 1.7 3.9 4 4.2v3c-1.5 0-2.9-.4-4-1.1V15a6 6 0 1 1-6-6c.3 0 .7 0 1 .1v3.1a3 3 0 1 0 2 2.8V3h3Z"></path></svg></a>
        <a class="soc" href="#" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="#e6dccb"><path d="M14 8h2V5h-2c-1.7 0-3 1.3-3 3v2H9v3h2v6h3v-6h2.2l.8-3H14V8.5c0-.3.2-.5.5-.5H14Z"></path></svg></a>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  /* CureVà Careers — role accordion + talent-list form (client-side only) */

  /* Role accordion (single-open) */
  document.querySelectorAll('.js-roles').forEach(function (wrap) {
    var roles = wrap.querySelectorAll('.role');
    roles.forEach(function (role) {
      var head = role.querySelector('.role-head');
      var body = role.querySelector('.role-body');
      head.addEventListener('click', function () {
        var open = role.classList.contains('open');
        roles.forEach(function (r) {
          r.classList.remove('open');
          var b = r.querySelector('.role-body');
          if (b) b.style.maxHeight = null;
        });
        if (!open) {
          role.classList.add('open');
          body.style.maxHeight = body.scrollHeight + 'px';
        }
      });
    });
  });

  /* The talent-list section is a CTA to /recruit/apply — no on-page form. */
</script>
</body>
</html>
