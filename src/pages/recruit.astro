		<script is:inline>
			(function () {
				const form = document.getElementById("recruit-form");
				const dropZone = document.getElementById("drop-zone");
				const resumeInput = document.getElementById("resume-input");
				const dropTitle = document.getElementById("drop-title");
				const dropSubtitle = document.getElementById("drop-subtitle");
				const submitBtn = document.getElementById("submit-btn");
				const formError = document.getElementById("form-error");
				const formErrorText = document.getElementById("form-error-text");
				const successPanel = document.getElementById("success-panel");

				// --- Resume drag & drop ---
				["dragenter", "dragover"].forEach((ev) =>
					dropZone.addEventListener(ev, (e) => {
						e.preventDefault();
						dropZone.classList.add("drag-active");
					}),
				);
				["dragleave", "drop"].forEach((ev) =>
					dropZone.addEventListener(ev, (e) => {
						e.preventDefault();
						dropZone.classList.remove("drag-active");
					}),
				);
				dropZone.addEventListener("drop", (e) => {
					if (e.dataTransfer && e.dataTransfer.files.length) {
						resumeInput.files = e.dataTransfer.files;
						showResumeName();
					}
				});
				dropZone.addEventListener("click", () => resumeInput.click());
				resumeInput.addEventListener("change", showResumeName);
				function showResumeName() {
					if (resumeInput.files && resumeInput.files.length) {
						dropTitle.textContent = resumeInput.files[0].name;
						dropSubtitle.textContent = "Click to choose a different file";
						dropZone.classList.remove("field-error");
					}
				}

				// --- Date limits: licence expiry / start date can't be in the past ---
				const _now = new Date();
				const _pad = (n) => String(n).padStart(2, "0");
				const TODAY = `${_now.getFullYear()}-${_pad(_now.getMonth() + 1)}-${_pad(_now.getDate())}`;
				const licExpInput = document.getElementById("license_expiration");
				const startDateInput = document.getElementById("start_date");
				if (licExpInput) licExpInput.min = TODAY;
				if (startDateInput) startDateInput.min = TODAY;

				// --- Validation helpers ---
				function clearErrors() {
					formError.classList.add("hidden");
					form.querySelectorAll(".field-error").forEach((el) => el.classList.remove("field-error"));
					form.querySelectorAll(".error-msg").forEach((el) => el.remove());
				}
				function markGroup(name, message) {
					const group = form.querySelector('[data-group="' + name + '"]');
					if (!group) return;
					if (!group.querySelector(".error-msg")) {
						const p = document.createElement("p");
						p.className = "error-msg";
						p.textContent = message;
						group.appendChild(p);
					}
				}
				function fieldError(id, message) {
					const el = document.getElementById(id);
					if (!el) return;
					el.classList.add("field-error");
					const container = el.closest(".space-y-1") || el.parentElement;
					if (container && !container.querySelector(".error-msg")) {
						const p = document.createElement("p");
						p.className = "error-msg";
						p.textContent = message;
						container.appendChild(p);
					}
				}

				function validate() {
					clearErrors();
					let firstInvalid = null;
					const fail = (el) => {
						if (!firstInvalid) firstInvalid = el;
					};

					const emailRe = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
					const doplRe = /^\d{6,8}-\d{4}$/;
					const validDate = (v) => /^\d{4}-\d{2}-\d{2}$/.test(v) && !Number.isNaN(Date.parse(v));
					const letters = (v) => (v.match(/\p{L}/gu) || []).length;

					// Per-field rules → error message, or null when valid.
					const rules = {
						full_name: (v) => !v ? "Full name is required." : /\d/.test(v) ? "Name can't contain numbers." : letters(v) < 2 ? "Please enter your full name." : null,
						phone: (v) => !v ? "Phone number is required." : /[A-Za-z]/.test(v) ? "Phone number can't contain letters." : v.replace(/\D/g, "").length < 10 ? "Enter a valid phone number (at least 10 digits)." : null,
						email: (v) => !v ? "Email address is required." : !emailRe.test(v) ? "Enter a valid email address." : null,
						city: (v) => !v ? "City of residence is required." : /\d/.test(v) ? "City can't contain numbers." : null,
						dopl_license_number: (v) => !v ? "DOPL license number is required." : !doplRe.test(v) ? "Use the format 1234567-5501." : null,
						license_expiration: (v) => !v ? "License expiration date is required." : !validDate(v) ? "Enter a valid date." : v < TODAY ? "License has expired — enter a current expiration date." : null,
						start_date: (v) => !v ? "Available start date is required." : !validDate(v) ? "Enter a valid date." : v < TODAY ? "Start date can't be in the past." : null,
						english_proficiency: (v) => !v ? "Select your English proficiency." : null,
					};
					for (const id of Object.keys(rules)) {
						const el = document.getElementById(id);
						if (!el) continue;
						const msg = rules[id]((el.value || "").trim());
						if (msg) {
							fieldError(id, msg);
							fail(el);
						}
					}

					// Checkbox / radio groups that require a selection
					const groups = [
						["license_types", "Select at least one license type."],
						["work_authorized", "Please answer the work authorization question."],
						["days_available", "Select at least one available day."],
						["employment_type", "Select an employment type."],
					];
					groups.forEach(([name, msg]) => {
						const checked = form.querySelectorAll('[name="' + name + '"]:checked').length;
						if (checked === 0) {
							markGroup(name, msg);
							fail(form.querySelector('[name="' + name + '"]'));
						}
					});

					// Resume: required + type + size
					const MAX = 10 * 1024 * 1024;
					const resumeRe = /\.(pdf|docx?)$/i;
					if (!resumeInput.files || resumeInput.files.length === 0) {
						dropZone.classList.add("field-error");
						markGroup("resume", "Please attach your resume / CV.");
						fail(dropZone);
					} else {
						const f = resumeInput.files[0];
						if (!resumeRe.test(f.name)) {
							dropZone.classList.add("field-error");
							markGroup("resume", "Resume must be a PDF or Word document (.pdf, .doc, .docx).");
							fail(dropZone);
						} else if (f.size > MAX) {
							dropZone.classList.add("field-error");
							markGroup("resume", "Resume must be 10 MB or smaller.");
							fail(dropZone);
						}
					}

					// License photo (optional): type + size when provided
					const photoInput = document.getElementById("license_photo");
					const photoRe = /\.(png|jpe?g|gif|webp|heic|pdf)$/i;
					if (photoInput && photoInput.files && photoInput.files.length) {
						const f = photoInput.files[0];
						if (!photoRe.test(f.name)) {
							fieldError("license_photo", "License photo must be an image or PDF.");
							fail(photoInput);
						} else if (f.size > MAX) {
							fieldError("license_photo", "License photo must be 10 MB or smaller.");
							fail(photoInput);
						}
					}

					if (firstInvalid) {
						formError.classList.remove("hidden");
						formErrorText.textContent = "Please fix the highlighted fields.";
						firstInvalid.scrollIntoView({ behavior: "smooth", block: "center" });
					}
					return firstInvalid === null;
				}

				// --- Submit via fetch ---
				form.addEventListener("submit", async (e) => {
					e.preventDefault();
					if (!validate()) return;

					submitBtn.disabled = true;
					submitBtn.textContent = "Submitting…";

					try {
						const res = await fetch(form.action, {
							method: "POST",
							body: new FormData(form),
							headers: { Accept: "application/json" },
						});
						const data = await res.json().catch(() => ({}));

						if (res.ok && data.ok) {
							form.classList.add("hidden");
							successPanel.classList.remove("hidden");
							successPanel.scrollIntoView({ behavior: "smooth", block: "center" });
							return;
						}

						// Server-side field errors
						if (data && data.errors) {
							clearErrors();
							Object.keys(data.errors).forEach((key) => {
								const field = form.querySelector('[name="' + key + '"]');
								if (field && field.type !== "checkbox" && field.type !== "radio" && field.type !== "file") {
									field.classList.add("field-error");
								} else {
									markGroup(key, data.errors[key]);
								}
							});
						}
						formError.classList.remove("hidden");
						formErrorText.textContent = data.error || "Something went wrong. Please review your entries and try again.";
					} catch (err) {
						formError.classList.remove("hidden");
						formErrorText.textContent = "Network error. Please check your connection and try again.";
					} finally {
						submitBtn.disabled = false;
						submitBtn.textContent = "Submit Application";
					}
				});
			})();
		</script>
	</body>
