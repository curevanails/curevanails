			function switchTab(id) {
				const data = tabs[id];
				const content = document.getElementById("tab-content");
				const btns = document.querySelectorAll(".tab-btn");

				// Update Active State
				btns.forEach((btn) => {
					btn.classList.remove("bg-primary", "text-on-primary");
					btn.classList.add("bg-surface-container", "text-on-surface-variant");
				});
				const activeBtn = document.getElementById(`tab-${id}`);
				activeBtn.classList.add("bg-primary", "text-on-primary");
				activeBtn.classList.remove("bg-surface-container", "text-on-surface-variant");

				// Fade out
				content.style.opacity = "0";
				content.style.transform = "translateY(10px)";

				setTimeout(() => {
					// Update Content
					document.getElementById("tab-image").src = data.image;
					document.getElementById("tab-image").dataset.alt = data.alt;
					document.getElementById("tab-title").textContent = data.title;

					const list = document.getElementById("tab-list");
					list.innerHTML = data.list
						.map(
							(item) => `
						<li class="flex items-start gap-4">
							<span class="material-symbols-outlined text-primary-container" data-icon="check_circle" style="font-variation-settings: 'FILL' 1;">check_circle</span>
							<div>
								<p class="font-label-md text-on-background">${item.label}</p>
								<p class="font-body-md text-on-surface-variant">${item.body}</p>
							</div>
						</li>
					`
						)
						.join("");

					// Fade in
					content.style.opacity = "1";
					content.style.transform = "translateY(0)";
				}, 300);
			}

			// Add smooth appearance on load
			document.addEventListener("DOMContentLoaded", () => {
				document.body.style.opacity = "0";
				document.body.style.transition = "opacity 0.8s ease-out";
				setTimeout(() => {
					document.body.style.opacity = "1";
				}, 50);
			});

			// Sticky Nav Shadow Logic
			window.addEventListener("scroll", () => {
				const header = document.querySelector("header");
				if (window.scrollY > 50) {
					header.classList.add("py-2");
					header.classList.remove("py-4");
				} else {
					header.classList.add("py-4");
					header.classList.remove("py-2");
				}
			});
