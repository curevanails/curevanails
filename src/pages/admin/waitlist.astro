---
import { env } from "cloudflare:workers";
import {
	WAITLIST_STATUSES,
	WAITLIST_STATUS_LABELS,
	type WaitlistStatus,
	ensureWaitlistSchema,
} from "../../utils/waitlist-db";

// Server-rendered, never cached — shows PII (emails, phones) and is gated by
// the auth check in src/middleware.ts.
export const prerender = false;

interface WaitlistRow {
	id: string;
	created_at: string;
	email: string;
	phone: string;
	source: string;
	status: string | null;
	discount_code: string | null;
	claimed_at: string | null;
	notes: string | null;
}

// Tailwind classes per status (Play CDN ships the full default palette).
const STATUS_CLASS: Record<WaitlistStatus, string> = {
	waiting: "bg-gray-100 text-gray-700 border-gray-300",
	invited: "bg-brand-50 text-brand-600 border-brand-200",
	redeemed: "bg-emerald-100 text-emerald-800 border-emerald-300",
};

function fmtDate(iso: string): string {
	const d = new Date(iso);
	return Number.isNaN(d.getTime())
		? iso
		: d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
}
function fmtTime(iso: string): string {
	const d = new Date(iso);
	return Number.isNaN(d.getTime()) ? "" : d.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" });
}
function statusOf(s: string | null): WaitlistStatus {
	return s && (WAITLIST_STATUSES as readonly string[]).includes(s)
		? (s as WaitlistStatus)
		: "waiting";
}

const db = env.DB as D1Database;
let entries: WaitlistRow[] = [];
let loadError: string | null = null;

try {
	await ensureWaitlistSchema(db);
	const result = await db
		.prepare("SELECT * FROM waitlist ORDER BY datetime(created_at) DESC")
		.all<WaitlistRow>();
	entries = result.results ?? [];
} catch (err) {
	loadError = err instanceof Error ? err.message : String(err);
	console.error("admin: failed to load waitlist", err);
}

const counts = {
	all: entries.length,
	waiting: entries.filter((e) => statusOf(e.status) === "waiting").length,
	invited: entries.filter((e) => statusOf(e.status) === "invited").length,
	redeemed: entries.filter((e) => statusOf(e.status) === "redeemed").length,
};

const STAT_CARDS: { key: string; label: string; ring: string; dot: string; icon: string; tint: string; count: number }[] = [
	{ key: "", label: "All signups", ring: "data-[active=true]:ring-brand-400", dot: "bg-brand-500", icon: "groups", tint: "bg-brand-50 text-brand-500", count: counts.all },
	{ key: "waiting", label: "Waiting", ring: "data-[active=true]:ring-gray-400", dot: "bg-gray-400", icon: "hourglass_empty", tint: "bg-gray-100 text-gray-500", count: counts.waiting },
	{ key: "invited", label: "Invited", ring: "data-[active=true]:ring-brand-400", dot: "bg-brand-500", icon: "send", tint: "bg-brand-50 text-brand-500", count: counts.invited },
	{ key: "redeemed", label: "Redeemed", ring: "data-[active=true]:ring-emerald-400", dot: "bg-emerald-500", icon: "redeem", tint: "bg-emerald-50 text-emerald-600", count: counts.redeemed },
];
---

<!DOCTYPE html>
<html class="light" lang="en">
	<head>
		<meta charset="utf-8" />
		<meta content="width=device-width, initial-scale=1.0" name="viewport" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Waitlist · CureVà Admin</title>
		<script is:inline src="https://cdn.tailwindcss.com?plugins=forms"></script>
		<link
			href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap"
			rel="stylesheet"
		/>
		<link
			href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
			rel="stylesheet"
		/>
		<style is:inline>
			.material-symbols-outlined {
				font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20;
				vertical-align: middle;
			}
			.row-hidden { display: none !important; }
			body { background: #f9fafb; }
			.detail-row > td { background: #f9fafb; }
			tbody.wl-group:hover .wl-main > td { background: #f9fafb; }
			.chev { transition: transform .18s ease; }
			tbody.open .chev { transform: rotate(180deg); }
			/* Sidebar mobile drawer */
			@media (max-width: 1023px) {
				#sidebar { transform: translateX(-100%); }
				#sidebar.open { transform: translateX(0); }
			}
		</style>
		<script is:inline id="tailwind-config">
			tailwind.config = {
				theme: {
					extend: {
						colors: {
							brand: {
								25: "#f2f7ff",
								50: "#ecf3ff",
								100: "#dde9ff",
								200: "#c2d6ff",
								300: "#9cb9ff",
								400: "#7592ff",
								500: "#465fff",
								600: "#3641f5",
								700: "#2a31d8",
								800: "#252dae",
								900: "#262e89",
								950: "#161950",
							},
						},
						fontFamily: { sans: ["Outfit", "sans-serif"] },
						boxShadow: {
							"theme-xs": "0 1px 2px 0 rgba(16,24,40,0.05)",
							"theme-sm": "0 1px 3px 0 rgba(16,24,40,0.1), 0 1px 2px -1px rgba(16,24,40,0.1)",
						},
					},
				},
			};
		</script>
	</head>
	<body class="font-sans text-gray-800">
		<!-- Mobile backdrop -->
		<div id="sidebar-backdrop" class="fixed inset-0 z-40 hidden bg-gray-900/40 lg:hidden"></div>

		<!-- Sidebar -->
		<aside id="sidebar" class="fixed inset-y-0 left-0 z-50 flex w-[290px] flex-col border-r border-gray-200 bg-white px-5 py-6 transition-transform duration-300 ease-in-out lg:translate-x-0">
			<div class="mb-8 flex items-center gap-3 px-1">
				<div class="grid h-10 w-10 place-items-center rounded-xl bg-brand-500 text-lg font-bold text-white">C</div>
				<div>
					<p class="text-sm font-semibold leading-none text-gray-800">CureVà Admin</p>
					<p class="mt-1 text-xs text-gray-500">Recruit &amp; waitlist</p>
				</div>
			</div>

			<p class="mb-3 px-3 text-xs font-medium uppercase tracking-wider text-gray-400">Menu</p>
			<nav class="flex flex-col gap-1">
				<a href="/admin" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-gray-600 transition hover:bg-gray-50 hover:text-gray-900">
					<span class="material-symbols-outlined text-xl">badge</span>Recruit
				</a>
				<a href="/admin/waitlist" aria-current="page" class="flex items-center gap-3 rounded-lg bg-brand-50 px-3 py-2.5 text-sm font-medium text-brand-600">
					<span class="material-symbols-outlined text-xl">group</span>Waitlist
				</a>
				<a href="/admin/email" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-gray-600 transition hover:bg-gray-50 hover:text-gray-900">
					<span class="material-symbols-outlined text-xl">mail</span>Email
				</a>
			</nav>

			<a
				href="/admin/logout"
				class="mt-auto flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-gray-600 transition hover:bg-gray-50 hover:text-gray-900"
			>
				<span class="material-symbols-outlined text-xl">logout</span>
				Sign out
			</a>
		</aside>

		<!-- Content shell -->
		<div class="lg:ml-[290px]">
			<!-- Top header -->
			<header class="sticky top-0 z-30 border-b border-gray-200 bg-white/90 backdrop-blur">
				<div class="flex items-center justify-between gap-4 px-4 py-3.5 sm:px-6">
					<div class="flex items-center gap-3">
						<button id="sidebar-toggle" type="button" aria-label="Toggle menu" class="grid h-10 w-10 place-items-center rounded-lg border border-gray-200 text-gray-600 transition hover:bg-gray-50 lg:hidden">
							<span class="material-symbols-outlined">menu</span>
						</button>
						<div>
							<h1 class="text-lg font-semibold leading-none text-gray-800">Waitlist</h1>
							<p class="mt-1 text-xs text-gray-500">Pre-launch email &amp; phone signups</p>
						</div>
					</div>
					<a
						href="/admin/logout"
						class="inline-flex items-center gap-1.5 rounded-lg border border-gray-200 px-3.5 py-2 text-sm font-medium text-gray-600 shadow-theme-xs transition hover:bg-gray-50 hover:text-gray-900"
					>
						<span class="material-symbols-outlined text-base">logout</span>
						<span class="hidden sm:inline">Sign out</span>
					</a>
				</div>
			</header>

			<main class="mx-auto max-w-[1400px] space-y-5 px-4 py-6 sm:px-6">
			{loadError && (
				<div class="rounded-xl border border-red-200 bg-red-50 text-red-800 px-4 py-3 text-sm">
					<strong>Couldn’t load the waitlist:</strong> {loadError}
				</div>
			)}

			{!loadError && (
				<>
					{/* ---- Stat cards (click to filter) ---- */}
					<div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
						{STAT_CARDS.map((c) => (
							<button
								type="button"
								class={`stat-card group text-left rounded-2xl border border-gray-200 bg-white p-5 shadow-theme-xs transition-all hover:shadow-theme-sm ring-2 ring-transparent ${c.ring}`}
								data-status={c.key}
								data-active={c.key === "" ? "true" : "false"}
							>
								<div class={`grid h-11 w-11 place-items-center rounded-xl ${c.tint}`}>
									<span class="material-symbols-outlined text-xl">{c.icon}</span>
								</div>
								<div class="mt-4 text-2xl font-bold text-gray-800" data-count-for={c.key}>{c.count}</div>
								<div class="mt-0.5 text-sm text-gray-500">{c.label}</div>
							</button>
						))}
					</div>

					{entries.length === 0 ? (
						<div class="rounded-2xl border border-gray-200 bg-white px-6 py-20 text-center text-gray-500 shadow-theme-xs">
							<span class="material-symbols-outlined mb-2 block text-5xl text-brand-500">notifications_active</span>
							<p class="text-lg font-semibold text-gray-700">No waitlist signups yet</p>
							<p class="text-sm">Submissions from the <code class="rounded bg-gray-100 px-1">getready</code> waitlist form will appear here.</p>
						</div>
					) : (
						<div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-theme-xs">
							{/* ---- Toolbar ---- */}
							<div class="border-b border-gray-100 p-4">
								<div class="flex flex-wrap items-center gap-3">
									<div class="relative grow min-w-[220px]">
										<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xl">search</span>
										<input id="f-search" type="search" placeholder="Search email, phone, source…" oninput="applyFilters()"
											class="w-full rounded-lg border border-gray-300 bg-white pl-10 pr-3 py-2.5 text-sm shadow-theme-xs focus:border-brand-300 focus:outline-none focus:ring-3 focus:ring-brand-500/10 transition" />
									</div>
									<button type="button" onclick="resetFilters()"
										class="rounded-lg px-3 py-2.5 text-sm font-medium text-gray-500 hover:text-gray-900 transition">
										Reset
									</button>
									<div class="ml-auto text-sm text-gray-500">
										<span id="result-count" class="font-semibold text-gray-800">{entries.length}</span> of {entries.length}
									</div>
								</div>
							</div>

							{/* ---- Table ---- */}
							<div class="overflow-x-auto">
								<table class="w-full text-sm" id="wl-table">
									<thead>
										<tr class="text-left text-[11px] uppercase tracking-wider text-gray-400 border-b border-gray-100 bg-gray-50">
											<th class="font-medium px-5 py-3.5">Contact</th>
											<th class="font-medium px-5 py-3.5">Source</th>
											<th class="font-medium px-5 py-3.5 whitespace-nowrap">Joined</th>
											<th class="font-medium px-5 py-3.5">Status</th>
											<th class="font-medium px-5 py-3.5 w-10"></th>
										</tr>
									</thead>
									{entries.map((e) => {
										const st = statusOf(e.status);
										const searchBlob = `${e.email} ${e.phone} ${e.source}`.toLowerCase();
										return (
											<tbody
												class="wl-group border-b border-gray-100 last:border-0"
												data-search={searchBlob}
												data-status={st}
												data-date={e.created_at.slice(0, 10)}
											>
												<tr class="wl-main cursor-pointer" onclick="toggleDetail(this)">
													<td class="px-5 py-3.5 align-middle whitespace-nowrap">
														<a class="font-semibold text-gray-800 hover:text-brand-500 inline-flex items-center gap-1.5" href={`mailto:${e.email}`} onclick="event.stopPropagation()">
															<span class="material-symbols-outlined text-base text-gray-400">mail</span>{e.email}
														</a>
														<a class="block text-xs text-gray-500 hover:text-brand-500 mt-0.5" href={`tel:${e.phone.replace(/[^+\d]/g, "")}`} onclick="event.stopPropagation()">{e.phone}</a>
													</td>
													<td class="px-5 py-3.5 align-middle">
														<span class="rounded-md bg-gray-100 text-gray-600 px-2 py-0.5 text-xs">{e.source || "—"}</span>
													</td>
													<td class="px-5 py-3.5 align-middle whitespace-nowrap">
														<div class="text-gray-700">{fmtDate(e.created_at)}</div>
														<div class="text-xs text-gray-400">{fmtTime(e.created_at)}</div>
													</td>
													<td class="px-5 py-3.5 align-middle" onclick="event.stopPropagation()">
														<select
															data-id={e.id}
															onchange="updateStatus(this)"
															class={`status-select rounded-full border px-3 py-1.5 text-xs font-semibold cursor-pointer focus:outline-none ${STATUS_CLASS[st]}`}
														>
															{WAITLIST_STATUSES.map((s) => (
																<option value={s} selected={s === st}>{WAITLIST_STATUS_LABELS[s]}</option>
															))}
														</select>
													</td>
													<td class="px-5 py-3.5 align-middle text-right">
														<span class="material-symbols-outlined chev text-gray-400">expand_more</span>
													</td>
												</tr>

												{/* ---- Expandable detail ---- */}
												<tr class="detail-row hidden">
													<td colspan="5" class="px-5 pb-5 pt-1">
														<div class="grid grid-cols-2 md:grid-cols-4 gap-x-6 gap-y-4">
															<div>
																<div class="text-[11px] uppercase tracking-wider text-gray-400">Discount code</div>
																<div class="font-medium font-mono text-[13px] text-gray-700">{e.discount_code ?? <span class="text-gray-400 font-sans">Not issued</span>}</div>
															</div>
															<div>
																<div class="text-[11px] uppercase tracking-wider text-gray-400">Claimed</div>
																<div class="font-medium text-gray-700">{e.claimed_at ? fmtDate(e.claimed_at) : <span class="text-gray-400">—</span>}</div>
															</div>
															<div class="col-span-2 md:col-span-2">
																<div class="text-[11px] uppercase tracking-wider text-gray-400 mb-1.5">Notes</div>
																<div class="relative">
																	<textarea
																		data-id={e.id}
																		rows="2"
																		placeholder="Add a note…"
																		oninput="autoGrow(this)"
																		onblur="saveNotes(this)"
																		class="note-area w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm resize-none overflow-hidden shadow-theme-xs focus:border-brand-300 focus:outline-none focus:ring-3 focus:ring-brand-500/10 transition"
																	>{e.notes ?? ""}</textarea>
																	<span class="note-saved absolute right-2 bottom-2 text-[11px] text-emerald-600 opacity-0 transition-opacity">Saved ✓</span>
																</div>
															</div>
														</div>
													</td>
												</tr>
											</tbody>
										);
									})}
								</table>
								<div id="no-results" class="hidden px-6 py-14 text-center text-gray-400">
									No signups match the current filters.
								</div>
							</div>
						</div>
					)}
				</>
			)}
			</main>
		</div>

		<script is:inline>
			const STATUS_CLASS = {
				waiting: "bg-gray-100 text-gray-700 border-gray-300",
				invited: "bg-brand-50 text-brand-600 border-brand-200",
				redeemed: "bg-emerald-100 text-emerald-800 border-emerald-300",
			};
			const ALL_STATUS_CLASSES =
				"bg-gray-100 text-gray-700 border-gray-300 bg-brand-50 text-brand-600 border-brand-200 bg-emerald-100 text-emerald-800 border-emerald-300".split(" ");

			let activeStatus = "";

			function val(id) {
				const el = document.getElementById(id);
				return el ? el.value.trim().toLowerCase() : "";
			}

			function applyFilters() {
				const search = val("f-search");
				let shown = 0;
				document.querySelectorAll("#wl-table tbody.wl-group").forEach((g) => {
					const d = g.dataset;
					let ok = true;
					if (search && !d.search.includes(search)) ok = false;
					if (ok && activeStatus && d.status !== activeStatus) ok = false;
					g.classList.toggle("row-hidden", !ok);
					if (ok) shown++;
				});
				const countEl = document.getElementById("result-count");
				if (countEl) countEl.textContent = shown;
				const empty = document.getElementById("no-results");
				if (empty) empty.classList.toggle("hidden", shown !== 0);
			}

			function setStatusFilter(key, cardEl) {
				activeStatus = key;
				document.querySelectorAll(".stat-card").forEach((c) =>
					c.setAttribute("data-active", c === cardEl ? "true" : "false"),
				);
				applyFilters();
			}

			function autoGrow(el) {
				el.style.height = "auto";
				el.style.height = el.scrollHeight + "px";
			}

			function toggleDetail(rowEl) {
				const group = rowEl.closest("tbody");
				const detail = group.querySelector(".detail-row");
				if (!detail) return;
				const open = detail.classList.toggle("hidden");
				group.classList.toggle("open", !open);
				if (!open) {
					const area = detail.querySelector(".note-area");
					if (area) autoGrow(area);
				}
			}

			function recomputeCounts() {
				const c = { "": 0, waiting: 0, invited: 0, redeemed: 0 };
				document.querySelectorAll("#wl-table tbody.wl-group").forEach((g) => {
					c[""]++;
					if (c[g.dataset.status] !== undefined) c[g.dataset.status]++;
				});
				document.querySelectorAll("[data-count-for]").forEach((el) => {
					const k = el.getAttribute("data-count-for");
					if (c[k] !== undefined) el.textContent = c[k];
				});
			}

			function resetFilters() {
				const s = document.getElementById("f-search");
				if (s) s.value = "";
				const firstCard = document.querySelector('.stat-card[data-status=""]');
				setStatusFilter("", firstCard);
			}

			async function updateStatus(sel) {
				const id = sel.dataset.id;
				const status = sel.value;
				ALL_STATUS_CLASSES.forEach((c) => sel.classList.remove(c));
				(STATUS_CLASS[status] || "").split(" ").forEach((c) => c && sel.classList.add(c));
				const group = sel.closest("tbody");
				if (group) group.dataset.status = status;
				try {
					const res = await fetch("/admin/update", {
						method: "POST",
						headers: { "content-type": "application/json" },
						body: JSON.stringify({ entity: "waitlist", id, status }),
					});
					if (!res.ok) throw new Error("save failed");
				} catch (e) {
					alert("Could not save status. Please try again.");
				}
				recomputeCounts();
				applyFilters();
			}

			let noteTimer;
			async function saveNotes(area) {
				const id = area.dataset.id;
				const notes = area.value;
				const saved = area.parentElement.querySelector(".note-saved");
				try {
					const res = await fetch("/admin/update", {
						method: "POST",
						headers: { "content-type": "application/json" },
						body: JSON.stringify({ entity: "waitlist", id, notes }),
					});
					if (!res.ok) throw new Error("save failed");
					if (saved) {
						saved.style.opacity = "1";
						clearTimeout(noteTimer);
						noteTimer = setTimeout(() => (saved.style.opacity = "0"), 1500);
					}
				} catch (e) {
					alert("Could not save note. Please try again.");
				}
			}

			document.querySelectorAll(".stat-card").forEach((card) => {
				card.addEventListener("click", () => setStatusFilter(card.dataset.status, card));
			});

			recomputeCounts();

			// Sidebar mobile drawer
			(function initSidebar() {
				const sidebar = document.getElementById("sidebar");
				const backdrop = document.getElementById("sidebar-backdrop");
				const toggle = document.getElementById("sidebar-toggle");
				const open = () => { sidebar?.classList.add("open"); backdrop?.classList.remove("hidden"); };
				const close = () => { sidebar?.classList.remove("open"); backdrop?.classList.add("hidden"); };
				toggle?.addEventListener("click", () => (sidebar?.classList.contains("open") ? close() : open()));
				backdrop?.addEventListener("click", close);
			})();
		</script>
	</body>
</html>
