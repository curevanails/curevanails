---
/**
 * Admin dashboard (`/admin`, or `/` on the standalone admin Worker).
 *
 * Widgets only — one card per area of the console, each linking to the page
 * that owns it: the recruit pipeline (`/admin/recruit`), the waitlist, and the
 * email dashboard. Nothing here is edited in place; the lists live on their own
 * pages so this stays a fast, glanceable overview.
 */
import { env } from "cloudflare:workers";
import { ensureApplicationsSchema, STATUS_LABELS, APPLICATION_STATUSES } from "../../utils/recruit-db";
import { ensureWaitlistSchema, WAITLIST_STATUSES, WAITLIST_STATUS_LABELS } from "../../utils/waitlist-db";
import {
	EMPTY_STATS,
	loadCampaigns,
	loadMailData,
	loadStats,
	type Stats,
} from "../../utils/email-data";
import { pct } from "../../utils/email-format";
import {
	STATUS_DOT,
	type ApplicationRow,
	fmtDate,
	fullName,
	initials,
	label,
	parseList,
	statusOf,
} from "../../utils/recruit-format";
import { adminNav } from "../../utils/admin-nav";
import AdminLayout from "../../layouts/AdminLayout.astro";

// Server-rendered, never cached — gated by the auth check in src/middleware.ts.
export const prerender = false;

const nav = adminNav();
const db = env.DB as D1Database;

// --- Recruit ---------------------------------------------------------------
let applications: ApplicationRow[] = [];
let recruitError: string | null = null;
try {
	await ensureApplicationsSchema(db);
	applications =
		(await db
			.prepare("SELECT * FROM job_applications ORDER BY datetime(created_at) DESC")
			.all<ApplicationRow>()).results ?? [];
} catch (err) {
	recruitError = err instanceof Error ? err.message : String(err);
	console.error("admin: failed to load applications", err);
}

const pipeline = APPLICATION_STATUSES.map((s) => ({
	key: s,
	label: STATUS_LABELS[s],
	dot: STATUS_DOT[s],
	count: applications.filter((a) => statusOf(a.status) === s).length,
}));
const recentApplications = applications.slice(0, 5);

// "New this week" — the number the studio actually acts on each Monday.
const WEEK_MS = 7 * 24 * 60 * 60 * 1000;
const since = Date.now() - WEEK_MS;
const applicationsThisWeek = applications.filter((a) => {
	const t = new Date(a.created_at).getTime();
	return !Number.isNaN(t) && t >= since;
}).length;

// --- Waitlist --------------------------------------------------------------
interface WaitlistCountRow { status: string | null; email_status: string | null }
let waitlistRows: WaitlistCountRow[] = [];
let waitlistError: string | null = null;
try {
	await ensureWaitlistSchema(db);
	waitlistRows =
		(await db.prepare("SELECT status, email_status FROM waitlist").all<WaitlistCountRow>()).results ?? [];
} catch (err) {
	waitlistError = err instanceof Error ? err.message : String(err);
	console.error("admin: failed to load waitlist counts", err);
}
const waitlistTotal = waitlistRows.length;
const waitlistActive = waitlistRows.filter((r) => r.email_status === "active").length;
const waitlistByStatus = WAITLIST_STATUSES.map((s) => ({
	key: s,
	label: WAITLIST_STATUS_LABELS[s],
	count: waitlistRows.filter((r) => (r.status ?? "waiting") === s).length,
}));

// --- Email -----------------------------------------------------------------
const { data: mail, error: mailError } = await loadMailData(db, async (d) => ({
	stats: await loadStats(d),
	campaigns: await loadCampaigns(d),
}));
const stats: Stats = mail?.stats ?? EMPTY_STATS;
const scheduled = (mail?.campaigns ?? []).filter((c) => c.status === "scheduled");

const CARD = "rounded-2xl border border-gray-200 bg-white shadow-theme-xs";
const KPI_LABEL = "text-sm text-gray-500";
const KPI_VALUE = "mt-4 text-2xl font-bold text-gray-800";

const kpis = [
	{
		label: "Applicants",
		value: applications.length,
		note: applicationsThisWeek > 0 ? `${applicationsThisWeek} in the last 7 days` : "none in the last 7 days",
		icon: "groups",
		tint: "bg-brand-50 text-brand-500",
		href: nav.recruit,
	},
	{
		label: "New applications",
		value: pipeline.find((p) => p.key === "new")?.count ?? 0,
		note: "waiting on a first reply",
		icon: "fiber_new",
		tint: "bg-amber-50 text-amber-600",
		href: nav.recruit,
	},
	{
		label: "Waitlist",
		value: waitlistTotal,
		note: `${waitlistActive} still subscribed`,
		icon: "hourglass_empty",
		tint: "bg-emerald-50 text-emerald-600",
		href: nav.waitlist,
	},
	{
		label: "Emails delivered",
		value: stats.delivered,
		note: stats.delivered > 0 ? `${pct(stats.opened, stats.delivered)} opened` : "no sends yet",
		icon: "mail",
		tint: "bg-brand-50 text-brand-500",
		href: `${nav.mail}/analytics`,
	},
];

const loadErrors = [recruitError, waitlistError, mailError].filter(Boolean) as string[];
---

<AdminLayout title="Dashboard" subtitle="Recruit, waitlist & email at a glance" active="dashboard" logoutHref={nav.logout}>
	{loadErrors.length > 0 && (
		<div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
			<strong>Some widgets couldn’t load:</strong> {loadErrors.join(" · ")}
		</div>
	)}

	{/* ---- KPI row ---- */}
	<div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
		{kpis.map((k) => (
			<a href={k.href} class={`${CARD} block p-5 transition-all hover:shadow-theme-sm`}>
				<div class={`grid h-11 w-11 place-items-center rounded-xl ${k.tint}`}>
					<span class="material-symbols-outlined text-xl">{k.icon}</span>
				</div>
				<div class={KPI_VALUE}>{k.value}</div>
				<div class={`mt-0.5 ${KPI_LABEL}`}>{k.label}</div>
				<div class="mt-1 text-xs text-gray-400">{k.note}</div>
			</a>
		))}
	</div>

	<div class="grid gap-4 lg:grid-cols-2">
		{/* ---- Recruit pipeline ---- */}
		<section class={CARD}>
			<header class="flex items-center justify-between border-b border-gray-100 px-5 py-4">
				<h2 class="font-semibold text-gray-800">Recruit pipeline</h2>
				<a href={nav.recruit} class="text-sm font-medium text-brand-500 hover:text-brand-600">Open recruit →</a>
			</header>
			<div class="grid grid-cols-2 sm:grid-cols-4 divide-gray-100 sm:divide-x">
				{pipeline.map((p) => (
					<div class="px-5 py-4">
						<div class="flex items-center gap-1.5">
							<span class={`h-2 w-2 rounded-full ${p.dot}`}></span>
							<span class="text-xs uppercase tracking-wider text-gray-400">{p.label}</span>
						</div>
						<div class="mt-1.5 text-xl font-bold text-gray-800">{p.count}</div>
					</div>
				))}
			</div>
		</section>

		{/* ---- Waitlist ---- */}
		<section class={CARD}>
			<header class="flex items-center justify-between border-b border-gray-100 px-5 py-4">
				<h2 class="font-semibold text-gray-800">Waitlist</h2>
				<a href={nav.waitlist} class="text-sm font-medium text-brand-500 hover:text-brand-600">Open waitlist →</a>
			</header>
			<div class="grid grid-cols-3 divide-x divide-gray-100">
				{waitlistByStatus.map((w) => (
					<div class="px-5 py-4">
						<div class="text-xs uppercase tracking-wider text-gray-400">{w.label}</div>
						<div class="mt-1.5 text-xl font-bold text-gray-800">{w.count}</div>
					</div>
				))}
			</div>
		</section>
	</div>

	<div class="grid gap-4 lg:grid-cols-2">
		{/* ---- Recent applications ---- */}
		<section class={CARD}>
			<header class="flex items-center justify-between border-b border-gray-100 px-5 py-4">
				<h2 class="font-semibold text-gray-800">Latest applications</h2>
				<a href={nav.recruit} class="text-sm font-medium text-brand-500 hover:text-brand-600">See all →</a>
			</header>
			{recentApplications.length === 0 ? (
				<p class="px-5 py-10 text-center text-sm text-gray-400">No applications yet.</p>
			) : (
				<ul class="divide-y divide-gray-100">
					{recentApplications.map((app) => {
						const name = fullName(app);
						const positions = parseList(app.positions).map(label);
						return (
							<li>
								<a href={nav.recruit} class="flex items-center gap-3 px-5 py-3.5 transition hover:bg-gray-50">
									<span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-brand-50 text-xs font-bold text-brand-500">{initials(name)}</span>
									<span class="min-w-0 flex-1">
										<span class="block truncate font-medium text-gray-800">{name}</span>
										<span class="block truncate text-xs text-gray-500">{positions.length > 0 ? positions.join(", ") : label(app.current_status)}</span>
									</span>
									<span class="shrink-0 text-right">
										<span class="block text-xs text-gray-400">{fmtDate(app.created_at)}</span>
										<span class="mt-0.5 inline-flex items-center gap-1 text-xs text-gray-500">
											<span class={`h-1.5 w-1.5 rounded-full ${STATUS_DOT[statusOf(app.status)]}`}></span>
											{STATUS_LABELS[statusOf(app.status)]}
										</span>
									</span>
								</a>
							</li>
						);
					})}
				</ul>
			)}
		</section>

		{/* ---- Email ---- */}
		<section class={CARD}>
			<header class="flex items-center justify-between border-b border-gray-100 px-5 py-4">
				<h2 class="font-semibold text-gray-800">Email</h2>
				<a href={nav.mail} class="text-sm font-medium text-brand-500 hover:text-brand-600">Open email →</a>
			</header>
			<div class="grid grid-cols-3 divide-x divide-gray-100 border-b border-gray-100">
				<div class="px-5 py-4">
					<div class="text-xs uppercase tracking-wider text-gray-400">Sent</div>
					<div class="mt-1.5 text-xl font-bold text-gray-800">{stats.sent}</div>
				</div>
				<div class="px-5 py-4">
					<div class="text-xs uppercase tracking-wider text-gray-400">Delivered</div>
					<div class="mt-1.5 text-xl font-bold text-gray-800">{stats.delivered}</div>
					<div class="text-xs text-gray-400">{pct(stats.delivered, stats.sent)}</div>
				</div>
				<div class="px-5 py-4">
					<div class="text-xs uppercase tracking-wider text-gray-400">Opened</div>
					<div class="mt-1.5 text-xl font-bold text-gray-800">{stats.opened}</div>
					<div class="text-xs text-gray-400">{pct(stats.opened, stats.delivered)}</div>
				</div>
			</div>
			<div class="flex items-center justify-between px-5 py-4">
				<div class="text-sm text-gray-500">
					{scheduled.length === 0
						? "No campaigns scheduled."
						: `${scheduled.length} campaign${scheduled.length === 1 ? "" : "s"} scheduled.`}
				</div>
				<a href={`${nav.mail}/campaigns`} class="text-sm font-medium text-brand-500 hover:text-brand-600">Campaigns →</a>
			</div>
		</section>
	</div>
</AdminLayout>
