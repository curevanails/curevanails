---
import { env } from "cloudflare:workers";
import {
	SESSION_COOKIE,
	SESSION_TTL_MS,
	createSessionToken,
	resolveSessionSecret,
	verifyCredentials,
	verifySessionToken,
} from "../../utils/admin-auth";
import { isRateLimited, recordAttempt } from "../../utils/rate-limit";

export const prerender = false;

function workerVar(name: string): string | undefined {
	try {
		return (env as unknown as Record<string, string | undefined>)[name];
	} catch {
		return undefined;
	}
}

const password = workerVar("ADMIN_PASSWORD");
// Mirror the middleware: with no password configured the admin area is disabled.
if (!password) {
	return new Response("Not found", { status: 404 });
}
const username = workerVar("ADMIN_USERNAME") || "admin";
const secure = Astro.url.protocol === "https:";
const signingSecret = resolveSessionSecret(password, workerVar("SESSION_SECRET"));

// Already signed in? Skip the form.
const existing = Astro.cookies.get(SESSION_COOKIE)?.value;
if (await verifySessionToken(existing, signingSecret)) {
	return Astro.redirect("/admin", 302);
}

let error = false;
let rateLimited = false;

if (Astro.request.method === "POST") {
	// Throttle brute-force attempts: block once 10 FAILED logins accrue for this
	// IP in 10 min. Only failures count, so a legitimate admin is never locked
	// out by their own successful sign-ins.
	const ip = Astro.request.headers.get("CF-Connecting-IP") ?? "unknown";
	const kv = (env as unknown as { SESSION?: KVNamespace }).SESSION;
	const key = `admin-login:${ip}`;

	if (await isRateLimited(kv, key, 10)) {
		rateLimited = true;
	} else {
		const form = await Astro.request.formData();
		const user = String(form.get("username") ?? "").trim();
		const pass = String(form.get("password") ?? "");

		if (verifyCredentials(user, pass, username, password)) {
			const token = await createSessionToken(signingSecret);
			Astro.cookies.set(SESSION_COOKIE, token, {
				httpOnly: true,
				secure,
				sameSite: "lax",
				path: "/",
				maxAge: Math.floor(SESSION_TTL_MS / 1000),
			});
			return Astro.redirect("/admin", 302);
		}
		await recordAttempt(kv, key, 600);
		error = true;
	}
}
---

<!DOCTYPE html>
<html class="light" lang="en">
	<head>
		<meta charset="utf-8" />
		<meta content="width=device-width, initial-scale=1.0" name="viewport" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Sign in | CureVà Admin</title>
		<script is:inline src="https://cdn.tailwindcss.com"></script>
		<link
			href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap"
			rel="stylesheet"
		/>
		<link
			href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
			rel="stylesheet"
		/>
		<style is:inline>
			.material-symbols-outlined {
				font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
				vertical-align: middle;
			}
			/* TailAdmin dotted-grid backdrop for the brand panel */
			.ta-grid {
				background-image: radial-gradient(rgba(255, 255, 255, 0.16) 1px, transparent 1px);
				background-size: 22px 22px;
			}
		</style>
		<script is:inline id="tailwind-config">
			tailwind.config = {
				theme: {
					extend: {
						colors: {
							brand: {
								25: "#f2f7ff",
								50: "#ecf3ff",
								100: "#dde9ff",
								200: "#c2d6ff",
								300: "#9cb9ff",
								400: "#7592ff",
								500: "#465fff",
								600: "#3641f5",
								700: "#2a31d8",
								800: "#252dae",
								900: "#262e89",
								950: "#161950",
							},
						},
						fontFamily: { sans: ["Outfit", "sans-serif"] },
						boxShadow: {
							"theme-xs": "0 1px 2px 0 rgba(16,24,40,0.05)",
						},
					},
				},
			};
		</script>
	</head>
	<body class="bg-white font-sans text-gray-800 antialiased">
		<div class="relative flex min-h-screen w-full flex-col justify-center sm:p-0 lg:flex-row">
			<!-- Form column -->
			<div class="flex w-full flex-1 flex-col px-4 py-10 sm:px-6 lg:w-1/2">
				<div class="mx-auto flex w-full max-w-md flex-1 flex-col justify-center">
					<div class="mb-8">
						<div class="mb-6 flex items-center gap-3">
							<div class="grid h-11 w-11 place-items-center rounded-xl bg-brand-500 text-lg font-bold text-white">C</div>
							<div>
								<p class="text-base font-semibold text-gray-800 leading-none">CureVà Admin</p>
								<p class="mt-1 text-sm text-gray-500">Recruit dashboard</p>
							</div>
						</div>
						<h1 class="mb-2 text-2xl font-semibold text-gray-800 sm:text-3xl">Sign in</h1>
						<p class="text-sm text-gray-500">Enter your username and password to access the dashboard.</p>
					</div>

					<form method="POST" class="space-y-5" novalidate>
						{(error || rateLimited) && (
							<div class="flex items-center gap-2 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
								<span class="material-symbols-outlined text-base">error</span>
								{rateLimited ? "Too many attempts. Please wait a few minutes and try again." : "Incorrect username or password."}
							</div>
						)}

						<div>
							<label class="mb-1.5 block text-sm font-medium text-gray-700">
								Username <span class="text-brand-500">*</span>
							</label>
							<input
								name="username"
								type="text"
								autocomplete="username"
								value="admin"
								required
								placeholder="admin"
								class="h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 shadow-theme-xs transition placeholder:text-gray-400 focus:border-brand-300 focus:outline-none focus:ring-3 focus:ring-brand-500/10"
							/>
						</div>

						<div>
							<label class="mb-1.5 block text-sm font-medium text-gray-700">
								Password <span class="text-brand-500">*</span>
							</label>
							<div class="relative">
								<input
									id="password"
									name="password"
									type="password"
									autocomplete="current-password"
									required
									autofocus
									placeholder="Enter your password"
									class="h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 pr-11 text-sm text-gray-800 shadow-theme-xs transition placeholder:text-gray-400 focus:border-brand-300 focus:outline-none focus:ring-3 focus:ring-brand-500/10"
								/>
								<button
									type="button"
									id="toggle-pw"
									aria-label="Toggle password visibility"
									class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 transition hover:text-gray-600"
								>
									<span class="material-symbols-outlined text-xl">visibility</span>
								</button>
							</div>
						</div>

						<button
							type="submit"
							class="flex w-full items-center justify-center gap-2 rounded-lg bg-brand-500 px-4 py-3 text-sm font-medium text-white shadow-theme-xs transition hover:bg-brand-600 active:scale-[0.99]"
						>
							<span class="material-symbols-outlined text-base">login</span>
							Sign in
						</button>
					</form>

					<p class="mt-8 text-center text-xs text-gray-400">CureVà Beauty Lounge · Staff only</p>
				</div>
			</div>

			<!-- Brand panel -->
			<div class="relative hidden w-full items-center justify-center bg-brand-950 lg:flex lg:w-1/2">
				<div class="ta-grid absolute inset-0"></div>
				<div class="relative z-10 flex max-w-sm flex-col items-center text-center">
					<div class="mb-6 grid h-20 w-20 place-items-center rounded-2xl bg-white/10 text-4xl font-bold text-white backdrop-blur">C</div>
					<p class="text-2xl font-semibold text-white">CureVà Beauty Lounge</p>
					<p class="mt-3 text-sm leading-relaxed text-white/60">
						Review nail-technician applications, manage your hiring pipeline, and reach out to candidates — all in one place.
					</p>
				</div>
			</div>
		</div>

		<script is:inline>
			document.getElementById("toggle-pw")?.addEventListener("click", () => {
				const input = document.getElementById("password");
				const icon = document.querySelector("#toggle-pw .material-symbols-outlined");
				if (!input) return;
				const hidden = input.type === "password";
				input.type = hidden ? "text" : "password";
				if (icon) icon.textContent = hidden ? "visibility_off" : "visibility";
			});
		</script>
	</body>
</html>
