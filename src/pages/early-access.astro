        <a class="soc" href="#" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="#e6dccb"><path d="M16 3c.3 2.2 1.7 3.9 4 4.2v3c-1.5 0-2.9-.4-4-1.1V15a6 6 0 1 1-6-6c.3 0 .7 0 1 .1v3.1a3 3 0 1 0 2 2.8V3h3Z"/></svg></a>
        <a class="soc" href="#" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="#e6dccb"><path d="M14 8h2V5h-2c-1.7 0-3 1.3-3 3v2H9v3h2v6h3v-6h2.2l.8-3H14V8.5c0-.3.2-.5.5-.5H14Z"/></svg></a>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  (function () {
    'use strict';

    /* Newsletter / waitlist forms */
    function isEmail(v) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test((v || '').trim()); }
    document.querySelectorAll('.js-waitlist').forEach(function (form) {
      var input = form.querySelector('input[type="email"]');
      var msg = form.parentElement.querySelector('.js-msg');
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var val = input ? input.value : '';
        if (!isEmail(val)) {
          if (input) input.classList.add('err');
          if (msg) { msg.textContent = 'Please enter a valid email address.'; msg.className = 'form-msg js-msg bad'; }
          if (input) input.focus();
          return;
        }
        if (input) input.classList.remove('err');
        if (msg) { msg.textContent = "You're on the list — welcome to CureVà. Check your inbox soon."; msg.className = 'form-msg js-msg ok'; }
        form.reset();
        var btn = form.querySelector('button[type="submit"], .btn');
        if (btn) {
          var orig = btn.textContent;
          btn.textContent = 'Added ✓';
          btn.disabled = true;
          setTimeout(function () { btn.textContent = orig; btn.disabled = false; }, 2600);
        }
      });
      if (input) input.addEventListener('input', function () { input.classList.remove('err'); });
    });

    /* Persona tabs */
    document.querySelectorAll('.js-tabs').forEach(function (group) {
      var tabs = group.querySelectorAll('.tab');
      var panels = group.querySelectorAll('.tab-panel');
      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var target = tab.getAttribute('data-tab');
          tabs.forEach(function (t) { t.classList.remove('active'); });
          panels.forEach(function (p) { p.classList.toggle('active', p.getAttribute('data-panel') === target); });
          tab.classList.add('active');
        });
      });
    });
  })();
</script>
</body>
</html>
