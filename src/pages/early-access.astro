/>

<style is:inline>
/* ============================================================
   CureVà — shared design system (WARM INTERIOR MOOD)
   Mood: The Gallacher Collective vision — plaster · travertine
   walnut · oak · linen · greenery.
   ============================================================ */
:root{
  --primary:#C8A97B;        /* oak — dominant warm tint */
  --primary-700:#B08E5E;    /* deep oak — hover */
  --primary-100:#F0E7D6;    /* oak wash */
  --accent:#EAD9AE;         /* warm straw / cream */
  --accent-700:#D9C089;
  --accent-100:#F6EFDC;
  --neutral:#B7BE97;        /* soft sage */
  --neutral-700:#7C8060;
  --neutral-100:#E7EBD6;

  --walnut:#5B4632;         /* walnut — strong CTAs, footer */
  --walnut-700:#4a3826;
  --plaster:#EFE9DE;
  --sage-deep:#5E6247;

  --ink:#2B2419;            /* warm near-black text */
  --muted:#7C7160;          /* muted warm grey-brown */
  --line:#E1D8C8;           /* warm hairline */

  --bg:#F6F1E8;             /* oat page bg */
  --bg-tint:#EFE9DE;        /* plaster */

  --r-lg:22px;
  --r-md:16px;
  --r-sm:12px;
  --r-pill:999px;

  --sh-sm:0 6px 20px -12px rgba(43,36,25,.26);
  --sh-md:0 18px 40px -18px rgba(43,36,25,.30);
  --sh-lg:0 40px 90px -34px rgba(43,36,25,.40);

  --maxw:1200px;
  --serif:'Newsreader',Georgia,'Times New Roman',serif;
  --sans:'DM Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
  --mono:'DM Mono',ui-monospace,SFMono-Regular,Menlo,monospace;
}

*{box-sizing:border-box;}
/* Smooth cross-document page transitions (supporting browsers only) */
@view-transition { navigation: auto; }
@keyframes vt-fade-out { to { opacity: 0; } }
@keyframes vt-fade-in { from { opacity: 0; transform: translateY(10px); } }
::view-transition-old(root){animation:vt-fade-out .18s ease both;}
::view-transition-new(root){animation:vt-fade-in .3s ease both;}
@media (prefers-reduced-motion:reduce){
  ::view-transition-old(root),::view-transition-new(root){animation:none;}
}

html{scroll-behavior:smooth;}
body{
  margin:0;font-family:var(--sans);color:var(--ink);background:var(--bg);
  font-size:17px;line-height:1.65;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;
}
img{max-width:100%;display:block;}
a{color:inherit;text-decoration:none;}
button{font-family:inherit;cursor:pointer;}
::selection{background:#C8A97B;color:#fff;}

h1,h2,h3,h4{margin:0;font-family:var(--serif);line-height:1.08;letter-spacing:-.01em;font-weight:500;text-wrap:balance;}
h1{font-size:clamp(44px,5.4vw,80px);font-weight:400;}
h2{font-size:clamp(32px,3.6vw,50px);font-weight:400;}
h3{font-size:25px;font-weight:500;}
.serif-i{font-style:italic;}
p{margin:0;text-wrap:pretty;}
.muted{color:var(--muted);}

/* Layout */
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 40px;}
.section{padding:100px 0;}
.section.tight{padding:66px 0;}
.eyebrow{display:inline-flex;align-items:center;gap:10px;font-family:var(--mono);font-size:12.5px;font-weight:500;letter-spacing:.2em;text-transform:uppercase;color:var(--sage-deep);}
.eyebrow::before{content:"";width:22px;height:1px;border-radius:2px;background:var(--sage-deep);opacity:.7;}
.center{text-align:center;}
.center .eyebrow::before{display:none;}
.lede{font-size:19px;color:#5f5646;max-width:60ch;}
.center .lede{margin-left:auto;margin-right:auto;}

/* Buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;border-radius:var(--r-pill);padding:14px 28px;font-size:15.5px;font-weight:600;border:1.5px solid transparent;transition:transform .18s ease, box-shadow .2s ease, background .2s ease, border-color .2s ease, color .2s ease;white-space:nowrap;}
.btn:active{transform:translateY(1px);}
.btn-primary{background:var(--walnut);color:#F6F1E8;box-shadow:var(--sh-sm);}
.btn-primary:hover{background:var(--walnut-700);box-shadow:var(--sh-md);}
.btn-outline{background:transparent;color:var(--ink);border-color:#CBBFA9;}
.btn-outline:hover{border-color:var(--walnut);background:#00000006;}
.btn-ghost{background:var(--bg);color:var(--ink);border-color:var(--line);}
.btn-ghost:hover{border-color:var(--walnut);}
.btn-sm{padding:10px 18px;font-size:14.5px;}
.btn-lg{padding:17px 34px;font-size:16.5px;}
.btn .play{width:22px;height:22px;border-radius:50%;background:var(--walnut);display:inline-flex;align-items:center;justify-content:center;}
.btn .play::after{content:"";border-left:7px solid var(--accent);border-top:5px solid transparent;border-bottom:5px solid transparent;margin-left:2px;}

/* Pills / badges */
.badge{display:inline-flex;align-items:center;gap:7px;padding:7px 14px;border-radius:var(--r-pill);font-size:13px;font-weight:600;letter-spacing:.02em;background:var(--accent);color:var(--ink);white-space:nowrap;}
.badge.blue{background:var(--primary);}
.badge.mint{background:var(--neutral);}
.badge.soft{background:#fff;border:1px solid var(--line);color:var(--muted);}

/* Nav */
.nav{position:sticky;top:0;z-index:50;background:rgba(246,241,232,.84);backdrop-filter:saturate(130%) blur(12px);border-bottom:1px solid var(--line);}
.nav-inner{display:flex;align-items:center;gap:32px;height:76px;}
.brand{display:flex;align-items:center;gap:12px;font-family:var(--serif);font-weight:500;font-size:24px;letter-spacing:.01em;}
.brand .mark{width:30px;height:30px;border-radius:50% 50% 50% 7px;background:radial-gradient(120% 120% at 35% 25%, var(--primary) 0%, var(--walnut) 100%);box-shadow:inset 0 0 0 3px rgba(255,255,255,.35);transform:rotate(-8deg);}
.nav-links{display:flex;gap:28px;margin-left:14px;}
.nav-links a{font-size:15px;font-weight:500;color:var(--ink);opacity:.78;transition:opacity .15s;white-space:nowrap;}
.nav-links a:hover{opacity:1;}
.nav-right{margin-left:auto;display:flex;align-items:center;gap:18px;}
.nav-signin{font-size:15px;font-weight:600;white-space:nowrap;}

/* Cards */
.card{background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);padding:30px;box-shadow:var(--sh-sm);transition:transform .2s ease, box-shadow .2s ease;}
.card.hover:hover{transform:translateY(-4px);box-shadow:var(--sh-md);}

/* Grid helpers */
.grid{display:grid;gap:26px;}
.g3{grid-template-columns:repeat(3,1fr);}
.g2{grid-template-columns:repeat(2,1fr);}
.g4{grid-template-columns:repeat(4,1fr);}

/* Placeholder media */
.ph{position:relative;overflow:hidden;border-radius:var(--r-md);background:repeating-linear-gradient(135deg, rgba(43,36,25,.05) 0 12px, rgba(43,36,25,0) 12px 24px),var(--neutral-100);display:flex;align-items:center;justify-content:center;min-height:160px;color:var(--muted);}
.ph.blue{background:repeating-linear-gradient(135deg, rgba(43,36,25,.055) 0 12px, rgba(43,36,25,0) 12px 24px),#E4CDA9;}
.ph.cream{background:repeating-linear-gradient(135deg, rgba(43,36,25,.055) 0 12px, rgba(43,36,25,0) 12px 24px),var(--accent-100);}
.ph.mint{background:repeating-linear-gradient(135deg, rgba(43,36,25,.055) 0 12px, rgba(43,36,25,0) 12px 24px),#CDD0B4;}
.ph .tag{font-family:var(--mono);font-size:12px;letter-spacing:.02em;background:rgba(246,241,232,.86);padding:7px 12px;border-radius:var(--r-pill);border:1px solid rgba(43,36,25,.09);color:#6a5f4d;}

/* Blobs */
.blobs{position:absolute;inset:0;overflow:hidden;z-index:0;pointer-events:none;}
.blob{position:absolute;border-radius:50%;filter:blur(64px);opacity:.4;}
.blob.b1{width:520px;height:520px;background:var(--primary);}
.blob.b2{width:440px;height:440px;background:var(--neutral);}
.blob.b3{width:380px;height:380px;background:var(--accent);}

@keyframes floaty{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}
.float{animation:floaty 6s ease-in-out infinite;}
.float.slow{animation-duration:8s;}
@media (prefers-reduced-motion:reduce){.float{animation:none;}}

/* Forms */
.email-row{display:flex;gap:10px;max-width:480px;}
.email-row.center{margin:0 auto;}
.input{flex:1;min-width:0;border:1.5px solid var(--line);background:#fff;border-radius:var(--r-pill);padding:14px 20px;font-size:16px;color:var(--ink);transition:border-color .15s, box-shadow .15s;}
.input::placeholder{color:#a99e88;}
.input:focus{outline:none;border-color:var(--walnut);box-shadow:0 0 0 4px rgba(91,70,50,.1);}
.input.err{border-color:#C4795E;box-shadow:0 0 0 4px rgba(176,122,91,.14);}
.form-note{font-size:13.5px;color:var(--muted);margin-top:10px;}
.form-msg{font-size:14.5px;font-weight:600;margin-top:12px;min-height:1.2em;}
.form-msg.ok{color:var(--sage-deep);}
.form-msg.bad{color:#B0664C;}

/* Logo bar */
.logos .lg{font-family:var(--serif);font-weight:500;font-size:22px;letter-spacing:.01em;color:#a99a82;filter:grayscale(1);opacity:.75;transition:opacity .2s;}
.logos .lg:hover{opacity:1;}
.logos .lg span{font-style:italic;}

/* Tinted panels */
.panel{border-radius:32px;}
.panel.mint{background:var(--neutral);}
.panel.cream{background:var(--accent);}
.panel.blue{background:var(--primary);}
.panel.bluetint{background:var(--primary-100);}
.panel.minttint{background:var(--neutral-100);}
.panel.walnut{background:var(--walnut);color:#efe6d6;}

/* Tabs */
.tabs{display:flex;flex-wrap:wrap;gap:10px;}
.tab{padding:11px 22px;border-radius:var(--r-pill);border:1.5px solid var(--line);background:#fff;font-size:15px;font-weight:600;color:var(--muted);transition:all .18s;}
.tab:hover{border-color:var(--walnut);color:var(--ink);}
.tab.active{background:var(--walnut);border-color:var(--walnut);color:var(--bg);box-shadow:var(--sh-sm);}
.tab-panel{display:none;}
.tab-panel.active{display:block;animation:fade .3s ease;}
@keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

/* Testimonials */
.quote{font-family:var(--serif);font-size:24px;line-height:1.4;font-weight:400;color:var(--ink);letter-spacing:-.01em;}
.who{display:flex;align-items:center;gap:14px;margin-top:22px;}
.avatar{width:52px;height:52px;border-radius:50%;flex:none;background:repeating-linear-gradient(135deg, rgba(43,36,25,.05) 0 8px, rgba(43,36,25,0) 8px 16px),var(--primary-100);display:flex;align-items:center;justify-content:center;font-size:10px;color:var(--muted);font-family:var(--mono);text-align:center;line-height:1.1;}
.who .nm{font-weight:600;}
.who .rl{font-size:14px;color:var(--muted);}

/* Stats */
.stat .n{font-family:var(--serif);font-size:clamp(34px,3.6vw,52px);font-weight:400;letter-spacing:-.01em;}
.stat .l{font-size:15px;color:#3a3f2c;opacity:.9;margin-top:2px;}

/* Footer */
.footer{background:var(--walnut);color:#e6dccb;padding:76px 0 38px;}
.footer .brand{color:#f4ede0;}
.footer .brand .mark{box-shadow:inset 0 0 0 3px rgba(255,255,255,.2);}
.footer .muted{color:#cabb9f;}
.foot-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:40px;}
.foot-col h4{font-family:var(--mono);font-size:12px;text-transform:uppercase;letter-spacing:.16em;color:#c3b299;margin-bottom:16px;font-weight:500;}
.foot-col a{display:block;font-size:15px;color:#d8ccb7;padding:5px 0;opacity:.85;transition:opacity .15s,color .15s;}
.foot-col a:hover{opacity:1;color:#fff;}
.foot-bottom{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:54px;padding-top:26px;border-top:1px solid rgba(255,255,255,.14);font-size:14px;color:#bcac93;}
.socials{display:flex;gap:10px;}
.soc{width:40px;height:40px;border-radius:50%;border:1px solid rgba(255,255,255,.2);background:transparent;display:flex;align-items:center;justify-content:center;transition:all .18s;}
.soc:hover{background:var(--primary);border-color:var(--primary);transform:translateY(-2px);}
.soc svg{width:18px;height:18px;}

/* Misc */
.kicker-row{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;flex-wrap:wrap;margin-bottom:46px;}
.pillrow{display:flex;flex-wrap:wrap;gap:10px;}
.pill-static{display:inline-flex;align-items:center;gap:8px;padding:9px 16px;border-radius:var(--r-pill);background:#fff;border:1px solid var(--line);font-size:14.5px;font-weight:600;color:#4f4636;}
.pill-static .dot{width:8px;height:8px;border-radius:50%;}

@media (max-width:1040px){
  .g3,.g4{grid-template-columns:repeat(2,1fr);}
  .foot-grid{grid-template-columns:1fr 1fr;}
}
@media (max-width:900px){
  .nav-links{display:none;}
  .nav-signin{display:none;}
  .nav-inner{gap:16px;}
  .nav-right{gap:12px;}
}
@media (max-width:720px){
  .wrap{padding:0 22px;}
  .g2,.g3,.g4{grid-template-columns:1fr;}
}
</style>

<style is:inline>
  /* ---- Homepage-specific editorial layer (warm mood) ---- */
  .hero{position:relative;overflow:hidden;padding:56px 0 72px;}
  .hero .blobs .blob{opacity:.34;}
  .hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:1.02fr .98fr;gap:56px;align-items:center;}
  .hero h1{margin:22px 0 0;font-size:clamp(50px,6.6vw,92px);}
  .hero-sub{font-size:20px;color:#5f5646;max-width:44ch;margin-top:22px;}
  .hero-cta{display:flex;gap:14px;flex-wrap:wrap;margin-top:34px;}
  .hero-figure{position:relative;}
  .hero-figure .shot{position:relative;height:560px;border-radius:26px;overflow:hidden;box-shadow:var(--sh-lg);background:var(--plaster) center/cover;}
  .hero-figure .shot::after{content:"";position:absolute;inset:0;background:linear-gradient(200deg,transparent 55%,rgba(43,36,25,.28));}
  .float-chip{position:absolute;display:flex;align-items:center;gap:12px;background:rgba(246,241,232,.92);backdrop-filter:blur(6px);border:1px solid var(--line);border-radius:18px;padding:14px 18px;box-shadow:var(--sh-md);}
  .float-chip .fc-n{font-family:var(--serif);font-size:32px;line-height:1;}
  .float-chip .fc-l{font-size:13px;color:var(--muted);max-width:12ch;line-height:1.25;}
  .float-chip.tl{top:26px;left:-28px;}
  .float-chip.br{bottom:26px;right:-24px;}

  .marquee{border-block:1px solid var(--line);background:var(--plaster);overflow:hidden;}
  .marquee-track{display:flex;gap:0;white-space:nowrap;width:max-content;animation:slide 34s linear infinite;}
  .marquee-track span{font-family:var(--serif);font-size:26px;color:var(--ink);padding:20px 34px;display:inline-flex;align-items:center;gap:34px;}
  .marquee-track span::after{content:"\25E6";color:var(--primary-700);font-size:18px;}
  @keyframes slide{to{transform:translateX(-50%);}}
  @media (prefers-reduced-motion:reduce){.marquee-track{animation:none;}}

  .manifesto{font-family:var(--serif);font-size:clamp(28px,3.1vw,44px);line-height:1.32;font-weight:400;color:var(--ink);}
  .manifesto .serif-i{color:var(--sage-deep);}

  .svc{display:grid;grid-template-columns:1fr 1fr;gap:0;align-items:stretch;border:1px solid var(--line);border-radius:26px;overflow:hidden;background:#fff;box-shadow:var(--sh-sm);}
  .svc+.svc{margin-top:22px;}
  .svc .svc-media{min-height:360px;position:relative;}
  .svc .svc-body{padding:52px;display:flex;flex-direction:column;justify-content:center;}
  .svc.flip .svc-media{order:2;}
  .svc .num{font-family:var(--mono);font-size:13px;letter-spacing:.16em;color:var(--sage-deep);}
  .svc h3{font-size:34px;margin:14px 0 12px;}
  .svc p{color:#5f5646;max-width:44ch;}
  .svc .svc-tags{display:flex;flex-wrap:wrap;gap:9px;margin-top:22px;}

  .ritual{position:relative;border-radius:30px;overflow:hidden;min-height:520px;display:flex;align-items:flex-end;background:var(--sage-deep) center/cover;box-shadow:var(--sh-lg);}
  .ritual::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(43,36,25,.12) 0%,rgba(43,36,25,.72) 100%);}
  .ritual-body{position:relative;z-index:1;padding:56px;color:#F6F1E8;max-width:640px;}
  .ritual-body h2{color:#F6F1E8;}
  .ritual-body p{color:#e6dccb;font-size:18px;margin-top:14px;max-width:46ch;}

  .stat-band{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;text-align:center;}

  /* Grid items default to min-width:auto — a wide child (the newsletter form)
     can force a 2-col track past the viewport. Let them shrink at any size. */
  .g2 > *,.g3 > *,.g4 > *,.panel{min-width:0;}

  .jr{display:flex;flex-direction:column;overflow:hidden;padding:0;}
  .jr .jr-media{aspect-ratio:16/11;position:relative;}
  .jr .jr-in{padding:26px;display:flex;flex-direction:column;flex:1;}

