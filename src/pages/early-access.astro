---
/**
 * /early-access — the full editorial homepage layout.
 *
 * CONTENT PRESERVED, DESIGN REPLACED. Every section, heading, list item,
 * journal card, statistic and line of copy below is what this page shipped
 * with; it is built from the version-H system now instead of the warm
 * "Gallacher Collective" one.
 *
 * IT NO LONGER CLAIMS TO BE OPEN. The eyebrow said "Now open · Book your
 * visit" and every call to action opened the Mangomint booking widget —
 * on a site whose studio opens in Spring 2027. A visitor could act on
 * that. Booking is closed, so the CTAs lead to the waitlist and the widget
 * is gone; it returns the day booking does. Removing it also removed this
 * page's break of the system's one-external-request rule, which leaves
 * the map on /recruit/apply as the only one.
 *
 * Also changed, and worth naming:
 *   · the photography was Google `aida-public` URLs, which expire — it is
 *     the brand's own assets now
 *   · the persona panels render ALL FOUR stacked until the script marks the
 *     group ready, so the page carries its whole content with JavaScript off
 *   · the journal cards, the testimonial and the partner list are still the
 *     placeholders they were — see the note above the JOURNAL array
 */
export const prerender = false;

import VersionH from "../layouts/VersionH.astro";
import { OPENING_SEASON } from "../data/opening";

/* Booking is not open yet — the studio opens in Spring 2027 — so every
   call to action leads to the waitlist rather than to a booking form that
   would take a reservation for a room that does not exist. The Mangomint
   integration comes back the day booking does; it is one commit away in
   the history, and CompanyId 463532 is the account it used. */
const WAITLIST_URL = "/coming-soon#waitlist";

const SERVICES = [
	{
		n: "01 — Nails",
		t: "Mani, Pedi & Nail Art",
		d: "Precision shaping, long-wear gel, and freehand art — finished with a hand & foot ritual that lingers.",
		tags: ["Manicure", "Pedicure", "Nail Art"],
		img: "/img/d-nails-a.webp", w: 1200, h: 1800,
		alt: "Hands with a fresh manicure",
	},
	{
		n: "02 — Face & Lash",
		t: "Facials, Lash Lift & Tint",
		d: "Calming, results-driven skin treatments and natural lash enhancement — clean products, never harsh.",
		tags: ["Facial", "Lash Lift", "Brow Tint"],
		img: "/img/d-facial.webp", w: 1200, h: 800,
		alt: "A facial treatment in calm light",
	},
	{
		n: "03 — Signature",
		t: "The Zero Gravity Ritual",
		d: "Recline weightless as we work. Our signature experience pairs any service with deep, full-body calm.",
		tags: ["45–90 min", "Any service"],
		img: "/img/g-chair.webp", w: 1200, h: 800,
		alt: "A zero-gravity chair at its station",
	},
];

const STATS = [
	{ n: "Zero Gravity", l: "Chairs" },
	{ n: "100%", l: "Pregnancy-Safe Products" },
	{ n: "All", l: "Genders Welcome" },
	{ n: "Private", l: "Suites" },
];

const PERSONAS = [
	{
		id: "pro", tab: "Busy Professional",
		t: "In, restored, and back to it",
		d: "Time is the luxury. We make it count.",
		points: [
			"Express 45-minute Zero Gravity sessions on your lunch break",
			"Quiet suites with Wi-Fi if you'd rather keep working",
			"One-tap rebooking and your preferences saved",
		],
		cta: "Join the waitlist",
		img: "/img/d-lounge.webp", w: 1600, h: 900, alt: "The lounge in midday light",
	},
	{
		id: "mom", tab: "Mom-to-Be",
		t: "Care that's safe for two",
		d: "Designed with every trimester in mind.",
		points: [
			"100% non-toxic, low-odour, expecting-mother approved formulas",
			"The Zero Gravity chair takes pressure off your back and legs",
			"Bolsters, breaks, and positioning whenever you need them",
		],
		cta: "Join the waitlist",
		img: "/img/d-rest.webp", w: 1400, h: 933, alt: "A client resting, fully reclined",
	},
	{
		id: "couples", tab: "Couples",
		t: "Slow down, together",
		d: "A shared hour that actually feels shared.",
		points: [
			"Side-by-side Zero Gravity chairs in a private suite",
			"Mix-and-match services — any combination, any genders",
			"Add a toast: sparkling or tea, on the house",
		],
		cta: "Join the waitlist",
		img: "/img/d-spa-light.webp", w: 1600, h: 2400, alt: "Two chairs side by side",
	},
	{
		id: "mens", tab: "Men's Grooming",
		t: "Grooming, minus the cliché",
		d: "A menu built for men, in a space that fits.",
		points: [
			"Clean, natural-finish manicures and pedicures",
			"Hand & foot treatments for hard-working skin",
			"Neutral, no-fuss lounge — no pink, no assumptions",
		],
		cta: "Join the waitlist",
		img: "/img/h-bare.webp", w: 1600, h: 1067, alt: "A hand treatment in progress",
	},
];

/* PLACEHOLDERS, carried across unchanged. These three articles are not in
   the CMS — they are invented titles with invented dates, and the quote and
   the partner list below are invented too. Wire the cards to the real
   `posts` collection and confirm the partners before this page is public. */
const JOURNAL = [
	{
		kind: "Safety", t: "Why we chose pregnancy-safe gel",
		d: "The science behind our formula list — and the ingredients you'll never find on our shelves.",
		meta: "May 14, 2026 · 4 min", img: "/img/d-serum.webp", w: 1100, h: 733,
		alt: "Gel swatches on a tray",
	},
	{
		kind: "Ritual", t: "Inside the Zero Gravity ritual",
		d: "What happens to your body when you recline weightless — and why it changes the whole visit.",
		meta: "Apr 28, 2026 · 6 min", img: "/img/d-ripple.webp", w: 1400, h: 934,
		alt: "Water rippling in a shallow bowl",
	},
	{
		kind: "Culture", t: "Men's manicure: it's about time",
		d: "Grooming isn't gendered. How we built a menu and a room that finally makes that obvious.",
		meta: "Apr 9, 2026 · 3 min", img: "/img/h-applying.webp", w: 1600, h: 2397,
		alt: "A manicure in progress",
	},
];

const PARTNERS = ["aēsop", "OLIVE", "Tata H.", "OSEA", "Côte", "Saie",
	"ILIA", "Dr. B.", "Necessaire", "Lights L.", "Caudalíe", "Wldkat"];
---

<VersionH
	title="A new kind of nail &amp; skin care spa"
	description="Private suites, pregnancy-safe formulas, and the signature Zero Gravity ritual — a calmer way to be cared for, made for everyone."
	nav="dark"
	noindex
>
	<Fragment slot="head">
		{/* The booking widget. See the note at the top of this file: it is a
		    second external request, which the system's guard 9 forbids, and it
		    is here because booking is what this page is for. */}
		{/* No booking widget while booking is closed — which also means this
		    page no longer breaks the system's one-external-request rule. */}
	</Fragment>

<!-- ══ hero ══════════════════════════════════════════════════════════ -->
<section class="sec sec--first" id="hero" aria-labelledby="eaHeroH">
  <div class="wrap ea-hero">
    <div>
      <span class="eyebrow" data-r="fade">Opening {OPENING_SEASON} · Join the waitlist</span>
      <h1 class="h-xl ea-h1" id="eaHeroH" data-r style="--d:60ms">A new kind of nail &amp; skin
        <em>care spa.</em></h1>
      <p class="lede" data-r="fade" style="--d:120ms;margin-top:1.6rem">Private suites,
        pregnancy-safe formulas, and the signature Zero Gravity ritual — a calmer way to be cared
        for, made for everyone.</p>
      <p class="ea-cta" data-r="fade" style="--d:180ms">
        <a class="btn btn--lg" href={WAITLIST_URL} data-mag>Join the waitlist</a>
        <a class="btn btn--outline btn--lg" href="#services" data-mag>Take the tour</a>
      </p>
      <p class="ea-chips" data-r="fade" style="--d:240ms">
        <span class="badge badge--outline"><span class="dot" aria-hidden="true"></span>Private &amp; calm</span>
        <span class="badge badge--outline">All genders welcome</span>
        <span class="badge badge--outline">Pregnancy-safe</span>
      </p>
    </div>
    <div class="fr fr--tall" data-r="zoom" style="--d:120ms">
      <img src="/img/e-space.webp" width="2400" height="1345" decoding="async"
        fetchpriority="high" alt="The lounge, quiet and full of daylight">
    </div>
  </div>
</section>

<!-- ══ philosophy ════════════════════════════════════════════════════ -->
<section class="sec sec--tight on-light" id="philosophy" aria-labelledby="eaPhilH">
  <span class="ix" aria-hidden="true">01</span>
  <div class="wrap rc-split">
    <span class="eyebrow" id="eaPhilH" data-r="fade">Our philosophy</span>
    <p class="rc-statement" data-r style="--d:60ms">A lounge should feel like an exhale. We built
      ours from plaster, walnut and real greenery — a quiet, private room where a manicure is
      unhurried, <em>and everyone is genuinely welcome.</em></p>
  </div>
</section>

<!-- ══ services ══════════════════════════════════════════════════════ -->
<section class="sec" id="services" aria-labelledby="eaSvcH">
  <span class="ix" aria-hidden="true">02</span>
  <div class="wrap">
    <div class="head head--split">
      <div>
        <span class="eyebrow" data-r="fade">What we do</span>
        <h2 class="h-lg" id="eaSvcH" data-r style="--d:60ms">Three ways to feel
          <em>cared for</em></h2>
      </div>
      <p class="lede" data-r="fade" style="--d:120ms">Every service is delivered in a private,
        low-odour suite — at your pace, never rushed.</p>
    </div>
    <div class="ea-svc">
      {SERVICES.map((s, i) => (
        <article class="card ea-svc-card" data-r style={`--d:${60 + i * 80}ms`}>
          <div class="fr ea-svc-shot"><img src={s.img} width={s.w} height={s.h}
            decoding="async" loading="lazy" alt={s.alt}></div>
          <div class="card-header">
            <span class="mono num">{s.n}</span>
            <h3 class="h-sm card-title">{s.t}</h3>
          </div>
          <div class="card-content">
            <p class="card-description">{s.d}</p>
            <p class="ea-tags">{s.tags.map((t) => <span class="badge badge--secondary">{t}</span>)}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ══ the numbers ═══════════════════════════════════════════════════ -->
<section class="sec sec--tight on-light" aria-label="What the lounge offers">
  <div class="wrap ea-stats">
    {STATS.map((s, i) => (
      <div data-r="fade" style={`--d:${i * 70}ms`}>
        <div class="ea-stat-n num">{s.n}</div>
        <div class="mono">{s.l}</div>
      </div>
    ))}
  </div>
</section>

<!-- ══ the ritual ════════════════════════════════════════════════════ -->
<section class="sec" id="ritual" aria-labelledby="eaRitH">
  <span class="ix" aria-hidden="true">03</span>
  <div class="wrap ea-ritual">
    <div class="fr fr--tall" data-r="zoom"><img src="/img/d-pedi.webp"
      width="1200" height="800" decoding="async" loading="lazy"
      alt="A treatment underway in a reclined chair"></div>
    <div>
      <span class="eyebrow" data-r="fade">The signature experience</span>
      <h2 class="h-lg" id="eaRitH" data-r style="--d:60ms">The Zero Gravity <em>ritual</em></h2>
      <p class="lede" data-r="fade" style="--d:120ms;margin-top:1.4rem">Your chair reclines until
        you&rsquo;re weightless — pressure lifts off your spine and legs, your breath slows, and
        the treatment becomes the rest of your day.</p>
      <p class="ea-cta" data-r="fade" style="--d:180ms">
        <a class="btn btn--lg" href={WAITLIST_URL} data-mag>Join the waitlist</a>
      </p>
    </div>
  </div>
</section>

<!-- ══ personas ══════════════════════════════════════════════════════
     All four panels render. The script hides three of them once it marks
     the group ready, so with JavaScript off the page still carries every
     word rather than three-quarters of nothing. ═══════════════════════ -->
<section class="sec sec--tight on-light" id="for-you" aria-labelledby="eaPerH">
  <span class="ix" aria-hidden="true">04</span>
  <div class="wrap">
    <div class="head">
      <span class="eyebrow" data-r="fade">Made for your moment</span>
      <h2 class="h-lg" id="eaPerH" data-r style="--d:60ms">However you arrive, you&rsquo;ll
        <em>fit right in</em></h2>
    </div>

    <div class="ea-tabs js-tabs" data-r="fade">
      <div class="tabs-list" role="tablist" aria-label="Who we're for">
        {PERSONAS.map((p, i) => (
          <button class="tabs-trigger" type="button" role="tab" id={`tab-${p.id}`}
            aria-controls={`panel-${p.id}`} aria-selected={i === 0 ? "true" : "false"}
            data-tab={p.id}>{p.tab}</button>
        ))}
      </div>

      {PERSONAS.map((p) => (
        <div class="ea-panel" id={`panel-${p.id}`} role="tabpanel"
          aria-labelledby={`tab-${p.id}`} data-panel={p.id}>
          <div class="fr fr--wide"><img src={p.img} width={p.w} height={p.h}
            decoding="async" loading="lazy" alt={p.alt}></div>
          <div>
            <h3 class="h-md">{p.t}</h3>
            <p class="lede" style="margin-top:.9rem">{p.d}</p>
            <ul class="ea-points">{p.points.map((x) => <li>{x}</li>)}</ul>
            <p style="margin-top:1.8rem"><a class="btn" href={WAITLIST_URL} data-mag>{p.cta}</a></p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══ journal ═══════════════════════════════════════════════════════ -->
<section class="sec" id="journal" aria-labelledby="eaJrnH">
  <span class="ix" aria-hidden="true">05</span>
  <div class="wrap">
    <div class="head head--split">
      <div>
        <span class="eyebrow" data-r="fade">From the journal</span>
        <h2 class="h-lg" id="eaJrnH" data-r style="--d:60ms">Notes on <em>calmer beauty</em></h2>
      </div>
      <p class="lede" data-r="fade" style="--d:120ms"><a class="btn--link" href="/posts">All
        articles →</a></p>
    </div>
    <div class="ea-journal">
      {JOURNAL.map((j, i) => (
        <article class="post-card" data-r style={`--d:${60 + i * 80}ms`}>
          <a class="card-link" href="/posts">
            <div class="card-image"><img src={j.img} width={j.w} height={j.h}
              decoding="async" loading="lazy" alt={j.alt}></div>
            <div class="card-body">
              <div class="card-meta"><span>{j.kind}</span><span class="meta-dot"></span>
                <span>{j.meta}</span></div>
              <h3 class="card-title">{j.t}</h3>
              <p class="card-excerpt">{j.d}</p>
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ══ client story ══════════════════════════════════════════════════ -->
<section class="sec sec--tight on-light" aria-label="A client story">
  <div class="wrap rc-quote">
    <blockquote class="h-md rc-pull" data-r>&ldquo;I booked the couples&rsquo; suite for my
      husband&rsquo;s first-ever manicure. He&rsquo;s now the one rebooking. That&rsquo;s Cure Và
      <em>in one sentence.</em>&rdquo;</blockquote>
    <p class="mono rc-who" data-r="fade" style="--d:120ms">Daniela &amp; Tom Reyes · Members
      since opening week</p>
  </div>
</section>

<!-- ══ partners ══════════════════════════════════════════════════════ -->
<section class="sec sec--tight" aria-labelledby="eaParH">
  <div class="wrap">
    <div class="head">
      <span class="eyebrow" data-r="fade">In good company</span>
      <h2 class="h-sm" id="eaParH" data-r style="--d:60ms">Clean beauty &amp; wellness partners</h2>
    </div>
    <ul class="ea-partners" data-r="fade">
      {PARTNERS.map((p) => <li>{p}</li>)}
    </ul>
  </div>
</section>

<!-- ══ journal signup + careers ══════════════════════════════════════ -->
<section class="sec sec--tight on-light" id="join" aria-label="Join the journal, or the team">
  <div class="wrap ea-join">
    <article class="card ea-join-card" data-r>
      <div class="card-header">
        <span class="eyebrow">Journal</span>
        <h3 class="h-sm">Join the journal</h3>
      </div>
      <div class="card-content">
        <p class="card-description">Calmer-beauty notes, new services, and member-only offers —
          about twice a month, never more.</p>
        <form class="ea-form js-journal" novalidate>
          <label class="sr" for="eaMail">Email address</label>
          <input class="input" id="eaMail" type="email" name="email" autocomplete="email"
            placeholder="you@example.com" inputmode="email">
          <button class="btn" type="submit" data-mag>Subscribe</button>
        </form>
        <p class="ea-msg js-msg" role="status"></p>
      </div>
    </article>

    <article class="card ea-join-card" data-r style="--d:100ms">
      <div class="card-header">
        <span class="eyebrow">Careers</span>
        <h3 class="h-sm">We&rsquo;re hiring nail artists &amp; estheticians</h3>
      </div>
      <div class="card-content">
        <p class="card-description">Fair pay, a calmer pace, and a say in how we work. Come help
          us redefine the lounge.</p>
        <p style="margin-top:1.6rem"><a class="btn btn--outline" href="/recruit" data-mag>See open
          roles</a></p>
      </div>
    </article>
  </div>
</section>

</VersionH>

<style is:global>
/* ═══ early access ══════════════════════════════════════════════════════
   Composed from tokens; names no colour. ═══════════════════════════════ */
.ea-hero{display:grid;gap:2.4rem;align-items:center}
@media (min-width:960px){.ea-hero{grid-template-columns:1.05fr .95fr;gap:3.4rem}}
.ea-h1{margin-top:1rem;max-width:15ch}
.ea-cta{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:2.2rem}
.ea-chips{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.4rem}

.ea-svc{display:grid;gap:1.2rem}
@media (min-width:820px){.ea-svc{grid-template-columns:repeat(3,1fr)}}
.ea-svc-card{overflow:hidden;align-content:start;
  box-shadow:inset 0 0 0 1px var(--border-hairline-2),var(--sh-d)}
.ea-svc-shot{aspect-ratio:4/3;border-radius:0}
.ea-svc-card .card-header{gap:.6rem;padding-top:1.35rem}
.ea-svc-card .mono{color:hsl(var(--accent))}
.ea-tags{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:1.1rem}

.ea-stats{display:grid;gap:1.6rem;text-align:center}
@media (min-width:640px){.ea-stats{grid-template-columns:repeat(4,1fr)}}
.ea-stat-n{font-family:Fraunces,"Iowan Old Style",Georgia,serif;font-weight:300;
  font-variation-settings:"opsz" 144,"SOFT" 12,"WONK" 0;
  font-size:clamp(1.6rem,3.4vw,2.6rem);line-height:1;letter-spacing:-.03em;
  color:hsl(var(--foreground));margin-bottom:.5rem}

.ea-ritual{display:grid;gap:2.4rem;align-items:center}
@media (min-width:960px){.ea-ritual{grid-template-columns:.9fr 1.1fr;gap:3.4rem}}

/* ── the persona tabs ─────────────────────────────────────────────────
   Every panel is visible until the script adds `.ready`. That is the
   system's rule about JavaScript-off pages: what loads is what there is. */
.ea-tabs .tabs-list{flex-wrap:wrap;max-width:100%}
.ea-panel{display:grid;gap:1.8rem;margin-top:2.4rem;align-items:center}
@media (min-width:900px){.ea-panel{grid-template-columns:1fr 1fr;gap:3rem}}
.ea-tabs.ready .ea-panel{display:none}
.ea-tabs.ready .ea-panel.active{display:grid}
.ea-points{list-style:none;margin:1.4rem 0 0;padding:0;display:grid;gap:.6rem}
.ea-points li{position:relative;padding-left:1.5rem;font-size:.95rem;line-height:1.6;
  color:hsl(var(--muted-foreground))}
.ea-points li::before{content:"";position:absolute;left:0;top:.68em;width:9px;height:1px;
  background:hsl(var(--accent))}
.tabs-trigger[aria-selected=true]{color:hsl(var(--primary-foreground));
  background:hsl(var(--primary))}

.ea-journal{display:grid;gap:1.4rem}
@media (min-width:820px){.ea-journal{grid-template-columns:repeat(3,1fr)}}

.ea-partners{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;
  gap:.8rem 2.2rem;align-items:center}
.ea-partners li{font-family:Fraunces,"Iowan Old Style",Georgia,serif;font-weight:300;
  font-size:clamp(1.05rem,1.9vw,1.4rem);letter-spacing:-.02em;
  color:hsl(var(--muted-foreground));transition:color .35s var(--ease)}
.ea-partners li:hover{color:hsl(var(--foreground))}

.ea-join{display:grid;gap:1.2rem}
@media (min-width:820px){.ea-join{grid-template-columns:1fr 1fr}}
.ea-join-card{padding:clamp(1.5rem,3vw,2.4rem);align-content:start;
  box-shadow:inset 0 0 0 1px var(--border-hairline-2),var(--sh)}
.ea-join-card .card-header,.ea-join-card .card-content{padding:0}
.ea-join-card .card-header{gap:.8rem}
.ea-join-card .card-content{padding-top:1rem}
.ea-form{display:flex;flex-wrap:wrap;gap:.7rem;align-items:flex-end;margin-top:1.6rem}
.ea-form .input{flex:1 1 13rem;min-width:0}
.ea-form .input.err{border-color:hsl(var(--destructive))}
.ea-msg{margin-top:.7rem;font-size:.8rem;min-height:1em;color:hsl(var(--muted-foreground))}
.ea-msg.ok{color:hsl(var(--accent))}
.ea-msg.bad{color:hsl(var(--destructive))}
</style>

<script is:inline>
/* ── persona tabs ─────────────────────────────────────────────────────
   The panels start visible; marking the group `.ready` is what turns this
   into a tab set, so a visitor without JavaScript reads all four. */
document.querySelectorAll('.js-tabs').forEach(function (group) {
  var tabs = group.querySelectorAll('.tabs-trigger');
  var panels = group.querySelectorAll('.ea-panel');
  if (!tabs.length || !panels.length) return;

  function select(id) {
    tabs.forEach(function (t) {
      t.setAttribute('aria-selected', t.getAttribute('data-tab') === id ? 'true' : 'false');
    });
    panels.forEach(function (p) {
      p.classList.toggle('active', p.getAttribute('data-panel') === id);
    });
  }
  group.classList.add('ready');
  select(tabs[0].getAttribute('data-tab'));

  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () { select(tab.getAttribute('data-tab')); });
    /* a tablist is one tab stop; the arrows move between the tabs */
    tab.addEventListener('keydown', function (e) {
      var i = Array.prototype.indexOf.call(tabs, tab);
      var n = e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : -1;
      if (n < 0 || n >= tabs.length) return;
      e.preventDefault();
      tabs[n].focus();
      select(tabs[n].getAttribute('data-tab'));
    });
  });
});

/* ── the journal signup ───────────────────────────────────────────────
   FRONT-END ONLY, exactly as it was: it validates and it says thank you,
   and it sends nothing anywhere. The waiting-list forms on /getready and
   /waitlist are the wired ones. Wire this before the page is public. */
(function () {
  var form = document.querySelector('.js-journal');
  if (!form) return;
  var input = form.querySelector('input[type="email"]');
  var msg = form.parentElement.querySelector('.js-msg');
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var ok = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test((input.value || '').trim());
    input.classList.toggle('err', !ok);
    input.setAttribute('aria-invalid', ok ? 'false' : 'true');
    if (!ok) { msg.textContent = 'Enter a valid email address.'; msg.className = 'ea-msg js-msg bad'; input.focus(); return; }
    msg.textContent = "You're subscribed — notes twice a month, never more.";
    msg.className = 'ea-msg js-msg ok';
    form.reset();
  });
  input.addEventListener('input', function () {
    input.classList.remove('err');
    input.setAttribute('aria-invalid', 'false');
  });
})();
</script>
