---
/**
 * Recruit alerts — the emails sent to the studio when a candidate applies
 * (`/mail/recruit-alerts`). Recipients are configured on the Settings page.
 */
import { env } from "cloudflare:workers";
import { listRecruitEmails, recruitKind } from "../../utils/recruit-notifications";
import { RECRUIT_NOTIFY_TO, getSetting, parseRecipients } from "../../utils/app-settings";
import { PILL, fmtTs } from "../../utils/email-format";
import { emailNav } from "../../utils/email-nav";
import MailLayout from "../../layouts/MailLayout.astro";
import EmptyState from "../../components/mail/EmptyState.astro";

// Server-rendered, auth-gated by src/middleware.ts (path listed as protected).
export const prerender = false;

const nav = emailNav();

const db = env.DB as D1Database;
const rows = await listRecruitEmails(db, 200);
const recipients = parseRecipients(await getSetting(db, RECRUIT_NOTIFY_TO));

const badge: Record<string, string> = {
	sent: "bg-success-50 text-success-700 dark:bg-success-500/15 dark:text-success-500",
	delivered: "bg-success-50 text-success-700 dark:bg-success-500/15 dark:text-success-500",
	failed: "bg-error-50 text-error-700 dark:bg-error-500/15 dark:text-error-500",
	queued: "bg-warning-50 text-warning-700 dark:bg-warning-500/15 dark:text-orange-400",
};
---

<MailLayout
	title="Recruit alerts"
	description="Emails sent when a candidate submits the application form."
	active="mail-recruit-alerts"
>
	<a
		slot="actions"
		href={nav.settings}
		class="inline-flex items-center gap-1.5 rounded-lg border border-gray-200 px-4 py-2.5 text-sm font-medium text-gray-600 hover:border-brand-300 hover:text-brand-500 dark:border-gray-700 dark:text-gray-300 dark:hover:border-brand-700 dark:hover:text-brand-400 transition"
	>
		<span class="material-symbols-outlined text-base">settings</span><span class="hidden sm:inline">Recipients</span>
	</a>

	<div class="rounded-2xl border border-gray-200 bg-white px-5 py-4 text-sm text-gray-600 shadow-theme-xs dark:border-gray-800 dark:bg-white/[0.03] dark:text-gray-300">
		{recipients.length === 0 ? (
			<span>⚠️ No recipients configured — alerts are <strong>off</strong>. Add an address in <a href={nav.settings} class="font-medium text-brand-500 hover:text-brand-600">Settings</a>.</span>
		) : (
			<span>Currently notifying: <strong class="text-gray-800 dark:text-white/90">{recipients.join(", ")}</strong></span>
		)}
	</div>

	{rows.length === 0 ? (
		<EmptyState icon="badge" title="No alerts yet." hint="They'll appear here as candidates apply." />
	) : (
		<section class="bg-white rounded-2xl border border-gray-200 shadow-theme-xs dark:bg-white/[0.03] dark:border-gray-800">
			<header class="px-5 py-4 border-b border-gray-200 dark:border-gray-800 flex items-center justify-between">
				<div class="flex items-center gap-2.5">
					<span class="grid h-9 w-9 place-items-center rounded-lg bg-brand-50 text-brand-500 dark:bg-brand-500/15 dark:text-brand-400">
						<span class="material-symbols-outlined">badge</span>
					</span>
					<h2 class="font-semibold text-gray-800 dark:text-white/90">Alerts sent
						<span class="ml-1 text-xs font-medium text-gray-400 dark:text-gray-500">({rows.length})</span>
					</h2>
				</div>
				<span class="text-xs text-gray-400 dark:text-gray-500">times in Mountain Time (Utah)</span>
			</header>
			<div class="overflow-x-auto nice-scroll">
				<table class="w-full text-sm">
					<thead class="text-xs font-semibold uppercase text-gray-500 bg-gray-50 border-b border-gray-200 dark:bg-white/[0.02] dark:border-gray-800 dark:text-gray-400">
						<tr>
							<th class="px-5 py-3 text-left">Candidate</th>
							<th class="px-5 py-3 text-left">Type</th>
							<th class="px-5 py-3 text-left whitespace-nowrap">When</th>
							<th class="px-5 py-3 text-left">Sent to</th>
							<th class="px-5 py-3 text-left">Status</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-gray-200 dark:divide-gray-800">
						{rows.map((r) => (
							<tr class="hover:bg-gray-50/70 dark:hover:bg-white/[0.02] transition">
								<td class="px-5 py-3.5 font-medium text-gray-800 dark:text-white/90">{r.candidate_name ?? "—"}</td>
								<td class="px-5 py-3.5 whitespace-nowrap text-gray-500 dark:text-gray-400">{recruitKind(r.template_id)}</td>
								<td class="px-5 py-3.5 whitespace-nowrap text-gray-500 dark:text-gray-400">{fmtTs(r.sent_at)}</td>
								<td class="px-5 py-3.5 text-gray-500 dark:text-gray-400">{r.recipient ?? "—"}</td>
								<td class="px-5 py-3.5">
									<span class={`${PILL} ${badge[r.status] ?? "bg-gray-100 text-gray-600 dark:bg-white/[0.03] dark:text-gray-400"}`}>{r.status}</span>
									{r.error_message && (
										<span class="mt-1 block max-w-xs truncate text-xs text-gray-400" title={r.error_message}>{r.error_message}</span>
									)}
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>
	)}
</MailLayout>
