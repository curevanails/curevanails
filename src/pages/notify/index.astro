---
/**
 * Compose — the email dashboard's home page (`/mail`).
 *
 * Pick a template + audience, preview it live, and send now or schedule for a
 * Utah (Mountain Time) moment. Templates, campaigns, analytics, activity and the
 * suppression list are each their own page under the same mount; see the sidebar.
 */
import {
	loadAudienceCounts,
	loadMailData,
	loadTemplates,
	mailDb,
	sesConfigured,
	type AudienceCounts,
	type TemplateRow,
} from "../../utils/email-data";
import { emailNav } from "../../utils/email-nav";
import MailLayout from "../../layouts/MailLayout.astro";
import SesNotice from "../../components/mail/SesNotice.astro";

// Server-rendered, never cached. Gated by the admin auth in src/middleware.ts.
export const prerender = false;

const nav = emailNav();
const ses = sesConfigured();

const { data, error: loadError } = await loadMailData(mailDb(), async (db) => ({
	templates: await loadTemplates(db),
	counts: await loadAudienceCounts(db),
}));

const templates: TemplateRow[] = data?.templates ?? [];
const counts: AudienceCounts = data?.counts ?? { all: 0, waiting: 0, invited: 0, redeemed: 0 };

// Pass template bodies to the client for the live preview (sample-variable
// substitution).
const templatesForClient = templates.map((t) => ({
	id: t.id,
	name: t.name,
	subject: t.subject,
	html: t.html,
}));

// Where to land after a campaign is scheduled — the Campaigns page lists it.
const campaignsHref = nav.campaigns;
---

<MailLayout
	title="Compose"
	description="Send a campaign to the waitlist, now or scheduled for a Utah time."
	active="mail"
	loadError={loadError}
>
	{!ses && <SesNotice />}

	{!loadError && (
		<div id="cp-container" class="flex flex-col xl:flex-row gap-6 xl:gap-0 items-stretch" style="--left-w: 50%">
			{/* ---- Compose ---- */}
			<section class="bg-white rounded-2xl border border-gray-200 shadow-theme-xs w-full xl:w-[var(--left-w)] xl:shrink-0 min-w-0 dark:bg-white/[0.03] dark:border-gray-800">
				<header class="px-5 py-4 border-b border-gray-200 dark:border-gray-800 flex items-center justify-between">
					<div class="flex items-center gap-2.5">
						<span class="grid h-9 w-9 place-items-center rounded-lg bg-brand-50 text-brand-500 dark:bg-brand-500/15 dark:text-brand-400">
							<span class="material-symbols-outlined">send</span>
						</span>
						<div>
							<h2 class="font-semibold text-gray-800 dark:text-white/90">Compose &amp; send</h2>
							<p class="text-xs text-gray-400 dark:text-gray-500">Pick a template and audience.</p>
						</div>
					</div>
				</header>
				<div class="p-5 space-y-5">
					<div>
						<label for="template" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Template</label>
						{templates.length === 0 ? (
							<p class="rounded-lg border border-dashed border-gray-300 px-4 py-3 text-sm text-gray-500 dark:border-gray-700 dark:text-gray-400">
								No templates yet — <a href={nav.templates} class="font-medium text-brand-500 hover:text-brand-600">create one</a> to start sending.
							</p>
						) : (
							<select id="template" onchange="updatePreview()" class="form-select w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 shadow-theme-xs focus:border-brand-300 focus:ring-3 focus:ring-brand-500/10 dark:border-gray-700 dark:bg-gray-900 dark:text-white/90">
								{templates.map((t) => <option value={t.id}>{t.name}</option>)}
							</select>
						)}
					</div>

					<div>
						<label for="audience" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Audience <span class="text-xs font-normal text-gray-400 dark:text-gray-500">— active subscribers only</span></label>
						<select id="audience" class="form-select w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 shadow-theme-xs focus:border-brand-300 focus:ring-3 focus:ring-brand-500/10 dark:border-gray-700 dark:bg-gray-900 dark:text-white/90">
							<option value="all">All active — {counts.all}</option>
							<option value="waiting">Waiting — {counts.waiting}</option>
							<option value="invited">Invited — {counts.invited}</option>
							<option value="redeemed">Redeemed — {counts.redeemed}</option>
						</select>
					</div>

					<div id="discount-wrap" class="hidden">
						<label for="discount" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Shared discount code <span class="text-xs font-normal text-gray-400 dark:text-gray-500">— optional override</span></label>
						<input id="discount" type="text" placeholder="e.g. CUREVA15" oninput="updatePreview()" class="form-input w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 shadow-theme-xs focus:border-brand-300 focus:ring-3 focus:ring-brand-500/10 dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
						<p class="text-xs text-gray-400 dark:text-gray-500 mt-1.5">Leave blank to use each subscriber's own code from the waitlist.</p>
					</div>

					<div>
						<span class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">When</span>
						<div class="flex rounded-lg border border-gray-200 bg-gray-50 p-1 dark:border-gray-800 dark:bg-white/[0.03]">
							<button type="button" id="when-now" onclick="setWhen('now')"
								class="flex-1 inline-flex items-center justify-center gap-1.5 rounded-md px-3 py-1.5 text-sm bg-white text-gray-800 font-semibold shadow-theme-xs transition dark:bg-gray-900 dark:text-white/90">
								<span class="material-symbols-outlined text-base">bolt</span>Send now
							</button>
							<button type="button" id="when-later" onclick="setWhen('later')"
								class="flex-1 inline-flex items-center justify-center gap-1.5 rounded-md px-3 py-1.5 text-sm font-medium text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-white transition">
								<span class="material-symbols-outlined text-base">event</span>Schedule
							</button>
						</div>
					</div>

					<div id="schedule-wrap" class="hidden">
						<span class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Date &amp; time <span class="text-xs font-normal text-gray-400 dark:text-gray-500">— Utah (Mountain Time)</span></span>
						<input id="schedule-at" type="hidden" />
						<div id="dtp-root" class="relative">
							<button type="button" id="dtp-trigger" onclick="dtpToggle()"
								class="w-full flex items-center justify-between gap-2 rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-left shadow-theme-xs hover:border-gray-400 focus:outline-none focus:border-brand-300 focus:ring-3 focus:ring-brand-500/10 transition dark:border-gray-700 dark:bg-gray-900 dark:hover:border-gray-600">
								<span class="flex items-center gap-2 min-w-0">
									<span class="material-symbols-outlined text-base text-gray-400">calendar_month</span>
									<span id="dtp-label" class="truncate text-gray-400 dark:text-gray-500">Pick a date &amp; time…</span>
								</span>
								<span class="material-symbols-outlined text-base text-gray-400">expand_more</span>
							</button>

							{/* Calendar + time popover */}
							<div id="dtp" class="hidden absolute z-40 mt-2 left-0 w-full sm:w-[340px] rounded-xl bg-white border border-gray-200 shadow-theme-lg p-4 pop-in dark:bg-gray-900 dark:border-gray-800">
								<div class="flex items-center justify-between mb-2">
									<button type="button" onclick="dtpPrev()" class="grid h-8 w-8 place-items-center rounded-lg text-gray-400 hover:bg-gray-100 hover:text-gray-700 dark:hover:bg-white/[0.06] dark:hover:text-white transition">
										<span class="material-symbols-outlined text-base">chevron_left</span>
									</button>
									<p id="dtp-month-label" class="text-sm font-semibold text-gray-800 dark:text-white/90"></p>
									<button type="button" onclick="dtpNext()" class="grid h-8 w-8 place-items-center rounded-lg text-gray-400 hover:bg-gray-100 hover:text-gray-700 dark:hover:bg-white/[0.06] dark:hover:text-white transition">
										<span class="material-symbols-outlined text-base">chevron_right</span>
									</button>
								</div>
								<div class="grid grid-cols-7 text-center text-[11px] font-semibold text-gray-400 mb-1">
									<span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span>
								</div>
								<div id="dtp-days" class="grid grid-cols-7 gap-0.5"></div>

								<div class="mt-3 pt-3 border-t border-gray-200 dark:border-gray-800 flex items-center gap-2">
									<span class="material-symbols-outlined text-base text-gray-400">schedule</span>
									<select id="dtp-hour" aria-label="Hour" class="form-select rounded-lg border border-gray-300 bg-transparent py-1.5 pl-3 pr-8 text-sm font-medium text-gray-800 shadow-theme-xs focus:border-brand-300 focus:ring-3 focus:ring-brand-500/10 dark:border-gray-700 dark:bg-gray-900 dark:text-white/90"></select>
									<span class="text-gray-400 font-semibold">:</span>
									<select id="dtp-min" aria-label="Minute" class="form-select rounded-lg border border-gray-300 bg-transparent py-1.5 pl-3 pr-8 text-sm font-medium text-gray-800 shadow-theme-xs focus:border-brand-300 focus:ring-3 focus:ring-brand-500/10 dark:border-gray-700 dark:bg-gray-900 dark:text-white/90"></select>
									<div class="ml-auto flex rounded-lg border border-gray-200 p-0.5 dark:border-gray-700">
										<button type="button" id="dtp-am" onclick="dtpSetAmPm('AM')" class="rounded-md px-2.5 py-1 text-xs font-semibold bg-brand-500 text-white transition">AM</button>
										<button type="button" id="dtp-pm" onclick="dtpSetAmPm('PM')" class="rounded-md px-2.5 py-1 text-xs font-medium text-gray-500 dark:text-gray-400 transition">PM</button>
									</div>
								</div>

								<div class="mt-3 flex flex-wrap gap-1.5">
									<button type="button" onclick="dtpPreset('plus1h')" class="rounded-full border border-gray-200 px-3 py-1.5 text-xs font-medium text-gray-600 hover:border-brand-300 hover:text-brand-500 dark:border-gray-700 dark:text-gray-400 dark:hover:border-brand-700 dark:hover:text-brand-400 transition">In 1 hour</button>
									<button type="button" onclick="dtpPreset('tomorrow9')" class="rounded-full border border-gray-200 px-3 py-1.5 text-xs font-medium text-gray-600 hover:border-brand-300 hover:text-brand-500 dark:border-gray-700 dark:text-gray-400 dark:hover:border-brand-700 dark:hover:text-brand-400 transition">Tomorrow 9 AM</button>
									<button type="button" onclick="dtpPreset('monday9')" class="rounded-full border border-gray-200 px-3 py-1.5 text-xs font-medium text-gray-600 hover:border-brand-300 hover:text-brand-500 dark:border-gray-700 dark:text-gray-400 dark:hover:border-brand-700 dark:hover:text-brand-400 transition">Monday 9 AM</button>
								</div>

								<div class="mt-3 pt-3 border-t border-gray-200 dark:border-gray-800 flex items-center justify-between">
									<button type="button" onclick="dtpClear()" class="text-xs font-medium text-gray-400 hover:text-error-500 transition">Clear</button>
									<button type="button" onclick="dtpToggle()" class="rounded-lg bg-brand-500 px-4 py-1.5 text-xs font-semibold text-white hover:bg-brand-600 transition">Done</button>
								</div>
							</div>
						</div>
						<p id="schedule-echo" class="text-xs text-gray-400 dark:text-gray-500 mt-1.5">Sends automatically at this Mountain Time (checked every ~5 min).</p>
					</div>

					<button id="send-btn" type="button" onclick="submitCampaign()" disabled={!ses || templates.length === 0}
						class="w-full inline-flex items-center justify-center gap-2 rounded-lg bg-brand-500 px-4 py-3 text-sm font-medium text-white shadow-theme-xs hover:bg-brand-600 transition disabled:opacity-40 disabled:cursor-not-allowed">
						<span class="material-symbols-outlined text-base" id="send-btn-icon">send</span><span id="send-btn-label">Send campaign</span>
					</button>
					<div id="send-result" class="hidden rounded-lg px-4 py-3 text-sm"></div>
				</div>
			</section>

			{/* ---- Drag-to-resize divider (xl+ only) ---- */}
			<div id="cp-splitter" title="Drag to resize" class="hidden xl:flex items-center justify-center w-6 shrink-0 cursor-col-resize group select-none touch-none">
				<div class="h-14 w-1 rounded-full bg-gray-300 group-hover:bg-brand-500 group-hover:h-20 transition-all dark:bg-gray-700"></div>
			</div>

			{/* ---- Preview ---- */}
			<section class="bg-white rounded-2xl border border-gray-200 shadow-theme-xs w-full xl:flex-1 min-w-0 flex flex-col dark:bg-white/[0.03] dark:border-gray-800">
				<header class="px-5 py-4 border-b border-gray-200 dark:border-gray-800 flex items-center justify-between">
					<div class="min-w-0 flex items-center gap-2.5">
						<span class="grid h-9 w-9 place-items-center rounded-lg bg-success-50 text-success-700 dark:bg-success-500/15 dark:text-success-500">
							<span class="material-symbols-outlined">visibility</span>
						</span>
						<div class="min-w-0">
							<h2 class="font-semibold text-gray-800 dark:text-white/90">Live preview</h2>
							<p class="text-xs text-gray-400 dark:text-gray-500 truncate">Subject: <span id="preview-subject" class="font-medium text-gray-600 dark:text-gray-300"></span></p>
						</div>
					</div>
					<span class="inline-flex items-center gap-1.5 rounded-full bg-success-50 px-2.5 py-0.5 text-xs font-medium text-success-700 dark:bg-success-500/15 dark:text-success-500">
						<span class="h-1.5 w-1.5 rounded-full bg-success-500 animate-pulse"></span>Live
					</span>
				</header>
				<div class="p-5 flex-1">
					<iframe id="preview-frame" title="Email preview" class="w-full h-[600px] rounded-lg border border-gray-200 bg-white dark:border-gray-800"></iframe>
					<p class="text-xs text-gray-400 dark:text-gray-500 mt-2.5">Preview uses sample values (<code class="px-1 rounded bg-gray-100 dark:bg-white/[0.06]">name → Ava</code>). Real sends personalize per subscriber.</p>
				</div>
			</section>
		</div>
	)}

	<script slot="scripts" is:inline define:vars={{ templatesForClient, ses, campaignsHref }}>
		const TEMPLATES = templatesForClient;

		function fillSample(str, discount) {
			return String(str)
				.replace(/\{\{\s*name\s*\}\}/g, "Ava")
				.replace(/\{\{\s*discount_code\s*\}\}/g, discount || "CUREVA15")
				.replace(/\{\{\s*unsubscribe_url\s*\}\}/g, "#")
				.replace(/\{\{\s*email\s*\}\}/g, "ava@example.com");
		}

		function updatePreview() {
			const sel = document.getElementById("template");
			const tpl = sel ? TEMPLATES.find((t) => t.id === sel.value) : null;
			const discount = (document.getElementById("discount") || {}).value || "";
			const subjEl = document.getElementById("preview-subject");
			const frame = document.getElementById("preview-frame");
			if (!tpl) return;
			if (subjEl) subjEl.textContent = fillSample(tpl.subject, discount);
			if (frame) frame.srcdoc = fillSample(tpl.html, discount);
			// Show the discount field only for templates that use it.
			const wrap = document.getElementById("discount-wrap");
			if (wrap) wrap.classList.toggle("hidden", !/\{\{\s*discount_code\s*\}\}/.test(tpl.html + tpl.subject));
		}

		function showSendResult(ok, msg) {
			const result = document.getElementById("send-result");
			result.className = "rounded-lg px-4 py-3 text-sm " +
				(ok ? "bg-success-50 border border-success-200 text-success-700 dark:bg-success-500/10 dark:border-success-500/30 dark:text-success-500"
					: "bg-error-50 border border-error-200 text-error-700 dark:bg-error-500/10 dark:border-error-500/30 dark:text-error-400");
			result.textContent = msg;
		}

		async function sendCampaign() {
			if (!ses) return;
			const btn = document.getElementById("send-btn");
			const result = document.getElementById("send-result");
			const templateSel = document.getElementById("template");
			const audienceSel = document.getElementById("audience");
			if (!templateSel) return;
			const discount = (document.getElementById("discount") || {}).value || "";
			const audienceLabel = audienceSel.selectedOptions[0].textContent;

			if (!confirm(`Send "${templateSel.selectedOptions[0].textContent}" to: ${audienceLabel}?`)) return;

			btn.disabled = true;
			const original = btn.innerHTML;
			btn.innerHTML = "Sending…";
			result.className = "hidden rounded-lg px-4 py-3 text-sm";

			try {
				const body = { template_id: templateSel.value, audience: audienceSel.value };
				if (discount) body.variables = { discount_code: discount };
				const res = await fetch("/api/email/send", {
					method: "POST",
					headers: { "content-type": "application/json" },
					body: JSON.stringify(body),
				});
				const data = await res.json();
				if (res.ok && data.ok) {
					showSendResult(true, `Sent ${data.sent} of ${data.total}. ${data.failed ? data.failed + " failed/suppressed." : ""}`);
				} else {
					showSendResult(false, data.error || "Send failed.");
				}
			} catch (e) {
				showSendResult(false, "Network error. Please try again.");
			} finally {
				btn.disabled = false;
				btn.innerHTML = original;
			}
		}

		// ---- Schedule campaign (Utah / Mountain Time) ----
		let _when = "now";

		function setWhen(mode) {
			_when = mode;
			const base = "flex-1 inline-flex items-center justify-center gap-1.5 rounded-md px-3 py-1.5 text-sm transition";
			const active = base + " bg-white text-gray-800 font-semibold shadow-theme-xs dark:bg-gray-900 dark:text-white/90";
			const idle = base + " font-medium text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-white";
			document.getElementById("when-now").className = mode === "now" ? active : idle;
			document.getElementById("when-later").className = mode === "later" ? active : idle;
			document.getElementById("schedule-wrap").classList.toggle("hidden", mode !== "later");
			document.getElementById("send-btn-label").textContent = mode === "later" ? "Schedule campaign" : "Send campaign";
			document.getElementById("send-btn-icon").textContent = mode === "later" ? "schedule" : "send";
			// First switch to Schedule: default to tomorrow 9:00 AM (Utah).
			if (mode === "later" && !document.getElementById("schedule-at").value) {
				dtpPreset("tomorrow9", true);
			}
		}

		// Interpret a datetime-local string ("YYYY-MM-DDTHH:mm") as a wall-clock
		// time in America/Denver (Utah) and return the absolute epoch ms — so the
		// scheduled time means Utah time no matter where the admin's browser is.
		function denverEpochFromWall(localStr) {
			if (!localStr || localStr.indexOf("T") === -1) return NaN;
			const [datePart, timePart] = localStr.split("T");
			const [Y, M, D] = datePart.split("-").map(Number);
			const [h, m] = timePart.split(":").map(Number);
			const guess = Date.UTC(Y, M - 1, D, h, m);
			const fmt = new Intl.DateTimeFormat("en-US", {
				timeZone: "America/Denver", year: "numeric", month: "2-digit", day: "2-digit",
				hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false,
			});
			const p = {};
			for (const part of fmt.formatToParts(new Date(guess))) p[part.type] = part.value;
			const wallAsUTC = Date.UTC(+p.year, +p.month - 1, +p.day, +p.hour % 24, +p.minute, +p.second);
			const offset = wallAsUTC - guess; // Denver = UTC + offset
			return guess - offset;
		}

		function updateScheduleEcho() {
			const v = document.getElementById("schedule-at").value;
			const echo = document.getElementById("schedule-echo");
			const epoch = denverEpochFromWall(v);
			if (!v || isNaN(epoch)) {
				echo.className = "text-xs text-gray-400 dark:text-gray-500 mt-1.5";
				echo.textContent = "Sends automatically at this Mountain Time (checked every ~5 min).";
				return;
			}
			const when = new Date(epoch).toLocaleString("en-US", {
				month: "short", day: "numeric", year: "numeric", hour: "numeric", minute: "2-digit",
				timeZone: "America/Denver",
			});
			if (epoch <= Date.now()) {
				echo.className = "text-xs text-error-500 mt-1.5";
				echo.textContent = "That time is in the past — pick a future time.";
			} else {
				echo.className = "text-xs text-gray-500 dark:text-gray-400 mt-1.5";
				echo.textContent = "Sends " + when + " MT — automatically (checked every ~5 min).";
			}
		}

		// ---- Modern date & time picker (all values are Utah wall-clock) ----
		const MONTHS = ["January","February","March","April","May","June","July","August","September","October","November","December"];
		const DAYS_SHORT = ["Sun","Mon","Tue","Wed","Thu","Fri","Sat"];
		const MONTHS_SHORT = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];

		/** Current wall-clock date/time in America/Denver. */
		function denverNowParts() {
			const fmt = new Intl.DateTimeFormat("en-US", {
				timeZone: "America/Denver", year: "numeric", month: "2-digit", day: "2-digit",
				hour: "2-digit", minute: "2-digit", hour12: false,
			});
			const p = {};
			for (const part of fmt.formatToParts(new Date())) p[part.type] = part.value;
			return { y: +p.year, m: +p.month - 1, d: +p.day, h: +p.hour % 24, min: +p.minute };
		}

		const _now0 = denverNowParts();
		const dtp = {
			open: false,
			viewY: _now0.y, viewM: _now0.m,          // month being displayed
			selY: null, selM: null, selD: null,       // selected day
			hour12: 9, minute: 0, ampm: "AM",         // selected time
		};

		function dtpInitTimeSelects() {
			const hourSel = document.getElementById("dtp-hour");
			const minSel = document.getElementById("dtp-min");
			if (!hourSel || hourSel.options.length) return;
			for (let h = 1; h <= 12; h++) {
				const o = document.createElement("option");
				o.value = String(h); o.textContent = String(h);
				hourSel.appendChild(o);
			}
			for (let m = 0; m < 60; m += 5) {
				const o = document.createElement("option");
				o.value = String(m); o.textContent = String(m).padStart(2, "0");
				minSel.appendChild(o);
			}
			hourSel.value = String(dtp.hour12);
			minSel.value = String(dtp.minute);
			hourSel.addEventListener("change", () => { dtp.hour12 = +hourSel.value; dtpSync(); });
			minSel.addEventListener("change", () => { dtp.minute = +minSel.value; dtpSync(); });
		}

		function dtpToggle() {
			const pop = document.getElementById("dtp");
			dtp.open = !dtp.open;
			pop.classList.toggle("hidden", !dtp.open);
			if (dtp.open) {
				dtpInitTimeSelects();
				if (dtp.selY != null) { dtp.viewY = dtp.selY; dtp.viewM = dtp.selM; }
				dtpRender();
			}
		}

		function dtpPrev() { dtp.viewM--; if (dtp.viewM < 0) { dtp.viewM = 11; dtp.viewY--; } dtpRender(); }
		function dtpNext() { dtp.viewM++; if (dtp.viewM > 11) { dtp.viewM = 0; dtp.viewY++; } dtpRender(); }

		function dtpSetAmPm(p) {
			dtp.ampm = p;
			const am = document.getElementById("dtp-am");
			const pm = document.getElementById("dtp-pm");
			const on = "rounded-md px-2.5 py-1 text-xs font-semibold bg-brand-500 text-white transition";
			const off = "rounded-md px-2.5 py-1 text-xs font-medium text-gray-500 dark:text-gray-400 transition";
			am.className = p === "AM" ? on : off;
			pm.className = p === "PM" ? on : off;
			dtpSync();
		}

		function dtpRender() {
			document.getElementById("dtp-month-label").textContent = MONTHS[dtp.viewM] + " " + dtp.viewY;
			const grid = document.getElementById("dtp-days");
			grid.innerHTML = "";
			const today = denverNowParts();
			const firstDow = new Date(Date.UTC(dtp.viewY, dtp.viewM, 1)).getUTCDay();
			const daysInMonth = new Date(Date.UTC(dtp.viewY, dtp.viewM + 1, 0)).getUTCDate();
			for (let i = 0; i < firstDow; i++) grid.appendChild(document.createElement("span"));
			for (let d = 1; d <= daysInMonth; d++) {
				const btn = document.createElement("button");
				btn.type = "button";
				btn.textContent = String(d);
				const isPast =
					dtp.viewY < today.y ||
					(dtp.viewY === today.y && dtp.viewM < today.m) ||
					(dtp.viewY === today.y && dtp.viewM === today.m && d < today.d);
				const isToday = dtp.viewY === today.y && dtp.viewM === today.m && d === today.d;
				const isSel = dtp.selY === dtp.viewY && dtp.selM === dtp.viewM && dtp.selD === d;
				let cls = "h-9 w-full rounded-lg text-sm transition ";
				if (isPast) cls += "text-gray-300 dark:text-gray-700 cursor-not-allowed";
				else if (isSel) cls += "bg-brand-500 text-white font-semibold";
				else if (isToday) cls += "text-brand-500 font-semibold border border-brand-300 hover:bg-gray-100 dark:hover:bg-white/[0.06]";
				else cls += "text-gray-600 dark:text-gray-300 font-medium hover:bg-gray-100 dark:hover:bg-white/[0.06]";
				btn.className = cls;
				if (!isPast) {
					btn.addEventListener("click", () => {
						dtp.selY = dtp.viewY; dtp.selM = dtp.viewM; dtp.selD = d;
						dtpRender(); dtpSync();
					});
				} else {
					btn.disabled = true;
				}
				grid.appendChild(btn);
			}
		}

		function dtpPreset(kind, silent) {
			const now = denverNowParts();
			let y = now.y, m = now.m, d = now.d, h12 = 9, mi = 0, ap = "AM";
			if (kind === "plus1h") {
				// One hour from now (Utah), minutes rounded up to :05.
				let h = now.h + 1, day = now.d;
				mi = Math.ceil(now.min / 5) * 5;
				if (mi >= 60) { mi = 0; h++; }
				if (h >= 24) { h -= 24; day++; }
				const dim = new Date(Date.UTC(now.y, now.m + 1, 0)).getUTCDate();
				if (day > dim) { day = 1; m = now.m + 1; if (m > 11) { m = 0; y++; } }
				d = day;
				ap = h >= 12 ? "PM" : "AM";
				h12 = h % 12 === 0 ? 12 : h % 12;
			} else if (kind === "tomorrow9") {
				const dim = new Date(Date.UTC(now.y, now.m + 1, 0)).getUTCDate();
				d = now.d + 1;
				if (d > dim) { d = 1; m = now.m + 1; if (m > 11) { m = 0; y++; } }
			} else if (kind === "monday9") {
				const dow = new Date(Date.UTC(now.y, now.m, now.d)).getUTCDay();
				let add = (8 - dow) % 7; if (add === 0) add = 7;
				const t = new Date(Date.UTC(now.y, now.m, now.d + add));
				y = t.getUTCFullYear(); m = t.getUTCMonth(); d = t.getUTCDate();
			}
			dtp.selY = y; dtp.selM = m; dtp.selD = d;
			dtp.viewY = y; dtp.viewM = m;
			dtp.hour12 = h12; dtp.minute = mi; dtp.ampm = ap;
			dtpInitTimeSelects();
			const hourSel = document.getElementById("dtp-hour");
			const minSel = document.getElementById("dtp-min");
			if (hourSel) hourSel.value = String(h12);
			if (minSel) minSel.value = String(mi);
			dtpSetAmPm(ap);
			if (dtp.open) dtpRender();
			if (!silent && !dtp.open) dtpToggle();
			dtpSync();
		}

		function dtpClear() {
			dtp.selY = dtp.selM = dtp.selD = null;
			document.getElementById("schedule-at").value = "";
			const label = document.getElementById("dtp-label");
			label.textContent = "Pick a date & time…";
			label.className = "truncate text-gray-400 dark:text-gray-500";
			if (dtp.open) dtpRender();
			updateScheduleEcho();
		}

		/** Write the selection to the hidden input + trigger label + echo. */
		function dtpSync() {
			if (dtp.selY == null) return;
			let h = dtp.hour12 % 12;
			if (dtp.ampm === "PM") h += 12;
			const val = dtp.selY + "-" + String(dtp.selM + 1).padStart(2, "0") + "-" +
				String(dtp.selD).padStart(2, "0") + "T" + String(h).padStart(2, "0") + ":" +
				String(dtp.minute).padStart(2, "0");
			document.getElementById("schedule-at").value = val;
			const dow = DAYS_SHORT[new Date(Date.UTC(dtp.selY, dtp.selM, dtp.selD)).getUTCDay()];
			const label = document.getElementById("dtp-label");
			label.textContent = dow + ", " + MONTHS_SHORT[dtp.selM] + " " + dtp.selD + ", " + dtp.selY +
				" · " + dtp.hour12 + ":" + String(dtp.minute).padStart(2, "0") + " " + dtp.ampm + " MT";
			label.className = "truncate font-medium text-gray-800 dark:text-white/90";
			updateScheduleEcho();
		}

		// Close the picker when clicking outside it.
		document.addEventListener("click", (e) => {
			if (!dtp.open) return;
			const root = document.getElementById("dtp-root");
			if (root && !root.contains(e.target)) {
				dtp.open = false;
				document.getElementById("dtp").classList.add("hidden");
			}
		});

		function submitCampaign() {
			if (!ses) return;
			if (_when === "later") scheduleCampaign();
			else sendCampaign();
		}

		async function scheduleCampaign() {
			const templateSel = document.getElementById("template");
			if (!templateSel) return;
			const audience = document.getElementById("audience").value;
			const discount = (document.getElementById("discount") || {}).value || "";
			const v = document.getElementById("schedule-at").value;
			const epoch = denverEpochFromWall(v);
			if (!v || isNaN(epoch)) { showSendResult(false, "Pick a date and time."); return; }
			if (epoch <= Date.now()) { showSendResult(false, "Pick a time in the future (Mountain Time)."); return; }
			const body = { action: "create", template_id: templateSel.value, audience, scheduled_at: epoch };
			if (discount) body.variables = { discount_code: discount };
			const btn = document.getElementById("send-btn");
			const label = document.getElementById("send-btn-label");
			const prevLabel = label.textContent;
			btn.disabled = true;
			label.textContent = "Scheduling…";
			try {
				const res = await fetch("/api/email/schedule", {
					method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body),
				});
				const data = await res.json();
				// Land on Campaigns so the operator sees the campaign they just queued.
				if (res.ok && data.ok) { location.href = campaignsHref; return; }
				showSendResult(false, data.error || "Could not schedule.");
			} catch (e) {
				showSendResult(false, "Network error. Please try again.");
			}
			btn.disabled = false;
			label.textContent = prevLabel;
		}

		// Astro wraps an `is:inline` + `define:vars` script in an IIFE, so these
		// functions are NOT global by default — but the inline onclick/onchange/
		// oninput attributes in the markup resolve against `window`. Expose them.
		Object.assign(window, {
			updatePreview,
			sendCampaign,
			setWhen,
			submitCampaign,
			scheduleCampaign,
			updateScheduleEcho,
			dtpToggle,
			dtpPrev,
			dtpNext,
			dtpSetAmPm,
			dtpPreset,
			dtpClear,
		});

		// ---- Drag-to-resize divider between Compose and Preview ----
		(function setupSplitter() {
			const container = document.getElementById("cp-container");
			const splitter = document.getElementById("cp-splitter");
			const frame = document.getElementById("preview-frame");
			if (!container || !splitter) return;
			let dragging = false;

			splitter.addEventListener("pointerdown", (e) => {
				dragging = true;
				splitter.setPointerCapture(e.pointerId);
				document.body.style.userSelect = "none";
				if (frame) frame.style.pointerEvents = "none"; // don't let the iframe swallow moves
				e.preventDefault();
			});
			splitter.addEventListener("pointermove", (e) => {
				if (!dragging) return;
				const rect = container.getBoundingClientRect();
				let pct = ((e.clientX - rect.left) / rect.width) * 100;
				pct = Math.max(25, Math.min(75, pct));
				container.style.setProperty("--left-w", pct + "%");
			});
			const end = () => {
				if (!dragging) return;
				dragging = false;
				document.body.style.userSelect = "";
				if (frame) frame.style.pointerEvents = "";
			};
			splitter.addEventListener("pointerup", end);
			splitter.addEventListener("pointercancel", end);
			// Double-click the handle to reset to a 50/50 split.
			splitter.addEventListener("dblclick", () => container.style.setProperty("--left-w", "50%"));
		})();

		updatePreview();
	</script>
</MailLayout>
