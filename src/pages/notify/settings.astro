---
/**
 * Settings — operator settings for the email service (`/mail/settings`).
 *
 * Today that is the recruit-alert recipient list, saved to `app_settings` by a
 * plain form POST to this page.
 */
import { env } from "cloudflare:workers";
import {
	RECRUIT_NOTIFY_TO,
	getSetting,
	parseRecipients,
	recipientsValid,
	setSetting,
} from "../../utils/app-settings";
import { emailNav } from "../../utils/email-nav";
import { detectMailProvider } from "../../utils/email/mailer";
import MailLayout from "../../layouts/MailLayout.astro";

// Server-rendered, auth-gated by src/middleware.ts (path listed as protected).
export const prerender = false;

const nav = emailNav();
const db = env.DB as D1Database;

/* Only the SES fallback has a sandbox; on Cloudflare Email Service any
   address can receive the alert, so the caveat would just be noise. */
const verifyHint =
	detectMailProvider(env as unknown as Record<string, unknown>) === "ses"
		? " In the SES sandbox, each address must be verified in AWS."
		: "";

let saved = false;
let error: string | null = null;
let value = (await getSetting(db, RECRUIT_NOTIFY_TO)) ?? "";

if (Astro.request.method === "POST") {
	const form = await Astro.request.formData();
	const raw = String(form.get("recruit_notify_to") ?? "").trim();
	if (!recipientsValid(raw)) {
		error = "One or more addresses look invalid. Separate multiple with commas.";
		value = raw;
	} else {
		// Store normalised (comma-joined) so the read side is predictable.
		const normalised = parseRecipients(raw).join(", ");
		await setSetting(db, RECRUIT_NOTIFY_TO, normalised);
		value = normalised;
		saved = true;
	}
}

const count = parseRecipients(value).length;
---

<MailLayout
	title="Settings"
	description="Operator settings for the CureVà email service."
	active="mail-settings"
>
	<section class="max-w-2xl bg-white rounded-2xl border border-gray-200 shadow-theme-xs dark:bg-white/[0.03] dark:border-gray-800">
		<header class="px-5 py-4 border-b border-gray-200 dark:border-gray-800 flex items-center gap-2.5">
			<span class="grid h-9 w-9 place-items-center rounded-lg bg-brand-50 text-brand-500 dark:bg-brand-500/15 dark:text-brand-400">
				<span class="material-symbols-outlined">badge</span>
			</span>
			<h2 class="font-semibold text-gray-800 dark:text-white/90">Recruit alerts</h2>
		</header>

		<div class="p-5">
			<p class="text-sm text-gray-500 dark:text-gray-400">
				Who receives an email when a candidate submits the application form at
				<code class="rounded bg-gray-100 px-1.5 py-0.5 text-xs dark:bg-white/[0.06]">/recruit/apply</code>.
			</p>

			{saved && (
				<div class="mt-4 rounded-lg border border-success-200 bg-success-50 px-4 py-3 text-sm text-success-700 dark:border-success-500/30 dark:bg-success-500/10 dark:text-success-500">
					Saved. {count === 0 ? "Alerts are now OFF (no recipients)." : `${count} recipient${count === 1 ? "" : "s"} will be notified.`}
				</div>
			)}
			{error && (
				<div class="mt-4 rounded-lg border border-error-200 bg-error-50 px-4 py-3 text-sm text-error-700 dark:border-error-500/30 dark:bg-error-500/10 dark:text-error-400">
					{error}
				</div>
			)}

			<form method="POST" class="mt-5">
				<label for="recruit_notify_to" class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-300">
					Notify addresses
				</label>
				{/*
				  THE INPUT IS THE SOURCE OF TRUTH, AND THE FALLBACK. The endpoint
				  reads one comma-joined string, and with no JavaScript this is a
				  plain text field that still works exactly as it did. The chip
				  view below is built over it and writes back into it, so nothing
				  server-side knows the difference.
				*/}
				<input
					id="recruit_notify_to"
					name="recruit_notify_to"
					type="text"
					value={value}
					placeholder="you@example.com, partner@example.com"
					autocomplete="off"
					data-verify-hint={verifyHint}
					class="js-chip-source form-input w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 shadow-theme-xs focus:border-brand-300 focus:ring-3 focus:ring-brand-500/10 dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30"
				/>
				<p class="js-chip-fallback-hint mt-2 text-xs text-gray-400 dark:text-gray-500">
					Separate multiple addresses with commas. Leave blank to turn alerts off.{verifyHint}
				</p>
				<div class="mt-4 flex items-center gap-3">
					<button
						type="submit"
						class="inline-flex items-center gap-1.5 rounded-lg bg-brand-500 px-5 py-2.5 text-sm font-medium text-white shadow-theme-xs hover:bg-brand-600 transition"
					>
						<span class="material-symbols-outlined text-base">save</span>Save
					</button>
					<a href={nav.recruitAlerts} class="text-sm font-medium text-brand-500 hover:text-brand-600">View recruit alerts →</a>
				</div>
			</form>
		</div>
	</section>
</MailLayout>

<script>
	/* ── Addresses as chips ───────────────────────────────────────────────
	   A comma-separated string is a poor way to READ a recipient list: you
	   cannot see how many there are, a stray comma silently welds two
	   addresses into one nonsense entry, and deleting the middle one is a
	   careful editing job. Each address becomes a chip you can count and
	   remove on its own.

	   PROGRESSIVE. The text input stays the source of truth and simply goes
	   hidden; this view writes back into it on every change, so the POST body
	   and the endpoint are untouched. If this script never runs, the field is
	   the plain comma-separated input it always was.

	   The parsing rule is the SERVER'S, copied deliberately — split on commas,
	   semicolons or whitespace, same address regex (utils/app-settings.ts).
	   A chip that shows red here is one the endpoint would actually reject,
	   not a second opinion about it. ------------------------------------ */
	const source = document.querySelector<HTMLInputElement>(".js-chip-source");
	if (source) {
		const hint = document.querySelector(".js-chip-fallback-hint");
		const EMAIL_RE = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;

		const split = (raw: string): string[] =>
			raw
				.split(/[,;\s]+/)
				.map((x) => x.trim())
				.filter(Boolean);

		const items: string[] = [];
		const seen = new Set<string>();
		for (const a of split(source.value)) {
			const key = a.toLowerCase();
			if (!seen.has(key)) {
				seen.add(key);
				items.push(a);
			}
		}

		const box = document.createElement("div");
		box.className =
			"flex flex-wrap items-center gap-2 rounded-lg border border-gray-300 bg-transparent px-3 py-2.5 " +
			"shadow-theme-xs focus-within:border-brand-300 focus-within:ring-3 focus-within:ring-brand-500/10 " +
			"dark:border-gray-700 dark:bg-gray-900";

		const entry = document.createElement("input");
		entry.type = "text";
		entry.autocomplete = "off";
		entry.setAttribute("aria-describedby", "chipHelp");
		entry.setAttribute("aria-label", "Add an address");
		entry.className =
			"min-w-[12rem] flex-1 border-0 bg-transparent p-0 text-sm text-gray-800 " +
			"placeholder:text-gray-400 focus:outline-none focus:ring-0 dark:text-white/90 dark:placeholder:text-white/30";

		const help = document.createElement("p");
		help.id = "chipHelp";

		source.type = "hidden";
		source.removeAttribute("class");
		source.parentNode?.insertBefore(box, source.nextSibling);
		box.parentNode?.insertBefore(help, box.nextSibling);
		hint?.remove();

		const sync = () => {
			source.value = items.join(", ");
			const bad = items.filter((a) => !EMAIL_RE.test(a)).length;
			entry.placeholder = items.length ? "Add another…" : "you@example.com";
			help.textContent =
				(items.length === 0
					? "No recipients — alerts are OFF. "
					: `${items.length} recipient${items.length === 1 ? "" : "s"}. `) +
				(bad ? `${bad} ${bad === 1 ? "address is" : "addresses are"} not valid. ` : "") +
				"Press Enter or comma to add." +
				(source.dataset.verifyHint ?? "");
			help.className = `mt-2 text-xs ${
				bad ? "text-error-600 dark:text-error-400" : "text-gray-400 dark:text-gray-500"
			}`;
		};

		const render = () => {
			for (const n of Array.from(box.querySelectorAll("[data-chip]"))) n.remove();
			items.forEach((addr, i) => {
				const ok = EMAIL_RE.test(addr);
				const chip = document.createElement("span");
				chip.setAttribute("data-chip", "");
				chip.className =
					"inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-xs font-medium " +
					(ok
						? "bg-gray-100 text-gray-700 dark:bg-white/[0.06] dark:text-gray-300"
						: "bg-error-50 text-error-700 ring-1 ring-error-200 dark:bg-error-500/10 dark:text-error-400 dark:ring-error-500/30");

				const label = document.createElement("span");
				label.textContent = addr;
				if (!ok) label.title = "This is not a valid email address";
				chip.appendChild(label);

				const x = document.createElement("button");
				x.type = "button";
				x.textContent = "×";
				x.setAttribute("aria-label", `Remove ${addr}`);
				x.className =
					"-mr-0.5 grid h-4 w-4 place-items-center rounded text-sm leading-none opacity-60 " +
					"hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-brand-500/40";
				x.addEventListener("click", () => {
					items.splice(i, 1);
					render();
					entry.focus();
				});
				chip.appendChild(x);
				box.insertBefore(chip, entry);
			});
			sync();
		};

		const add = (raw: string): void => {
			for (const a of split(raw)) {
				if (!items.some((x) => x.toLowerCase() === a.toLowerCase())) items.push(a);
			}
		};

		const commit = (): void => {
			if (!entry.value.trim()) return;
			add(entry.value);
			entry.value = "";
			render();
		};

		entry.addEventListener("keydown", (e: KeyboardEvent) => {
			if (e.key === "Enter" || e.key === "," || e.key === ";") {
				// Enter must not submit the form while the visitor is mid-address.
				e.preventDefault();
				commit();
				return;
			}
			// Backspace on an empty field takes the last chip back for editing —
			// what every other chip field does, and the fastest way to fix a typo.
			if (e.key === "Backspace" && !entry.value && items.length) {
				const last = items.pop() as string;
				render();
				entry.value = last;
				entry.setSelectionRange(last.length, last.length);
			}
		});

		// A pasted list arrives as one lump; split it into chips immediately.
		entry.addEventListener("paste", (e: ClipboardEvent) => {
			const text = e.clipboardData?.getData("text") ?? "";
			if (!text || !/[,;\s]/.test(text)) return;
			e.preventDefault();
			add(`${entry.value} ${text}`);
			entry.value = "";
			render();
		});

		// Leaving the field commits what is typed — nobody expects a finished
		// address to vanish because they reached for Save instead of Enter.
		entry.addEventListener("blur", commit);
		source.form?.addEventListener("submit", commit);

		box.addEventListener("click", (e: MouseEvent) => {
			if (e.target === box) entry.focus();
		});

		box.appendChild(entry);
		render();
	}
</script>
