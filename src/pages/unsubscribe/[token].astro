---
import { env } from "cloudflare:workers";
import { ensureEmailSchema } from "../../utils/email-db";
import { addSuppression } from "../../utils/email/suppression";
import "../../styles/version-h.css";

// Public, token-gated, no auth. Server-rendered.
export const prerender = false;

const db = env.DB as D1Database;
const token = Astro.params.token ?? "";

await ensureEmailSchema(db);

const subscriber = await db
	.prepare("SELECT id, email, email_status FROM waitlist WHERE unsubscribe_token = ?")
	.bind(token)
	.first<{ id: string; email: string; email_status: string }>();

let state: "invalid" | "confirm" | "done" | "already" = subscriber
	? subscriber.email_status === "unsubscribed"
		? "already"
		: "confirm"
	: "invalid";

// POST confirms the opt-out.
if (Astro.request.method === "POST" && subscriber && state === "confirm") {
	await db
		.prepare("UPDATE waitlist SET email_status = 'unsubscribed' WHERE id = ?")
		.bind(subscriber.id)
		.run();
	await addSuppression(db, subscriber.email, "unsubscribe");
	state = "done";
}

const maskedEmail = subscriber?.email ?? "";
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta content="width=device-width, initial-scale=1, viewport-fit=cover" name="viewport" />
		<meta name="theme-color" content="#0B1410" />
		<meta name="color-scheme" content="dark" />
		<meta name="robots" content="noindex, nofollow" />
		<!-- The URL contains the secret unsubscribe token; never leak it in the
		     Referer header of the Google Fonts (or any) sub-request. -->
		<meta name="referrer" content="no-referrer" />
		<title>Unsubscribe · Cure Và</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..700,0..100,0..1;1,9..144,300..700,0..100,0..1&family=Manrope:wght@300..800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="us-body">
		<main class="card us-card">
			{state === "invalid" && (
				<>
					<div class="icon">🔗</div>
					<h1>Link not recognized</h1>
					<p>This unsubscribe link is invalid or has expired. If you keep receiving emails, reply to one and we'll remove you.</p>
				</>
			)}

			{state === "already" && (
				<>
					<div class="icon">✓</div>
					<h1>You're unsubscribed</h1>
					<p><span class="email">{maskedEmail}</span> is already off the CureVà list. No further emails will be sent.</p>
				</>
			)}

			{state === "confirm" && (
				<>
					<div class="icon">✉️</div>
					<h1>Unsubscribe?</h1>
					<p>Stop receiving CureVà waitlist emails at <span class="email">{maskedEmail}</span>?</p>
					<div class="us-actions">
						<form method="POST">
							<button class="btn" type="submit">Yes, unsubscribe me</button>
						</form>
						<form method="GET" action="/">
							<button class="btn btn--outline" type="submit">Keep me subscribed</button>
						</form>
					</div>
				</>
			)}

			{state === "done" && (
				<>
					<div class="icon">👋</div>
					<h1>You're unsubscribed</h1>
					<p><span class="email">{maskedEmail}</span> has been removed from the CureVà list. We're sorry to see you go.</p>
				</>
			)}
		</main>
	</body>
</html>

<style is:global>
/* ═══ unsubscribe ═══════════════════════════════════════════════════════
   One card on the night ground. Composed from tokens; names no colour.

   NOTE: this page's <style> used to carry bare `:root` and `body` rules on
   the old teal palette. Astro does not scope those two selectors, and in
   DEV Vite serves every page's styles on every page — so this one file was
   repainting the whole site's background pale blue at localhost:4321 while
   production was fine. Keep `body` rules on a class, as below.
   ═══════════════════════════════════════════════════════════════════════ */
.us-body{min-height:100svh;display:grid;place-items:center;padding:1.5rem}
.us-card{width:100%;max-width:30rem;text-align:center;
  padding:clamp(2rem,5vw,3rem);border-radius:var(--radius-lg);
  background:hsl(var(--card));color:hsl(var(--card-foreground));
  box-shadow:inset 0 0 0 1px var(--border-hairline-2),var(--sh-d)}
.us-card .icon{font-size:2rem;line-height:1;margin-bottom:1.2rem}
.us-card h1{font-size:clamp(1.6rem,4vw,2.2rem);margin-bottom:.9rem}
.us-card p{font-size:.98rem;line-height:1.65;color:hsl(var(--muted-foreground))}
.us-card .email{font-weight:700;color:hsl(var(--foreground));
  font-variant-numeric:tabular-nums}
.us-actions{display:flex;flex-wrap:wrap;gap:.7rem;justify-content:center;
  margin-top:1.8rem}
</style>
